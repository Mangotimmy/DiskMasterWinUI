<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DiskMasterShellHost — deliberately a plain console app:
      * no XAML, no WinUI, no NuGet PackageReference (fully offline build)
      * self-contained-free: runs on any machine with the .NET 9 desktop runtime,
        which the DiskMaster installer already requires.
    It only forwards a clicked Explorer path to DiskMasterWinUI.exe on the Recovery tab.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>DiskMasterShellHost</RootNamespace>
    <AssemblyName>DiskMasterShellHost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon Condition="Exists('..\..\Assets\AppIcon.ico')">..\..\Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>DiskMaster Pro Shell Launcher</AssemblyTitle>
    <Product>DiskMaster Pro</Product>
    <Company>DiskMaster</Company>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en-US;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    verify/ is a separate project (verify\ShellVerify.csproj). Its Program.cs compiles the
    shipped Services/ShellIntegrationService.cs and therefore references DiskMasterWinUI types,
    which this launcher does not reference. The default compile glob would still pick it up as
    extra source, so exclude it explicitly.
  -->
  <ItemGroup>
    <Compile Remove="verify\**" />
    <None Remove="verify\**" />
  </ItemGroup>

</Project>
