<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone verification harness for the real HKCU shell-integration round trip.
    It compiles the SHIPPED Services/ShellIntegrationService.cs (not a copy) and then:
        snapshot HKCU, Install(), verify the values, Uninstall(), verify HKCU is unchanged.

    Run it OUTSIDE the DSH agent sandbox (that sandbox denies every HKCU write).
    The exact command line is documented in tools/DiskMasterShellHost/README.md.

    Nothing is left installed: the harness always uninstalls and reports the before/after comparison.
    No PackageReference, so it builds and runs fully offline.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>DiskMasterShellHost.Verify</RootNamespace>
    <AssemblyName>ShellVerify</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\Services\ShellIntegrationService.cs" />
  </ItemGroup>

</Project>
