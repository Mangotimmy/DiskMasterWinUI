<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Assets\AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <Version>1.4.2</Version>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <FileVersion>1.4.2.0</FileVersion>
    <Company>DiskMaster Team</Company>
    <Product>DiskMaster Pro Uninstaller</Product>
    <Authors>DiskMaster Team</Authors>
    <Description>DiskMaster Pro Native Windows Uninstaller</Description>
    <Copyright>Copyright (C) 2026 DiskMaster Team. All rights reserved.</Copyright>
  </PropertyGroup>

</Project>
