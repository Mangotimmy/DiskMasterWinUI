<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DiskMasterWinUI.Controls.FloatingHudControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.5"
            CornerRadius="12" Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Title and Restore button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE90F;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="DiskMaster Floating HUD" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>

                <Button Grid.Column="1" Click="RestoreButton_Click" Padding="6,4" ToolTipService.ToolTip="Restore Full Window">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE740;" FontSize="12" />
                        <TextBlock Text="Restore" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Body: Progress Ring + Task Info -->
            <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Circular Progress Ring with % in center -->
                <Grid Grid.Column="0" Width="52" Height="52">
                    <ProgressRing IsActive="True" IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                  Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                  Width="52" Height="52" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Operation Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.OperationTitle, Mode=OneWay}"
                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer: Progress Bar and Stop -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" VerticalAlignment="Center"
                             IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Height="6" CornerRadius="3" />

                <Button Grid.Column="1" Content="⏹️ Stop" Command="{x:Bind ViewModel.CancelCommand}"
                        Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="11" Padding="8,3" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
