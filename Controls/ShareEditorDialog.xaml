<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="DiskMasterWinUI.Controls.ShareEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DiskMasterWinUI.Controls"
    xmlns:models="using:DiskMasterWinUI.Models"
    mc:Ignorable="d"
    PrimaryButtonText="Create share"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_Click"
    Loaded="Dialog_Loaded">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="640">
            <TextBlock x:Name="DialogIntro" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

            <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" />
            <TextBox x:Name="ShareNameBox" Header="Share name"
                     Text="{x:Bind ViewModel.ShareName, Mode=TwoWay}"
                     IsReadOnly="{x:Bind ViewModel.IsEdit, Mode=OneWay}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathBox" Grid.Column="0" Header="Folder"
                         Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay}"
                         IsReadOnly="{x:Bind ViewModel.IsEdit, Mode=OneWay}" />
                <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="Browse"
                        Click="BrowseFolder_Click" VerticalAlignment="Bottom"
                        Visibility="{x:Bind ViewModel.IsCreate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <TextBox Header="Description" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" />

            <TextBlock Text="People with access" FontWeight="SemiBold" FontSize="13" />
            <Expander Header="Add person" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                <StackPanel Spacing="8">
                    <controls:AccountPickerPanel x:Name="EditorAccountPicker" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AccessLevelCombo" Grid.Column="0" Header="Permission level"
                                  ItemsSource="{x:Bind ViewModel.AccessRights}"
                                  SelectedIndex="0" />
                        <Button x:Name="AddPersonButton" Grid.Column="1" Content="Add person"
                                Click="AddPerson_Click" VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <ListView x:Name="GrantsList" ItemsSource="{x:Bind ViewModel.Grants}" SelectionMode="None" MaxHeight="180">
                <ListView.Header>
                    <Grid Padding="8,4" ColumnSpacing="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Account" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Access" FontWeight="SemiBold" FontSize="11" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ShareAclGrantItem">
                        <Grid Padding="8,4" ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind AccountName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind AccessRight}" FontSize="12" />
                            <Button Grid.Column="2" Content="Remove" Click="RemoveGrant_Click" FontSize="11" Padding="6,2" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Expander Header="Advanced options" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <NumberBox Grid.Row="0" Grid.Column="0" Header="Simultaneous users (0 = unlimited)"
                               Minimum="0" Maximum="999999" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind ViewModel.ConcurrentUserLimit, Mode=TwoWay}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Header="Offline availability"
                              ItemsSource="{x:Bind ViewModel.CachingModes}"
                              SelectedItem="{x:Bind ViewModel.CachingMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Grid.Row="0" Grid.Column="2" Header="Folder enumeration"
                              ItemsSource="{x:Bind ViewModel.EnumerationModes}"
                              SelectedItem="{x:Bind ViewModel.FolderEnumerationMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="Encrypt data"
                                  IsOn="{x:Bind ViewModel.EncryptData, Mode=TwoWay}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Apply NTFS permissions"
                              IsChecked="{x:Bind ViewModel.ApplyNtfs, Mode=TwoWay}" VerticalAlignment="Bottom" />
                </Grid>
            </Expander>

            <TextBlock x:Name="ValidationText" Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" />
            <ProgressRing x:Name="SavingRing" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
