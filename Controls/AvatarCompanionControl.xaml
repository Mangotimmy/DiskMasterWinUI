<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DiskMasterWinUI.Controls.AvatarCompanionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="280" Height="380"
    Background="Transparent"
    Loaded="UserControl_Loaded"
    PointerMoved="UserControl_PointerMoved"
    PointerPressed="UserControl_PointerPressed"
    PointerReleased="UserControl_PointerReleased"
    PointerCanceled="UserControl_PointerCanceled"
    PointerCaptureLost="UserControl_PointerCaptureLost">

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="AvatarScaleTransform" ScaleX="1.0" ScaleY="1.0" CenterX="140" CenterY="380" />
            <TranslateTransform x:Name="AvatarPositionTransform" X="0" Y="0" />
        </TransformGroup>
    </UserControl.RenderTransform>

    <UserControl.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutSubItem Text="📌 停靠位置 (Dock Position)">
                <MenuFlyoutItem Text="↘️ 右下角 (Bottom-Right)" Click="Dock_BottomRight_Click" />
                <MenuFlyoutItem Text="↙️ 左下角 (Bottom-Left)" Click="Dock_BottomLeft_Click" />
                <MenuFlyoutItem Text="↗️ 右上角 (Top-Right)" Click="Dock_TopRight_Click" />
                <MenuFlyoutItem Text="↖️ 左上角 (Top-Left)" Click="Dock_TopLeft_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="🔄 重設至預設位置" Click="ResetPosition_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="🔍 助手尺寸 (Size)">
                <MenuFlyoutItem Text="迷你 (70%)" Click="Size_Mini_Click" />
                <MenuFlyoutItem Text="標準 (100%)" Click="Size_Normal_Click" />
                <MenuFlyoutItem Text="大型 (125%)" Click="Size_Large_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="🎭 表情模式 (Emotion)">
                <MenuFlyoutItem Text="⚡ 自動感應磁碟健康 (Auto)" Click="Emotion_Auto_Click" />
                <MenuFlyoutItem Text="😊 良好 (Healthy 100%)" Click="Emotion_Happy_Click" />
                <MenuFlyoutItem Text="😰 注意 (Caution 擔憂)" Click="Emotion_Caution_Click" />
                <MenuFlyoutItem Text="🚨 異常 (Alert 警示)" Click="Emotion_Alert_Click" />
                <MenuFlyoutItem Text="🛠️ 工作中 (Working 專注)" Click="Emotion_Working_Click" />
            </MenuFlyoutSubItem>
            <ToggleMenuFlyoutItem x:Name="MenuToggleBadge" Text="🏷️ 顯示 CrystalDiskInfo 健康徽章" Click="ToggleBadge_Click" IsChecked="True" />
            <ToggleMenuFlyoutItem x:Name="MenuToggleBubble" Text="💬 顯示對話氣泡" Click="ToggleBubble_Click" IsChecked="True" />
            <ToggleMenuFlyoutItem x:Name="MenuToggleGaze" Text="👁️ 視線追蹤滑鼠" Click="ToggleGaze_Click" IsChecked="True" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="❌ 隱藏小助手 (可在頂部重新開啟)" Click="HideCompanion_Click" />
        </MenuFlyout>
    </UserControl.ContextFlyout>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Speech Bubble (Float on top of head) ═══ -->
        <Border x:Name="SpeechBubble" Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,0,0,4"
                Padding="12,6"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1.5"
                MaxWidth="260"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="2">
                <TextBlock x:Name="SpeechText"
                           Text="歡迎使用 DiskMaster Pro！"
                           TextWrapping="Wrap"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══ CrystalDiskInfo-Style Health & Temp Badge ═══ -->
        <Border x:Name="HealthBadgeBorder" Grid.Row="1"
                Background="#107C41"
                CornerRadius="12"
                Padding="10,4"
                HorizontalAlignment="Center"
                Margin="0,0,0,4"
                PointerPressed="HealthBadge_PointerPressed"
                ToolTipService.ToolTip="S.M.A.R.T. 磁碟健康與溫度狀態 (點擊觸發健康語音)">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="HealthBadgeIcon" Text="🟢" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="HealthBadgeText" Text="良好 100%" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="10" Fill="#80FFFFFF" Margin="2,0" />
                <TextBlock x:Name="HealthBadgeTemp" Text="32°C" FontWeight="SemiBold" FontSize="11" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══ Character Avatar Stage (100% True Alpha DirectX) ═══ -->
        <Grid x:Name="AvatarStage" Grid.Row="2"
              Width="240" Height="285"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="Transparent">

            <!-- Breathing Translate Transform -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BreathTransform" Y="0" />
            </Grid.RenderTransform>

            <!-- Custom Model / Image Layer (Supports transparent PNG/WEBP) -->
            <Image x:Name="CustomAvatarImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Visibility="Collapsed" />

            <!-- Built-in Procedural Anime Avatar (Native Vector XAML) -->
            <Canvas x:Name="VectorAvatarCanvas" Width="240" Height="285" Background="Transparent">
                
                <!-- 1. Ambient Shadow on ground -->
                <Ellipse Canvas.Left="45" Canvas.Top="264" Width="150" Height="16" Fill="#25000000" />

                <!-- 2. Body & Tech Uniform / Jacket -->
                <Path Canvas.Left="20" Canvas.Top="165" Data="M 30,120 C 45,60 70,40 100,40 C 130,40 155,60 170,120 L 190,120 L 10,120 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0078D4" Offset="0" />
                            <GradientStop Color="#004578" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- White Collar -->
                <Polygon Canvas.Left="20" Canvas.Top="165" Points="80,40 100,75 120,40" Fill="#FFFFFF" />

                <!-- Tech Tie (Teal) -->
                <Polygon Canvas.Left="20" Canvas.Top="165" Points="96,70 104,70 102,110 98,110" Fill="#00B7C3" />

                <!-- 3. Neck -->
                <Rectangle Canvas.Left="106" Canvas.Top="146" Width="28" Height="28" RadiusX="4" RadiusY="4" Fill="#FFE5D9" />

                <!-- 4. Hair Back -->
                <Ellipse Canvas.Left="35" Canvas.Top="46" Width="170" Height="130" Fill="#3A405A" />

                <!-- 5. Head / Face Contour -->
                <Path Canvas.Left="20" Canvas.Top="18" Data="M 55,100 C 55,160 80,185 100,185 C 120,185 145,160 145,100 C 145,55 55,55 55,100 Z" Fill="#FFF0EB" />

                <!-- 6. Cheeks Blush -->
                <Ellipse x:Name="LeftBlush" Canvas.Left="64" Canvas.Top="118" Width="18" Height="10" Fill="#40FF8A9B" />
                <Ellipse x:Name="RightBlush" Canvas.Left="138" Canvas.Top="118" Width="18" Height="10" Fill="#40FF8A9B" />

                <!-- 7. Left Eye Container -->
                <Canvas Canvas.Left="66" Canvas.Top="92" Width="30" Height="32" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="LeftEyeBlinkTransform" ScaleY="1.0" />
                    </Canvas.RenderTransform>
                    <!-- Eye White -->
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="26" Height="28" Fill="#FFFFFF" Stroke="#2A2E45" StrokeThickness="2" />
                    <!-- Iris -->
                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="20" Height="22">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#004578" Offset="0" />
                                <GradientStop Color="#0078D4" Offset="0.5" />
                                <GradientStop Color="#00B7C3" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Left Pupil with Gaze Tracking -->
                    <Canvas Canvas.Left="5" Canvas.Top="5" Width="20" Height="22">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="LeftPupilTransform" X="0" Y="0" />
                        </Canvas.RenderTransform>
                        <Ellipse x:Name="LeftPupil" Canvas.Left="5" Canvas.Top="5" Width="10" Height="12" Fill="#0F1A2A" />
                        <!-- Specular Highlights -->
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="4" Height="4" Fill="#FFFFFF" />
                        <Ellipse Canvas.Left="11" Canvas.Top="11" Width="2.5" Height="2.5" Fill="#FFFFFF" />
                    </Canvas>
                    <!-- Top Eyelash -->
                    <Path Data="M 1,10 Q 15,2 29,10" Stroke="#2A2E45" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>

                <!-- 8. Right Eye Container -->
                <Canvas Canvas.Left="124" Canvas.Top="92" Width="30" Height="32" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="RightEyeBlinkTransform" ScaleY="1.0" />
                    </Canvas.RenderTransform>
                    <!-- Eye White -->
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="26" Height="28" Fill="#FFFFFF" Stroke="#2A2E45" StrokeThickness="2" />
                    <!-- Iris -->
                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="20" Height="22">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#004578" Offset="0" />
                                <GradientStop Color="#0078D4" Offset="0.5" />
                                <GradientStop Color="#00B7C3" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Right Pupil with Gaze Tracking -->
                    <Canvas Canvas.Left="5" Canvas.Top="5" Width="20" Height="22">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="RightPupilTransform" X="0" Y="0" />
                        </Canvas.RenderTransform>
                        <Ellipse x:Name="RightPupil" Canvas.Left="5" Canvas.Top="5" Width="10" Height="12" Fill="#0F1A2A" />
                        <!-- Specular Highlights -->
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="4" Height="4" Fill="#FFFFFF" />
                        <Ellipse Canvas.Left="11" Canvas.Top="11" Width="2.5" Height="2.5" Fill="#FFFFFF" />
                    </Canvas>
                    <!-- Top Eyelash -->
                    <Path Data="M 1,10 Q 15,2 29,10" Stroke="#2A2E45" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>

                <!-- 9. Tiny Nose Dot -->
                <Ellipse Canvas.Left="119" Canvas.Top="124" Width="3" Height="3" Fill="#60C88278" />

                <!-- 10. Normal Smiling Mouth -->
                <Path x:Name="NormalMouth" Canvas.Left="20" Canvas.Top="18" Data="M 92,126 Q 100,136 108,126" Stroke="#D96570" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- 10b. Worried Wavy Mouth (Caution / Warning) -->
                <Path x:Name="WorriedMouth" Canvas.Left="20" Canvas.Top="18" Data="M 92,132 Q 96,128 100,131 Q 104,134 108,130" Stroke="#D96570" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />

                <!-- 10c. Alert Open Mouth (Bad / Danger) -->
                <Ellipse x:Name="AlertMouth" Canvas.Left="116" Canvas.Top="146" Width="8" Height="11" Fill="#C0392B" Stroke="#D96570" StrokeThickness="1.5" Visibility="Collapsed" />

                <!-- 11. Stylish Hair Front / Bangs -->
                <Path Canvas.Left="20" Canvas.Top="18" Data="M 45,85 C 65,115 85,120 100,95 C 115,120 135,115 155,85 C 150,30 50,30 45,85 Z" Fill="#4E598C" />

                <!-- 12. Headset Antennas (Glowing Cyan) -->
                <Ellipse Canvas.Left="50" Canvas.Top="91" Width="18" Height="24" Fill="#00B7C3" />
                <Ellipse Canvas.Left="54" Canvas.Top="97" Width="10" Height="12" Fill="#FFFFFF" />
                <Ellipse Canvas.Left="152" Canvas.Top="91" Width="18" Height="24" Fill="#00B7C3" />
                <Ellipse Canvas.Left="156" Canvas.Top="97" Width="10" Height="12" Fill="#FFFFFF" />
                <Path Canvas.Left="20" Canvas.Top="18" Data="M 46,90 C 50,35 150,35 154,90" Stroke="#00B7C3" StrokeThickness="3" />

                <!-- 13. Dynamic Emotion Elements -->
                <!-- Cold Sweat Drop (Caution / Warning) -->
                <Canvas x:Name="SweatDropCanvas" Canvas.Left="158" Canvas.Top="75" Visibility="Collapsed">
                    <Path Data="M 8,0 C 8,0 0,10 0,14 C 0,18 4,22 8,22 C 12,22 16,18 16,14 C 16,10 8,0 8,0 Z" Fill="#6042A5F5" Stroke="#1E88E5" StrokeThickness="1" />
                </Canvas>

                <!-- Alarm Exclamation Sign (Bad / Alert) -->
                <Border x:Name="AlarmSignBadge" Canvas.Left="158" Canvas.Top="60" Background="#E81123" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                    <TextBlock Text="⚠️ 危險" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>

                <!-- Working Goggles / Mini Gear (Working Mode) -->
                <Border x:Name="WorkingSignBadge" Canvas.Left="150" Canvas.Top="60" Background="#0078D4" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="⚙️" FontSize="10" />
                        <TextBlock Text="工作中" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
