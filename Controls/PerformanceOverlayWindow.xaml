<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DiskMasterWinUI.Controls.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DiskMaster Performance HUD"
    mc:Ignorable="d">

    <Grid x:Name="OverlayRoot" Background="Transparent">
        <!-- Outer Glowing Container -->
        <Border x:Name="HudContainer" Margin="4"
                Background="#EE0B0F19"
                BorderBrush="#5538BDF8"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="12,10">

            <StackPanel Spacing="8">
                <!-- ═══ Drag Handle & Header Bar ═══ -->
                <Grid x:Name="HeaderBar" PointerPressed="DragRegion_PointerPressed" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- FPS Badge (Gaming Counter) -->
                        <Border Background="#2510B981" BorderBrush="#8010B981" BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🎮" FontSize="11" />
                                <TextBlock x:Name="FpsCounterText" Text="60 FPS" FontWeight="Bold" FontSize="12" Foreground="#34D399" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PERF HUD" FontWeight="Black" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" CharacterSpacing="50" />
                        <TextBlock Text="📌" FontSize="10" ToolTipService.ToolTip="最上層置頂中" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Control Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="CompactToggleBtn" Click="CompactToggle_Click"
                                Padding="5,2" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="切換簡潔條狀 / 完整卡片模式">
                            <TextBlock x:Name="CompactToggleIcon" Text="⊟" FontSize="12" Foreground="#94A3B8" />
                        </Button>
                        <Button Click="CloseBtn_Click"
                                Padding="5,2" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="關閉置頂懸浮窗">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══ Expanded Mode: Full Resource Metrics ═══ -->
                <StackPanel x:Name="ExpandedViewPanel" Spacing="6">
                    <!-- CPU Metric Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Width="60">
                            <TextBlock Text="⚡" FontSize="11" />
                            <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" x:Name="CpuProgress" Maximum="100" Value="0" Height="5" Margin="8,0"
                                     Foreground="#38BDF8" Background="#2038BDF8" CornerRadius="3" />
                        <TextBlock Grid.Column="2" x:Name="CpuText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Width="45" TextAlignment="Right" />
                    </Grid>

                    <!-- GPU Metric Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Width="60">
                            <TextBlock Text="🎮" FontSize="11" />
                            <TextBlock Text="GPU" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" x:Name="GpuProgress" Maximum="100" Value="0" Height="5" Margin="8,0"
                                     Foreground="#C084FC" Background="#20C084FC" CornerRadius="3" />
                        <TextBlock Grid.Column="2" x:Name="GpuText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Width="45" TextAlignment="Right" />
                    </Grid>

                    <!-- RAM Metric Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Width="60">
                            <TextBlock Text="💾" FontSize="11" />
                            <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" x:Name="RamProgress" Maximum="100" Value="0" Height="5" Margin="8,0"
                                     Foreground="#FBBF24" Background="#20FBBF24" CornerRadius="3" />
                        <TextBlock Grid.Column="2" x:Name="RamText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Width="45" TextAlignment="Right" />
                    </Grid>

                    <!-- NET / LAN Metric Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Width="60">
                            <TextBlock Text="🌐" FontSize="11" />
                            <TextBlock Text="LAN" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NetDownText" Text="⬇ 0 KB/s" FontSize="10" Foreground="#34D399" FontWeight="SemiBold" />
                            <TextBlock x:Name="NetUpText" Text="⬆ 0 KB/s" FontSize="10" Foreground="#94A3B8" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="NetTotalText" Text="連線中" FontSize="10" Foreground="#64748B" Width="45" TextAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- ═══ Compact Mode: Single Horizontal Strip ═══ -->
                <StackPanel x:Name="CompactViewPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="⚡" FontSize="10" />
                        <TextBlock x:Name="CompactCpuText" Text="25%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="#334155" FontSize="10" />
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="🎮" FontSize="10" />
                        <TextBlock x:Name="CompactGpuText" Text="38%" FontSize="11" FontWeight="Bold" Foreground="#C084FC" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="#334155" FontSize="10" />
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="💾" FontSize="10" />
                        <TextBlock x:Name="CompactRamText" Text="52%" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="#334155" FontSize="10" />
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="⬇" FontSize="10" Foreground="#34D399" />
                        <TextBlock x:Name="CompactNetText" Text="0 KB/s" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
