<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DiskMasterWinUI.Controls.FloatingTabWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DiskMaster Pro — 獨立分頁視窗"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean TitleBar -->
        <TitleBar x:Name="FloatingTitleBar" Grid.Row="0" Title="DiskMaster Pro">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Top ToolBar with Dock Back Action -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="WindowNoticeText" Text="獨立分頁視窗" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DockRightButton" Click="DockRight_Click" Padding="10,5" FontSize="12" ToolTipService.ToolTip="停靠至主視窗右側雙欄分屏">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE765;" FontSize="12" />
                            <TextBlock x:Name="DockRightText" Text="◨ 停靠至右側" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DockBottomButton" Click="DockBottom_Click" Padding="10,5" FontSize="12" ToolTipService.ToolTip="停靠至主視窗底部水平分屏">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE765;" FontSize="12" />
                            <TextBlock x:Name="DockBottomText" Text="⬓ 停靠至底部" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DockBackButton" Click="DockBack_Click" Style="{StaticResource AccentButtonStyle}" Padding="12,5" FontSize="12" ToolTipService.ToolTip="嵌回主視窗頂部分頁列">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B0;" FontSize="13" />
                            <TextBlock x:Name="DockBackText" Text="嵌回主視窗" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page Content Frame -->
        <ScrollViewer x:Name="FloatingScrollViewer" Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top"
                      SizeChanged="FloatingScrollViewer_SizeChanged">
            <Grid x:Name="FloatingContentRoot" RenderTransformOrigin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                  BringIntoViewRequested="FloatingContentRoot_BringIntoViewRequested">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="FloatingScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <Frame x:Name="FloatingContentFrame" SizeChanged="FloatingContentFrame_SizeChanged" HorizontalAlignment="Stretch" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
