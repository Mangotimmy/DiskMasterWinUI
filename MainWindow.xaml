                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>

                        <TabViewItem x:Name="TabSystemPerformance" Header="效能分析" Tag="SystemPerformance" IsClosable="False"
                                      ToolTipService.ToolTip="系統即時效能監控、進程獵殺與硬體報告 — 右鍵浮動視窗">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE9D9;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="🪟 獨立浮動視窗 [Ctrl+Shift+F]" Click="TabContext_Float_Click" />
                                    <MenuFlyoutItem Text="◨ 停靠至視窗右側" Click="TabContext_DockRight_Click" />
                                    <MenuFlyoutItem Text="⬓ 停靠至視窗底部" Click="TabContext_DockBottom_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="⬅️ 向左移動 [Alt+Left]" Click="TabContext_MoveLeft_Click" />
                                    <MenuFlyoutItem Text="➡️ 向右移動 [Alt+Right]" Click="TabContext_MoveRight_Click" />
                                    <MenuFlyoutItem Text="⏫ 移至最左側 [Alt+Home]" Click="TabContext_MoveFirst_Click" />
                                    <MenuFlyoutItem Text="⏬ 移至最右側 [Alt+End]" Click="TabContext_MoveLast_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="🔄 重新整理此分頁 [F5]" Click="TabContext_Refresh_Click" />
                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>

                        <TabViewItem x:Name="TabSettings" Header="設定" Tag="Settings" IsClosable="False"
                                      ToolTipService.ToolTip="偏好設定 — 快捷鍵: Ctrl+, / 右鍵浮動視窗">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="🪟 獨立浮動視窗 [Ctrl+Shift+F]" Click="TabContext_Float_Click" />
                                    <MenuFlyoutItem Text="◨ 停靠至視窗右側" Click="TabContext_DockRight_Click" />
                                    <MenuFlyoutItem Text="⬓ 停靠至視窗底部" Click="TabContext_DockBottom_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="⬅️ 向左移動 [Alt+Left]" Click="TabContext_MoveLeft_Click" />
                                    <MenuFlyoutItem Text="➡️ 向右移動 [Alt+Right]" Click="TabContext_MoveRight_Click" />
                                    <MenuFlyoutItem Text="⏫ 移至最左側 [Alt+Home]" Click="TabContext_MoveFirst_Click" />
                                    <MenuFlyoutItem Text="⏬ 移至最右側 [Alt+End]" Click="TabContext_MoveLast_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="🔄 重新整理此分頁 [F5]" Click="TabContext_Refresh_Click" />
                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>
                    </TabView.TabItems>

                    <TabView.TabStripFooter>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <!-- Admin Status & 1-Click Elevation Button -->
                            <Button x:Name="AdminStatusBtn" Click="AdminStatusBtn_Click"
                                    Padding="8,3" FontSize="11">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock x:Name="AdminStatusIcon" Text="🛡️" FontSize="11" />
                                    <TextBlock x:Name="AdminStatusText" Text="系統管理員模式" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Dual Mode Switcher: Easy vs Advance -->
                            <Button x:Name="ModeSwitcherBtn" Click="ModeSwitcher_Click"
                                    Padding="8,3" FontSize="11" ToolTipService.ToolTip="切換 簡易模式 (Easy) 與 專業進階模式 (Advance)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="ModeSwitcherIcon" Glyph="&#xE790;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="ModeSwitcherText" Text="🟢 簡易模式" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Adobe Workspace Preset Dropdown -->
                            <ComboBox x:Name="WorkspaceCombo" SelectionChanged="WorkspaceCombo_SelectionChanged"
                                      Padding="6,2" FontSize="11" Width="130" ToolTipService.ToolTip="工作區排版預設" />

                            <!-- Float Active Tab Button -->
                            <Button x:Name="FloatTabBtn" Content="🪟 浮動" Click="FloatCurrentTab_Click"
                                    Padding="6,2" FontSize="11" ToolTipService.ToolTip="撕離為獨立視窗 [Ctrl+Shift+F]" />

                            <!-- Floating Windows Manager (Shows count, click to Dock All) -->
                            <Button x:Name="FloatingManagerBtn" Click="DockAll_Click" Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}" Padding="6,2" FontSize="11"
                                    ToolTipService.ToolTip="點擊將所有浮動視窗一鍵嵌回主視窗 [Ctrl+Shift+D]">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B0;" FontSize="11" />
                                    <TextBlock x:Name="FloatingCountText" Text="1 浮動視窗" FontSize="11" />
                                </StackPanel>
                            </Button>


                            <Button x:Name="CompanionToggleBtn" Content="🎭 2D 助手" Click="CompanionToggle_Click"
                                    Padding="6,2" FontSize="11" ToolTipService.ToolTip="顯示 / 隱藏 2D 守護助手" />

                            <Button x:Name="LanguageToggleBtn" Content="🌐 繁體中文" Click="LanguageToggle_Click" Padding="8,4" FontSize="12" />
                        </StackPanel>
                    </TabView.TabStripFooter>
                </TabView>

                <!-- Multi-Directional Docking Container Grid (Main Viewport, Right Dock, Bottom Dock) -->
                <Grid Grid.Row="2" x:Name="DockContainerGrid"
                      AllowDrop="True"
                      DragOver="DockContainerGrid_DragOver"
                      Drop="DockContainerGrid_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="BottomDockRowDef" Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Upper Horizontal Row: Central Viewport + Right Dock -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="RightDockColDef" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Central Main Viewport -->
                        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="ContentScrollViewer_SizeChanged">
                            <Grid x:Name="ContentRoot" RenderTransformOrigin="0,0" HorizontalAlignment="Stretch">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RootScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>
                                <Frame x:Name="ContentFrame" SizeChanged="ContentFrame_SizeChanged" HorizontalAlignment="Stretch" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Vertical Splitter between Central Viewport and Right Dock -->
                        <controls:AdobeSplitter x:Name="RightDockSplitter" Grid.Column="1"
                                                Orientation="Vertical"
                                                ResizeMode="TargetSecond"
                                                TargetColumn="{x:Bind RightDockColDef}"
                                                MinSize="260" MaxSize="900"
                                                Visibility="Collapsed" />

                        <!-- Right Dock Pane (Side-by-side Multi-Tasking) -->
                        <Border x:Name="RightDockPanel" Grid.Column="2" Visibility="Collapsed"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Right Dock Header Bar -->
                                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="12,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE765;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="RightDockTitleText" Text="側邊分屏" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <!-- Move to Bottom Dock -->
                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="RightToBottom_Click" ToolTipService.ToolTip="轉到底部水平分屏">
                                                <FontIcon Glyph="&#xE765;" FontSize="11" />
                                            </Button>
                                            <!-- Move to Floating Window -->
                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="RightToFloat_Click" ToolTipService.ToolTip="獨立浮動視窗 [Ctrl+Shift+F]">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                            </Button>
                                            <!-- Dock back to Tab Strip -->
                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="RightDockClose_Click" ToolTipService.ToolTip="嵌回頂部分頁列">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Right Dock Content Frame -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Frame x:Name="RightDockFrame" HorizontalAlignment="Stretch" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Horizontal Splitter between Upper Viewport and Bottom Dock -->
                    <controls:AdobeSplitter x:Name="BottomDockSplitter" Grid.Row="1"
                                            Orientation="Horizontal"
                                            ResizeMode="TargetSecond"
                                            TargetRow="{x:Bind BottomDockRowDef}"
                                            MinSize="160" MaxSize="700"
                                            Visibility="Collapsed" />

                    <!-- Bottom Dock Pane (Bottom Horizontal Split Screen) -->
                    <Border x:Name="BottomDockPanel" Grid.Row="2" Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Bottom Dock Header Bar -->
                            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Padding="12,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE765;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="BottomDockTitleText" Text="底部水平分屏" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <!-- Move to Right Dock -->
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="BottomToRight_Click" ToolTipService.ToolTip="轉到側邊雙欄分屏">
                                            <FontIcon Glyph="&#xE765;" FontSize="11" />
                                        </Button>
                                        <!-- Move to Floating Window -->
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="BottomToFloat_Click" ToolTipService.ToolTip="獨立浮動視窗 [Ctrl+Shift+F]">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                        </Button>
                                        <!-- Dock back to Tab Strip -->
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,3" Click="BottomDockClose_Click" ToolTipService.ToolTip="嵌回頂部分頁列">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Dock Content Frame -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Frame x:Name="BottomDockFrame" HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Unified Bottom Status Bar with % and ETA -->
                <controls:StatusBarControl Grid.Row="3" />
            </Grid>

            <!-- CrystalDiskInfo-Style Live2D Floating Companion Avatar Overlay -->
            <controls:AvatarCompanionControl x:Name="CompanionControl"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,24,36"
                                             Visibility="Visible" />
        </Grid>
    </Grid>
</Window>
