                                    <MenuFlyoutItem Text="◨ 停靠至視窗右側" Click="TabContext_DockRight_Click" />
                                    <MenuFlyoutItem Text="⬓ 停靠至視窗底部" Click="TabContext_DockBottom_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="⬅️ 向左移動 [Alt+Left]" Click="TabContext_MoveLeft_Click" />
                                    <MenuFlyoutItem Text="➡️ 向右移動 [Alt+Right]" Click="TabContext_MoveRight_Click" />
                                    <MenuFlyoutItem Text="⏫ 移至最左側 [Alt+Home]" Click="TabContext_MoveFirst_Click" />
                                    <MenuFlyoutItem Text="⏬ 移至最右側 [Alt+End]" Click="TabContext_MoveLast_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="🔄 重新整理此分頁 [F5]" Click="TabContext_Refresh_Click" />
                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="👁️ 隱藏此分頁 (於設定可恢復)" Click="TabContext_HideTab_Click" />
                                    <MenuFlyoutItem Text="🔁 重設全部分頁預設排序" Click="TabContext_ResetOrder_Click" />
                                    <MenuFlyoutItem Text="📊 匯出系統診斷報告 [Ctrl+D]" Click="TabContext_ExportDiag_Click" />
                                    <MenuFlyoutItem Text="🛡️ 以管理員身分重新啟動" Click="AdminRestart_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>

                        <TabViewItem x:Name="TabWimDeploy" Header="系統部署" Tag="WimDeploy" IsClosable="False"
                                      ToolTipService.ToolTip="WIM/ESD 映像套用與備份部署 — 快捷鍵: Ctrl+2 / 右鍵浮動視窗">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE896;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="🪟 獨立浮動視窗 [Ctrl+Shift+F]" Click="TabContext_Float_Click" />
                                    <MenuFlyoutItem Text="◨ 停靠至視窗右側" Click="TabContext_DockRight_Click" />
                                    <MenuFlyoutItem Text="⬓ 停靠至視窗底部" Click="TabContext_DockBottom_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="⬅️ 向左移動 [Alt+Left]" Click="TabContext_MoveLeft_Click" />
                                    <MenuFlyoutItem Text="➡️ 向右移動 [Alt+Right]" Click="TabContext_MoveRight_Click" />
                                    <MenuFlyoutItem Text="⏫ 移至最左側 [Alt+Home]" Click="TabContext_MoveFirst_Click" />
                                    <MenuFlyoutItem Text="⏬ 移至最右側 [Alt+End]" Click="TabContext_MoveLast_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="🔄 重新整理此分頁 [F5]" Click="TabContext_Refresh_Click" />
                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="👁️ 隱藏此分頁 (於設定可恢復)" Click="TabContext_HideTab_Click" />
                                    <MenuFlyoutItem Text="🔁 重設全部分頁預設排序" Click="TabContext_ResetOrder_Click" />
                                    <MenuFlyoutItem Text="📊 匯出系統診斷報告 [Ctrl+D]" Click="TabContext_ExportDiag_Click" />
                                    <MenuFlyoutItem Text="🛡️ 以管理員身分重新啟動" Click="AdminRestart_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>

                        <TabViewItem x:Name="TabBootManager" Header="引導管理" Tag="BootManager" IsClosable="False"
                                      ToolTipService.ToolTip="Windows 開機引導管理與修復 — 快捷鍵: Ctrl+3 / 右鍵浮動視窗">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE7C3;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="🪟 獨立浮動視窗 [Ctrl+Shift+F]" Click="TabContext_Float_Click" />
