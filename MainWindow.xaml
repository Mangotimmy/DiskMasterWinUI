<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DiskMasterWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DiskMasterWinUI"
    xmlns:controls="using:DiskMasterWinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DiskMaster Pro 磁碟大師 — 旗艦級 Windows 磁碟維護與引導部署工具箱"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Native TitleBar (Full caption button clearance) -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="DiskMaster Pro 磁碟大師 — 旗艦級 Windows 磁碟維護與引導部署工具箱">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Main Window Container -->
        <Grid Grid.Row="1">
            <!-- Custom Background Image Layer -->
            <Image x:Name="BackgroundCustomImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Opacity="0.25"
                   Visibility="Collapsed" />

            <Grid x:Name="NormalView" PointerMoved="NormalView_PointerMoved" PointerReleased="NormalView_PointerReleased" KeyboardAcceleratorPlacementMode="Hidden">
                <Grid.Resources>
                    <SolidColorBrush x:Name="DynamicCardBrush" x:Key="CardBackgroundFillColorDefaultBrush" Color="#B0202020" />
                    <SolidColorBrush x:Name="DynamicCardSecBrush" x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80282828" />
                    <SolidColorBrush x:Name="DynamicExpanderHeaderBrush" x:Key="ExpanderHeaderBackground" Color="#99242424" />
                    <SolidColorBrush x:Name="DynamicExpanderContentBrush" x:Key="ExpanderContentBackground" Color="#661A1A1A" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 0: notification banners -->
                    <RowDefinition Height="Auto" />   <!-- 1: command toolbar (own row: can never be squeezed by the tab strip) -->
                    <RowDefinition Height="Auto" />   <!-- 2: tab strip -->
                    <RowDefinition Height="*" />      <!-- 3: page viewport + docks -->
                    <RowDefinition Height="Auto" />   <!-- 4: status bar -->
                </Grid.RowDefinitions>

                <!-- Top Notification Banners -->
                <StackPanel Grid.Row="0">
                    <!-- Non-Admin Warning Banner (Auto pops up if not elevated) -->
                    <InfoBar x:Name="AdminWarningBar" Severity="Warning" IsOpen="False" IsClosable="False"
                             Title="未以系統管理員身分執行"
                             Message="DISM 映像修復、SFC 掃描、DiskPart 磁碟分區抹除等底層操作需要系統管理員權限才能執行。">
                        <InfoBar.ActionButton>
                            <Button Content="🚀 立即以管理員身分重啟" Click="AdminRestart_Click" Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Crash-Proof Global Exception Notification Bar -->
                    <InfoBar x:Name="GlobalExceptionBar" Severity="Error" IsOpen="False" IsClosable="True"
                             Title="系統已成功攔截並防止崩潰"
                             Message="">
                        <InfoBar.Content>
                            <HyperlinkButton Content="📝 查看即時操作日誌 (Action Log)" Click="ActionLogBtn_Click" Margin="0,2,0,0" />
                        </InfoBar.Content>
                        <InfoBar.ActionButton>
                            <Button Content="📋 複製錯誤詳情" Click="CopyErrorDetails_Click" Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- ═══ Command toolbar: its own full-width row ═══
                     These actions used to live in TabView.TabStripFooter, which is laid out to the right
                     of the tab strip: with many tabs open the strip consumed all the width and the footer
                     was clipped at the window edge ("框架出界"). A dedicated row can never be squeezed and
                     keeps every action reachable. -->
                <Grid x:Name="CommandToolbar" Grid.Row="1" Padding="4,2,12,2"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="CommandToolbarHint"
                               Text="分頁列可拖曳排序；右鍵分頁可浮動、停靠、隱藏"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="8,0,12,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Admin Status & 1-Click Elevation Button -->
                        <Button x:Name="AdminStatusBtn" Click="AdminStatusBtn_Click"
                                Padding="8,3" FontSize="11">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="AdminStatusIcon" Text="🛡️" FontSize="11" />
                                <TextBlock x:Name="AdminStatusText" Text="系統管理員模式" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Dual Mode Switcher: Easy vs Advance -->
                        <Button x:Name="ModeSwitcherBtn" Click="ModeSwitcher_Click"
                                Padding="8,3" FontSize="11" ToolTipService.ToolTip="切換 簡易模式 (Easy) 與 專業進階模式 (Advance)">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="ModeSwitcherIcon" Glyph="&#xE790;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="ModeSwitcherText" Text="🟢 簡易模式" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Adobe Workspace Preset Dropdown -->
                        <ComboBox x:Name="WorkspaceCombo" SelectionChanged="WorkspaceCombo_SelectionChanged"
                                  Padding="6,2" FontSize="11" Width="112" ToolTipService.ToolTip="工作區排版預設" />

                        <!-- Float Active Tab Button -->
                        <Button x:Name="FloatTabBtn" Content="🪟 浮動" Click="FloatCurrentTab_Click"
                                Padding="6,2" FontSize="11" ToolTipService.ToolTip="撕離為獨立視窗 [Ctrl+Shift+F]" />

                        <!-- Floating Windows Manager (Shows count, click to Dock All) -->
                        <Button x:Name="FloatingManagerBtn" Click="DockAll_Click" Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}" Padding="6,2" FontSize="11"
                                ToolTipService.ToolTip="點擊將所有浮動視窗一鍵嵌回主視窗 [Ctrl+Shift+D]">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8B0;" FontSize="11" />
                                <TextBlock x:Name="FloatingCountText" Text="1 浮動視窗" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <!-- Overflow menu for the secondary actions -->
                        <Button x:Name="MoreActionsBtn" Padding="8,3" FontSize="11"
                                ToolTipService.ToolTip="更多動作：即時日誌、2D 助手、介面語言">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE712;" FontSize="11" />
                                <TextBlock Text="更多" FontSize="11" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="ActionLogBtn" Text="📝 即時日誌  [Ctrl+Shift+L]" Click="ActionLogBtn_Click" />
                                    <MenuFlyoutItem x:Name="CompanionToggleBtn" Text="🎭 顯示 / 隱藏 2D 助手" Click="CompanionToggle_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="LanguageToggleBtn" Text="🌐 繁體中文" Click="LanguageToggle_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══ Movable Top TabView (All tabs can drag & reorder & right-click) ═══ -->
                <TabView x:Name="MainTabs" Grid.Row="2"
                         TabWidthMode="SizeToContent"
                         CanDragTabs="True"
                         CanReorderTabs="True"
                         IsAddTabButtonVisible="False"
                         SelectionChanged="MainTabs_SelectionChanged"
                         TabDragStarting="MainTabs_TabDragStarting"
                         TabDragCompleted="MainTabs_TabDragCompleted"
                         TabDroppedOutside="MainTabs_TabDroppedOutside">
                    <TabView.TabItems>
                        <TabViewItem x:Name="TabStarter" Header="入門精靈" Tag="Starter" IsClosable="False"
                                      ToolTipService.ToolTip="新手入門體檢與一鍵快速維護 — 右鍵浮動視窗">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE735;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="🪟 獨立浮動視窗 [Ctrl+Shift+F]" Click="TabContext_Float_Click" />
                                    <MenuFlyoutItem Text="◨ 停靠至視窗右側" Click="TabContext_DockRight_Click" />
                                    <MenuFlyoutItem Text="⬓ 停靠至視窗底部" Click="TabContext_DockBottom_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="⬅️ 向左移動 [Alt+Left]" Click="TabContext_MoveLeft_Click" />
                                    <MenuFlyoutItem Text="➡️ 向右移動 [Alt+Right]" Click="TabContext_MoveRight_Click" />
                                    <MenuFlyoutItem Text="⏫ 移至最左側 [Alt+Home]" Click="TabContext_MoveFirst_Click" />
                                    <MenuFlyoutItem Text="⏬ 移至最右側 [Alt+End]" Click="TabContext_MoveLast_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="🔄 重新整理此分頁 [F5]" Click="TabContext_Refresh_Click" />
                                    <MenuFlyoutItem Text="📋 複製分頁名稱" Click="TabContext_CopyTitle_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="👁️ 隱藏此分頁 (於設定可恢復)" Click="TabContext_HideTab_Click" />
                                    <MenuFlyoutItem Text="🔁 重設全部分頁預設排序" Click="TabContext_ResetOrder_Click" />
                                    <MenuFlyoutItem Text="📊 匯出系統診斷報告 [Ctrl+D]" Click="TabContext_ExportDiag_Click" />
                                    <MenuFlyoutItem Text="🛡️ 以管理員身分重新啟動" Click="AdminRestart_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>

