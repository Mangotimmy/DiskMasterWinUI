<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.AdvancedModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DiskMasterWinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- Movable Sub TabView -->
        <TabView x:Name="AdvancedTabView" Grid.Row="1"
                 CanReorderTabs="True"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>

                <!-- ════ DiskPart Script Tab ════ -->
                <TabViewItem x:Name="TabDiskPart" Header="DiskPart" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="RowScriptInput" Height="220" MinHeight="100" MaxHeight="600" />
                        <!-- Adobe Horizontal Splitter (Drag ↕) -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="RowScriptOutput" Height="*" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <!-- Script Templates & Quick Actions -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="TemplatesLabel" Text="Templates:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="TplListAllBtn" Content="List All" Click="Template_ListAll" />
                            <Button x:Name="TplCleanGptBtn" Content="Clean + GPT" Click="Template_CleanGPT" />
                            <Button x:Name="TplCleanMbrBtn" Content="Clean + MBR" Click="Template_CleanMBR" />
                            <Button x:Name="TplUsbBootBtn" Content="USB Boot" Click="Template_USB" />
                            <Button x:Name="TplWinInstallBtn" Content="Win Install" Click="Template_WinInstall" />
                            <Button x:Name="TplStandardUefiBtn" Content="UEFI 4分區" Click="Template_StandardUEFI" />
                            <Button x:Name="TplWinReBtn" Content="WinRE 分割區" Click="Template_WinRE" />
                            <Button x:Name="TplFixSigBtn" Content="修復簽章衝突" Click="Template_FixSig" />
                        </StackPanel>

                        <!-- Quick Disk Commands (Zero-Keyboard) -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="QuickActionsLabel" Text="Quick Actions:" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox x:Name="TargetDiskNumberBox" Header="Disk #" Value="{x:Bind ViewModel.TargetDiskNumber, Mode=TwoWay}"
                                       Minimum="0" Maximum="99" SpinButtonPlacementMode="Compact"
                                       Width="90" VerticalAlignment="Center" />
                            <Button x:Name="ClearReadOnlyBtn" Content="🔓 Clear Read-Only" Command="{x:Bind ViewModel.ClearReadOnlyCommand}" />
                            <Button x:Name="SetOnlineBtn" Content="🌐 Online Disk" Command="{x:Bind ViewModel.SetDiskOnlineCommand}" />
                            <Button x:Name="SetOfflineBtn" Content="📴 Offline Disk" Command="{x:Bind ViewModel.SetDiskOfflineCommand}" />
                            <Button x:Name="GetUniqueIdBtn" Content="🆔 Unique ID" Command="{x:Bind ViewModel.GetDiskUniqueIdCommand}" />
                            <Button x:Name="RescanDisksBtn" Content="🔄 Rescan Devices" Command="{x:Bind ViewModel.RescanDisksCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Script Input -->
                    <TextBox x:Name="DiskPartScriptBox" Grid.Row="1" Header="DiskPart Script"
                             Text="{x:Bind ViewModel.DiskPartScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13"
                             PlaceholderText="Enter diskpart commands here..."
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <!-- Adobe Splitter (Drag ↕) -->
                    <controls:AdobeSplitter Grid.Row="2"
                                            Orientation="Horizontal"
                                            TargetRow="{x:Bind RowScriptInput}"
                                            MinSize="100"
                                            MaxSize="600"
                                            Margin="0,4" />

                    <!-- Execute Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.ExecuteDiskPartScriptCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                                <TextBlock x:Name="ExecuteScriptBtnText" Text="Execute Script" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearDiskPartOutputBtn" Content="Clear Output" Command="{x:Bind ViewModel.ClearDiskPartOutputCommand}" />
                    </StackPanel>

                    <!-- Output -->
                    <ScrollViewer Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="8" Padding="12">
                        <TextBlock Text="{x:Bind ViewModel.DiskPartOutput, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <!-- ════ Boot Repair Tab ════ -->
            <TabViewItem x:Name="TabBootRepair" Header="開機修復 (Boot Repair)" IsClosable="False">
                <Grid RowSpacing="12" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- bootrec commands -->
                    <Expander Grid.Row="0" Header="bootrec.exe (WinRE/WinPE only)" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <InfoBar IsOpen="{x:Bind ViewModel.IsBootrecAvailable, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                     Severity="Warning" Title="bootrec.exe not found"
                                     Message="bootrec.exe is only available in Windows Recovery Environment (WinRE/WinPE). These commands will fail on a normal Windows desktop."
                                     IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="/fixmbr" Command="{x:Bind ViewModel.BootrecFixMbrCommand}" />
                                <Button Content="/fixboot" Command="{x:Bind ViewModel.BootrecFixBootCommand}" />
                                <Button Content="/scanos" Command="{x:Bind ViewModel.BootrecScanOsCommand}" />
                                <Button Content="/rebuildbcd" Command="{x:Bind ViewModel.BootrecRebuildBcdCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- bcdboot -->
                    <Expander Grid.Row="1" Header="bcdboot.exe" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Button Content="bcdboot C:\Windows (Default UEFI)"
                                    Command="{x:Bind ViewModel.BcdBootDefaultCommand}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Custom bcdboot arguments"
                                         Text="{x:Bind ViewModel.BcdBootCustomArgs, Mode=TwoWay}"
                                         PlaceholderText="e.g. C:\Windows /s S: /f UEFI" />
                                <Button Grid.Column="1" Content="Run" 
                                        Command="{x:Bind ViewModel.BcdBootCustomCommand}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- bootsect -->
                    <Expander Grid.Row="2" Header="bootsect.exe &amp; mountvol (ESP)" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="bootsect /nt60 S:" Command="{x:Bind ViewModel.BootSectNt60Command}" />
                                <Button Content="bootsect /nt52 S:" Command="{x:Bind ViewModel.BootSectNt52Command}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="ESP 代號" Width="80" Text="{x:Bind ViewModel.EspDriveLetter, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="💿 一鍵掛載 ESP (mountvol /s)" Command="{x:Bind ViewModel.MountEspCommand}"
                                        VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                <Button Grid.Column="2" Content="⏏️ 卸載 ESP (mountvol /d)" Command="{x:Bind ViewModel.UnmountEspCommand}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- reagentc & Clean BCD -->
                    <Expander Grid.Row="3" Header="reagentc.exe (Windows RE) &amp; BCD 備份還原" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="📋 RE 狀態 (/info)" Command="{x:Bind ViewModel.ReagentcInfoCommand}" />
                                <Button Content="✅ 啟用 RE (/enable)" Command="{x:Bind ViewModel.ReagentcEnableCommand}" />
                                <Button Content="❌ 停用 RE (/disable)" Command="{x:Bind ViewModel.ReagentcDisableCommand}" />
                                <Button Content="🔄 下次開機進入 RE (/boottoore)" Command="{x:Bind ViewModel.ReagentcBootToReCommand}" />
                                <Button Content="🧹 清潔 BCD 重建 (/c)" Command="{x:Bind ViewModel.BcdBootCleanCommand}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="BCD 備份檔案路徑" Text="{x:Bind ViewModel.BcdBackupPath, Mode=TwoWay}"
                                         PlaceholderText="D:\bcd_backup" />
                                <Button Grid.Column="1" Content="💾 備份 BCD" Command="{x:Bind ViewModel.BcdExportCommand}"
                                        VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                <Button Grid.Column="2" Content="📥 還原 BCD" Command="{x:Bind ViewModel.BcdImportCommand}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Auto Repair -->
                    <Button Grid.Row="4" Command="{x:Bind ViewModel.AutoRepairBootCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" />
                            <TextBlock x:Name="AutoRepairBootBtnText" Text="全自動引導開機修復" />
                        </StackPanel>
                    </Button>

                    <!-- Boot Output -->
                    <Grid Grid.Row="5" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button Content="Clear" Command="{x:Bind ViewModel.ClearBootOutputCommand}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      CornerRadius="8" Padding="12">
                            <TextBlock Text="{x:Bind ViewModel.BootOutput, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabViewItem>

            <!-- ════ BCDEdit Tab ════ -->
            <TabViewItem x:Name="TabBcdEdit" Header="BCD 項目管理 (BCDEdit)" IsClosable="False">
                <Grid RowSpacing="12" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.RefreshBcdEntriesCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock x:Name="EnumBcdBtnText" Text="列舉 BCD" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SetDefaultBcdBtn" Content="設為預設值" Command="{x:Bind ViewModel.BcdEditSetDefaultCommand}" />
                            <Button x:Name="DeleteBcdBtn" Content="刪除項目" Command="{x:Bind ViewModel.BcdEditDeleteEntryCommand}" />
                        </StackPanel>

                        <!-- BCD Presets (Zero-Keyboard) -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Timeout Presets -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Timeout:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="0s" Command="{x:Bind ViewModel.SetBcdTimeoutPresetCommand}" CommandParameter="0" Padding="6,2" FontSize="11" />
                                <Button Content="3s" Command="{x:Bind ViewModel.SetBcdTimeoutPresetCommand}" CommandParameter="3" Padding="6,2" FontSize="11" />
                                <Button Content="5s" Command="{x:Bind ViewModel.SetBcdTimeoutPresetCommand}" CommandParameter="5" Padding="6,2" FontSize="11" />
                                <Button Content="10s" Command="{x:Bind ViewModel.SetBcdTimeoutPresetCommand}" CommandParameter="10" Padding="6,2" FontSize="11" />
                                <Button Content="30s" Command="{x:Bind ViewModel.SetBcdTimeoutPresetCommand}" CommandParameter="30" Padding="6,2" FontSize="11" />
                            </StackPanel>

                            <!-- SafeMode Presets -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Safe Mode:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Normal" Command="{x:Bind ViewModel.SetBcdSafeModePresetCommand}" CommandParameter="clear" Padding="6,2" FontSize="11" />
                                <Button Content="Minimal" Command="{x:Bind ViewModel.SetBcdSafeModePresetCommand}" CommandParameter="minimal" Padding="6,2" FontSize="11" />
                                <Button Content="Network" Command="{x:Bind ViewModel.SetBcdSafeModePresetCommand}" CommandParameter="network" Padding="6,2" FontSize="11" />
                            </StackPanel>

                            <!-- Hypervisor -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Hypervisor:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Auto" Command="{x:Bind ViewModel.ToggleHypervisorCommand}" CommandParameter="true" Padding="6,2" FontSize="11" />
                                <Button Content="Off" Command="{x:Bind ViewModel.ToggleHypervisorCommand}" CommandParameter="false" Padding="6,2" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.BcdEntries, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedBcdEntry, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RawText}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap" MaxLines="6"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="Custom bcdedit arguments"
                                 Text="{x:Bind ViewModel.BcdEditCustomArgs, Mode=TwoWay}"
                                 PlaceholderText="e.g. /set {default} description 'My OS'" />
                        <Button Grid.Column="1" Content="Run" 
                                Command="{x:Bind ViewModel.BcdEditCustomCommand}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </TabViewItem>

            <!-- ════ Full Log Tab ════ -->
            <TabViewItem x:Name="TabFullLog" Header="完整執行記錄 (Full Log)" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="ClearFullLogBtn" Content="清除記錄" Command="{x:Bind ViewModel.ClearFullLogCommand}" />
                    <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="8" Padding="12">
                        <TextBlock Text="{x:Bind ViewModel.FullLog, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</Grid>
</Page>
