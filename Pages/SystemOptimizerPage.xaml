                                                <Button Content="▶️ Turn On (恢復啟用)" Command="{x:Bind ViewModel.TurnOnDiagTrackCommand}"
                                                        Padding="12,6" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
