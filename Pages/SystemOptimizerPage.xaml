                                            <ComboBoxItem Content="🚀 高速效能工作區 (shell32.dll,316)" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Header="圖示資源路徑 (IconResource - 路徑,索引)"
                                                 Text="{x:Bind ViewModel.TargetCustomIconResource, Mode=TwoWay}"
                                                 PlaceholderText="例如: C:\Windows\System32\shell32.dll,43 或 C:\Icons\my.ico,0" />
                                        <Button Grid.Column="2" Content="🔍 選擇圖示檔 (.ico/.dll/.exe)..." Command="{x:Bind ViewModel.BrowseCustomIconFileCommand}" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Folder Icon vs File Extension Icon Actions -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Folder Icon Box -->
                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Name="FolderIconSectionTitle" Text="📁 資料夾圖示 (Folder icons - 套用至上方選取的目標資料夾)" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="🎨 變更資料夾圖示 (Change Icon)" Command="{x:Bind ViewModel.ApplyFolderCustomIconCommand}"
                                                            Style="{StaticResource AccentButtonStyle}" />
                                                    <Button Content="🔄 還原預設圖示 (Restore Default)" Command="{x:Bind ViewModel.RestoreFolderDefaultIconCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- File Type Icon Box -->
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="FileExtensionBox" Grid.Column="0" Header="檔案副檔名" Text="{x:Bind ViewModel.TargetFileExtension, Mode=TwoWay}" PlaceholderText=".txt" />
                                                <Button Grid.Column="1" Content="📄 套用檔案類型圖示" Command="{x:Bind ViewModel.ApplyFileExtensionIconCommand}"
                                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                                <Button Grid.Column="2" Content="🔄 還原預設" Command="{x:Bind ViewModel.RestoreFileExtensionIconCommand}"
                                                        VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 4: 登錄檔備份與還原 (Backup & Restore) ════ -->
                <TabViewItem x:Name="TabBackup" Header="💾 登錄檔備份 (Backup &amp; Restore)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Backup Actions Bar -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="BackupSectionTitle" Text="建立備份與系統還原點" FontWeight="SemiBold" FontSize="15" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBox x:Name="BackupDescBox" Grid.Column="0" Header="備份說明 (Description)"
                                                  Text="{x:Bind ViewModel.ManualBackupDescription, Mode=TwoWay}" PlaceholderText="例如: 遊戲前優化備份" />
                                         <Button x:Name="CreateManualBackupBtn" Grid.Column="1" Content="💾 建立登錄檔備份" Command="{x:Bind ViewModel.CreateManualBackupCommand}"
                                                 Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                         <Button x:Name="CreateRestorePointBtn" Grid.Column="2" Content="🛡️ 建立系統還原點" Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                                 VerticalAlignment="Bottom" />
                                         <Button x:Name="OpenBackupFolderBtn" Grid.Column="3" Content="📂 開啟備份資料夾" Command="{x:Bind ViewModel.OpenBackupFolderCommand}"
                                                 VerticalAlignment="Bottom" />
                                     </Grid>
                                 </StackPanel>
                            </Border>

                            <!-- Backups List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="BackupsListTitle" Text="已建立的登錄檔快照與備份 (.reg)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}"
                                              SelectionMode="Single" MaxHeight="220"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:RegistryBackupItem">
                                                <Grid Padding="4,6" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Description}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <Button Grid.Column="3" Content="🔄 還原" Click="RestoreBackup_Click" Padding="8,2" FontSize="11" />
                                                    <Button Grid.Column="4" Content="🗑️" Click="DeleteBackup_Click" Padding="6,2" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- System Restore Points List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="RestorePointsListTitle" Text="Windows 系統還原點清單 (System Restore Points)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.RestorePoints, Mode=OneWay}" SelectionMode="None" MaxHeight="180"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SystemRestorePointItem">
                                                <Grid Padding="4,4" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Summary}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 5: OneDrive 深度管理、修復與徹底卸載 (OneDrive Governance) ════ -->
                <TabViewItem x:Name="TabOneDrive" Header="☁️ OneDrive 深度治理與卸載" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Status Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="40"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="OneDriveStatusTitle" Text="Microsoft OneDrive 系統狀態" FontWeight="Bold" FontSize="16" />
                                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind ViewModel.OneDriveInstalledStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Five status chips wrapped into a two-column grid: as one long
                                             single-line row they ran underneath the refresh button. -->
                                        <Grid ColumnSpacing="16" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.OneDriveRunningStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OneDriveRedirectStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.OneDriveCloudFilesStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OneDriveGhostIconStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind ViewModel.OneDrivePolicyStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshOneDriveStatusCommand}"
                                            VerticalAlignment="Center" Padding="12,6" />
                                </Grid>
                            </Border>

                            <!-- Actions Card: Core Repairs & Deep Uninstall -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="OneDrive 網路社群 5 大核心災情修復與深度解除安裝" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="針對微軟 OneDrive 強制綁架桌面/個人資料夾路徑、解除安裝後側邊欄殘留幽靈圖示、同步引擎無限卡死 Processing Changes，提供一鍵安全修復與徹底卸載。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Action 1: Deep Uninstall -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="Crimson" />
                                                    <TextBlock Text="徹底解除安裝 OneDrive (Deep Uninstall)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="強制終止處理程序、執行卸載精靈、清除殘留快取，自動將桌面/文件安全移回本機 %USERPROFILE% 並封鎖自動重裝。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🚀 徹底解除安裝 OneDrive" Command="{x:Bind ViewModel.DeepUninstallOneDriveCommand}"
                                                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 2: Restore User Shell Folders -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="還原桌面與個人資料夾路徑 (Fix Known Folder Move)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="修復被 OneDrive 綁架之 Desktop、Documents、Pictures 路徑，安全遷移檔案回 %USERPROFILE% 原生目錄。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="📁 還原個人資料夾原生路徑" Command="{x:Bind ViewModel.RestoreOneDriveShellFoldersCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 3: Remove Ghost Icon -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="移除檔案總管左側幽靈圖示 (Explorer Ghost Icon)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="清除 CLSID 註冊表中殘留的 OneDrive 導覽樹狀目錄釘選圖示，並重啟檔案總管生效。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🧹 清除檔案總管幽靈圖示" Command="{x:Bind ViewModel.RemoveOneDriveGhostIconCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 4: Reset Sync Engine -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="重設同步引擎 (Fix Infinite Processing Changes)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="執行 onedrive.exe /reset 清除損毀之內部同步資料庫與快取，解決 100% CPU 佔用或卡死迴圈。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🔄 重設同步引擎並重啟" Command="{x:Bind ViewModel.ResetOneDriveSyncEngineCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Policy Block Toggle -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="群組原則永久封鎖 Windows Update 自動重新安裝 (DisableFileSyncNGSC)" FontWeight="SemiBold" />
                                                <TextBlock Text="寫入 HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive，徹底阻止 Windows 更新喚醒 OneDrive。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="切換原則封鎖" Command="{x:Bind ViewModel.ToggleOneDrivePolicyBlockCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 6: OEM 驅動程式清理 (Driver Cleanup - PnPUtil) ════ -->
                <TabViewItem x:Name="TabDrivers" Header="🏎️ 驅動清理 (PnPUtil)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Control Bar Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="PnPUtil OEM 協力廠商驅動程式清理與移除" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="列舉已安裝於 DriverStore 的 oem*.inf 驅動套件，支援強制卸載老舊、重複或孤立的驅動程式。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshDriversCommand}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="☑️ 全選" Click="SelectAllDrivers_Click"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="🗑️ 批次卸載選取項" Command="{x:Bind ViewModel.BatchDeleteSelectedDriversCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoadingDrivers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Drivers ListView Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="已安裝之 OEM 驅動套件清單" FontWeight="SemiBold" />

                                    <ListView ItemsSource="{x:Bind ViewModel.OemDrivers, Mode=OneWay}"
                                              SelectionMode="None" MaxHeight="450"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:OemDriverItem">
                                                <Grid Padding="6,6" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind SignerName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <Button Grid.Column="3" Content="🗑️ 卸載" Click="DeleteDriverItem_Click"
                                                            VerticalAlignment="Center" Padding="8,4" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 8: NVMe 防卡頓與 SSD TRIM 調校 (NVMe Anti-Stutter & TRIM) ════ -->
                <TabViewItem x:Name="TabNvme" Header="🚀 NVMe與SSD (NVMe &amp; SSD)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Master Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                    CornerRadius="10" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="44" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="NvmeHeroTitle" Text="老外實測推薦：NVMe 極致防卡頓與 SSD TRIM 調校" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" />
                                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="StorNVMe &amp; APST" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="NvmeHeroSubtitle" Text="一鍵關閉 NVMe 自主電源微睡眠 (EnableAPST=0)、最佳化 StorNVMe 佇列並行上限 (NumberOfRequests=64，防止死鎖與延遲飆升)、並全面啟用 NTFS/ReFS TRIM 垃圾回收。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button x:Name="ApplyGamingNvmeBtn" Content="🚀 一鍵套用電競防卡頓優化"
                                                Command="{x:Bind ViewModel.ApplyGamingNvmeProfileCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Padding="14,8" />
                                        <Button x:Name="RestoreNvmeDefaultsBtn" Content="🛡️ 還原 Windows 預設"
                                                Command="{x:Bind ViewModel.RestoreDefaultNvmeProfileCommand}" Padding="12,8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Reboot Alert Bar -->
                            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                                     Title="驅動程式參數重啟提示"
                                     Message="⚠️ 注意：修改 StorNVMe 驅動參數 (EnableAPST / NumberOfRequests) 需重新啟動電腦後方能載入生效。" />

                            <!-- Status Banner -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- APST Status -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="⚡ NVMe APST 狀態" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ApstStatusDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- Queue Status -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="📊 佇列並行上限 (Queue Depth)" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.QueueStatusDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- TRIM Status -->
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="✂️ SSD TRIM 回收通知" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TrimStatusDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- Refresh Button -->
                                    <Button Grid.Column="3" Command="{x:Bind ViewModel.RefreshNvmeTelemetryCommand}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            <TextBlock Text="重新整理" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 1: Disable APST (Photo 4 & Photo 3) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="ApstCardTitle" Text="關閉 NVMe APST 自主電源微睡眠 (老外實測：徹底解決卡頓)" FontWeight="SemiBold" FontSize="15" />
                                        </StackPanel>
                                        <TextBlock x:Name="ApstCardDesc" Text="在 HKLM\SYSTEM\CurrentControlSet\Services\stornvme\Parameters\Device 寫入 EnableAPST = 0。關閉硬碟自主省電轉換，防止 SSD 在遊戲讀圖、資產串流或閒置後突然讀取時因喚醒延遲引發微卡頓（Frame-time Spikes）與 Event ID 129 重置。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="ApstToggle"
                                                  IsOn="{x:Bind ViewModel.IsApstDisabled, Mode=OneWay}"
                                                  Toggled="ApstToggle_Toggled"
                                                  OnContent="已關閉微睡眠 (防卡頓已啟用)"
                                                  OffContent="系統預設微睡眠" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Card 2: NumberOfRequests Queue Depth (Photo 2) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="QueueCardTitle" Text="StorNVMe 佇列請求上限調校 (NumberOfRequests)" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock x:Name="QueueCardDesc" Text="調校 Windows 內建 stornvme.sys 對 SSD 控制器派發的同時排隊 I/O 容量。⚠️ 注意：如影片特別強調，千萬不要建完之後直接保持為 0！(設為 0 會使驅動無法處理任何指令)。推薦 32 或 64 以達到極佳響應與抗過載穩定性。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <!-- Quick Preset Buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="推薦預設檔:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <Button Content="32 (低延遲/抗過載)" Command="{x:Bind ViewModel.ApplyQueuePresetCommand}" CommandParameter="32" Padding="8,3" FontSize="12" />
                                        <Button Content="64 (平衡電競推薦 - 主流最佳值)" Command="{x:Bind ViewModel.ApplyQueuePresetCommand}" CommandParameter="64" Style="{StaticResource AccentButtonStyle}" Padding="8,3" FontSize="12" />
                                        <Button Content="128 (旗艦 PCIe 4.0/5.0)" Command="{x:Bind ViewModel.ApplyQueuePresetCommand}" CommandParameter="128" Padding="8,3" FontSize="12" />
                                        <Button Content="255 (最大極限吞吐)" Command="{x:Bind ViewModel.ApplyQueuePresetCommand}" CommandParameter="255" Padding="8,3" FontSize="12" />
                                        <Button Content="🔄 恢復系統預設" Command="{x:Bind ViewModel.ResetQueueToDefaultCommand}" Padding="8,3" FontSize="12" />
                                    </StackPanel>

                                    <!-- Custom Value Input -->
                                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox Grid.Column="0" Header="自訂請求數 (1 ~ 255，不可為 0)"
                                                   Value="{x:Bind ViewModel.CustomNumberOfRequests, Mode=TwoWay}"
                                                   Minimum="1" Maximum="255" SpinButtonPlacementMode="Compact" />
                                        <Button Grid.Column="1" Content="💾 套用自訂上限"
                                                Command="{x:Bind ViewModel.ApplyCustomQueueCommand}"
                                                VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Column="2" Text="※ 數值僅接受 1-255，設為 0 會被系統防呆機制自動攔截保護。"
                                                   VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: TRIM (Photo 1) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="TrimCardTitle" Text="SSD 檔案系統 TRIM 廢料回收指令 (fsutil DisableDeleteNotify)" FontWeight="SemiBold" FontSize="15" />
                                        </StackPanel>
                                        <TextBlock x:Name="TrimCardDesc" Text="如附圖所示：fsutil behavior query DisableDeleteNotify 結果為 0 代表 TRIM 已啟用。啟用 TRIM 能在刪除檔案時通知 SSD 即時標記廢料區塊，避免寫入放大並維持 NVMe 長期極速讀寫效能。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                            <Button Content="✂️ 手動執行全磁碟 TRIM 重修復 (ReTrim)"
                                                    Command="{x:Bind ViewModel.RunManualTrimCommand}" />
                                            <Button Content="🟢 強制啟用 NTFS &amp; ReFS TRIM (設為 0)"
                                                    Command="{x:Bind ViewModel.ToggleTrimCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="TrimToggle"
                                                  IsOn="{x:Bind ViewModel.IsNtfsTrimEnabled, Mode=OneWay}"
                                                  Toggled="TrimToggle_Toggled"
                                                  OnContent="TRIM 已啟用 (0)"
                                                  OffContent="TRIM 已停用 (1)" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Operation Feedback Notice -->
                            <InfoBar Severity="Informational"
                                     IsOpen="{x:Bind ViewModel.NvmeOperationMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                     Title="操作執行反饋"
                                     Message="{x:Bind ViewModel.NvmeOperationMessage, Mode=OneWay}" />

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>

        <!-- ═══ Bottom Console Output ═══ -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="ConsoleLogTitle" Text="系統最佳化與排程調校終端記錄" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearLogCommand}" Padding="8,2" FontSize="11" />
                </Grid>
                <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              CornerRadius="6" Padding="10">
                    <TextBlock Text="{x:Bind ViewModel.ConsoleLog, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
