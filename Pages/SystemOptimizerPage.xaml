                                                <TextBlock Text="還原系統預設圓角摺疊式選單" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                            </StackPanel>
