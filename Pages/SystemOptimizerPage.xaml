                                    <!-- Switch 1: Nagle's Algorithm -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="NagleLabel" Text="停用 Nagle 演算法 (TcpAckFrequency = 1 &amp; TCPNoDelay = 1)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="NagleDesc" Text="強制網卡立刻發送 TCP 封包，不進行佇列合併等待，大幅降低線上遊戲連線 Ping 與操作抖動。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsNagleDisabled, Mode=OneWay}"
                                                      Toggled="Nagle_Toggled" />
                                    </Grid>

                                    <!-- Switch 2: Disable Paging Executive -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="PagingExecLabel" Text="核心與驅動鎖定於實體 RAM (DisablePagingExecutive = 1)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PagingExecDesc" Text="禁止 Windows 將核心系統代碼與驅動程式分頁寫入虛擬記憶體硬碟，確保 100% 於高速 RAM 運行。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDisablePagingExecutive, Mode=OneWay}"
                                                      Toggled="DisablePagingExecutive_Toggled" />
                                    </Grid>

                                    <!-- Switch 3: Group Policy Privacy & Telemetry -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="GroupPolicyLabel" Text="本機群組原則隱私防護 (關閉遙測/開始功能表Bing/P2P上傳)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GroupPolicyDesc" Text="關閉 AllowTelemetry、停用開始功能表網路搜尋、關閉傳遞最佳化 P2P 背景佔用。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsGroupPolicyTelemetryDisabled, Mode=OneWay}"
                                                      Toggled="GroupPolicyTelemetry_Toggled" />
                                    </Grid>

                                    <!-- Switch 4 (Item 7): DPS Service Memory Bloat Fix -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="DpsServiceLabel" Text="停用 DPS 診斷原則服務防記憶體膨脹 (DPS Start = 4)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="HKLM\SYSTEM\CurrentControlSet\Services\DPS" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="DpsServiceDesc" Text="設定 Start = 4 (Disabled) 並停止 Diagnostic Policy Service，防止背景疑難排解監控引發 svchost 記憶體無限膨脹與 CPU 尖峰。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.DpsServiceStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDpsServiceDisabled, Mode=OneWay}"
                                                      Toggled="DpsService_Toggled" />
                                    </Grid>

                                    <!-- Switch 5 (Item 5): L2TP/IPsec VPN NAT-T Fix -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="L2tpVpnLabel" Text="L2TP/IPsec VPN NAT 穿透連線修復 (AssumeUDPEncapsulationContextOnSendRule = 2)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="HKLM\SYSTEM\CurrentControlSet\Services\PolicyAgent" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="L2tpVpnDesc" Text="在 PolicyAgent 建立 REG_DWORD 值 AssumeUDPEncapsulationContextOnSendRule = 2，徹底解決位於路由器 NAT 後方時 L2TP/IPsec VPN 無法連線 (錯誤 789 / 809) 問題。修改後重開機生效。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.L2tpVpnNatRuleDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsL2tpVpnNatFixEnabled, Mode=OneWay}"
                                                      Toggled="L2tpVpnNatFix_Toggled" />
                                    </Grid>

                                    <!-- Panel 6 (Item 9): DiagTrack Service Turn Off / Turn On -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
