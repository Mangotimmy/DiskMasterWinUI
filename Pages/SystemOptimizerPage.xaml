<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" MinHeight="80" MaxHeight="400" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshAllCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshAllBtnText" Text="重新整理系統狀態" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- Movable Sub TabView -->
        <TabView x:Name="OptimizerTabView" Grid.Row="1"
                 TabWidthMode="SizeToContent"
                 CanReorderTabs="True" CanDragTabs="True"
                 IsAddTabButtonVisible="False"
                 SelectionChanged="OptimizerTabView_SelectionChanged">
            <TabView.TabItems>

                <!-- ════ Tab 1: 電競遊戲模式 (Gaming Mode) ════ -->
                <TabViewItem x:Name="TabGaming" Header="🎮 電競遊戲 (Gaming Mode)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Master Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                    CornerRadius="10" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="48"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="HeroTitle" Text="電競遊戲極致模式 (Ultra Gaming Mode)" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" />
                                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="FPSHEAVEN &amp; MMCSS" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroSubtitle" Text="一鍵同步調校：CPU 量子時間分配 (0x26)、啟用終極效能電源計畫、優化前台算力保留 (SystemResponsiveness=10)、關閉網路節流防 Ping 突增、關閉 Game DVR 背景錄影負擔、開啟 HAGS 硬體加速與 1:1 感應器零延遲。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button x:Name="ApplyGamingBtn" Content="🎮 一鍵套用電競模式"
                                                Command="{x:Bind ViewModel.ApplyGamingProfileCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Padding="16,8" FontWeight="SemiBold" />
                                        <Button x:Name="RestoreDefaultsBtn" Content="🛡️ 還原官方預設"
                                                Command="{x:Bind ViewModel.RestoreDefaultsCommand}" Padding="12,8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sub Cards Grid -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: GameDVR & HAGS -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="GpuCardTitle" Text="背景錄影與顯卡硬體排程" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <!-- Label above its registry badge: side by side they clipped inside
                                                     the narrow two-column sub-card at 1000 DIP window widths. -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="GameDvrTitle" Text="停用 Game DVR / Xbox Game Bar (GameDVR_Enabled = 0)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="HKCU\System\GameConfigStore" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="GameDvrDesc" Text="寫入 GameDVR_Enabled = 0 (REG_DWORD) 與 AppCaptureEnabled = 0，徹底關閉背景錄影虛擬層以釋放 CPU/RAM/GPU 資源 (建議重開機生效)。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsGameDvrDisabled, Mode=OneWay}"
                                                          Toggled="GameDvr_Toggled" />
                                        </Grid>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="HagsTitle" Text="硬體加速 GPU 排程 (HAGS)" FontWeight="SemiBold" />
                                                <TextBlock x:Name="HagsDesc" Text="由 GPU 專屬晶片直接管理 VRAM，減少幀生成延遲。(需顯卡支援並重開機 🟡)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsHagsEnabled, Mode=OneWay}"
                                                          Toggled="Hags_Toggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Low Input Latency -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE962;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="InputCardTitle" Text="電競周邊零延遲響應" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="InputLatencyTitle" Text="滑鼠 1:1 感應器追蹤 &amp; 鍵盤零延遲" FontWeight="SemiBold" />
                                                <TextBlock x:Name="InputLatencyDesc" Text="移除指針平滑加速度曲線，將鍵盤重複延遲設為 0，消除選單動畫等待時間。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsLowInputLatencyEnabled, Mode=OneWay}"
                                                          Toggled="InputLatency_Toggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Card 3: Khronos Vulkan Layer Optimizer & Pure Zero-Overlay Gaming Mode (/boost) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="🎮 Khronos Vulkan 圖形層深度診斷、防閃退清理與零延遲電競模式" FontWeight="Bold" FontSize="15" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind ViewModel.VulkanStatusSummary, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="深度掃描 64 位元與 32 位元 (WOW6432Node) Vulkan ExplicitLayers 與 ImplicitLayers 登錄檔。一鍵清除解除安裝後殘留的「幽靈圖形層」(修復 VK_ERROR_LAYER_NOT_PRESENT 遊戲啟動閃退)，或啟用「純淨 Vulkan 零延遲模式」阻斷所有第三方覆蓋層 (Discord/OBS/Steam/EOS/RTSS) 對畫面呈遞的攔截，確保 1% low FPS 穩定流暢。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🧹 清除幽靈殘留圖形層" Command="{x:Bind ViewModel.PurgeOrphanedVulkanLayersCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshVulkanLayersCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Pure Vulkan Zero-Overlay Mode Banner -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="🚀 純淨 Vulkan 電競零延遲模式 (VK_LOADER_LAYERS_DISABLE = ~implicit~)" FontWeight="SemiBold" />
                                                <TextBlock Text="將強制 Vulkan 載入器 (vulkan-1.dll) 繞過所有第三方全域隱式覆蓋層 (Steam/Discord/OBS/RTSS)，保留硬體顯卡驅動與遊戲原廠功能，杜絕微卡頓 (Micro-stuttering) 與記憶體掛勾衝突。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsPureVulkanMode, Mode=OneWay}"
                                                          OnContent="零延遲純淨已啟用" OffContent="第三方覆蓋層已允許"
                                                          Toggled="PureVulkanMode_Toggled" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Registered Vulkan Layers List -->
                                    <Expander Header="📋 檢視本機已註冊之 Vulkan 圖形層清單 (64-bit / 32-bit WOW6432Node / Explicit &amp; Implicit)"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <ListView ItemsSource="{x:Bind ViewModel.VulkanLayers, Mode=OneWay}" SelectionMode="None" MaxHeight="260"
                                                  HorizontalAlignment="Stretch"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:VulkanLayerItem">
                                                    <Grid Padding="4,6" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind HiveName}" FontSize="11" FontFamily="Consolas" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind ManifestPath}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind TypeBadge}" FontSize="11" />
                                                        </Border>
                                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 2: CPU排程與工作優先權 (CPU & Task Priority) ════ -->
                <TabViewItem x:Name="TabCpu" Header="⚡ CPU與排程 (CPU &amp; Task)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Win32PrioritySeparation Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="CpuPriorityTitle" Grid.Column="1" Text="CPU 量子時間分配 (Win32PrioritySeparation)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Button x:Name="ApplyCpuPresetBtn" Grid.Column="2" Content="⚡ 套用 CPU 排程方案" Command="{x:Bind ViewModel.ApplyCpuPresetCommand}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>

                                    <ComboBox x:Name="CpuPresetCombo" Header="選擇排程方案 (FPSHeaven &amp; Windows Internals 標準)"
                                              SelectedIndex="{x:Bind ViewModel.SelectedCpuPresetIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem x:Name="CpuComboItem0" Content="0x26 (Dec 38): 電競通用推薦 (短量子 + 前景 3 倍優先權，流暢響應)" />
                                        <ComboBoxItem x:Name="CpuComboItem1" Content="0x2A (Dec 42): FPSHeaven 極致競技 (短量子 + 固定配額 + 前景 3 倍，杜絕排程抖動 Jitter，輸入延遲最低)" />
                                        <ComboBoxItem x:Name="CpuComboItem2" Content="0x28 (Dec 40): FPSHeaven 消除微卡頓 (短量子 + 固定配額 + 平權，使 1% Low 幀率極致穩定)" />
                                        <ComboBoxItem x:Name="CpuComboItem3" Content="0x16 (Dec 22): 經典 FPS 模式 (長量子 + 前景 3 倍)" />
                                        <ComboBoxItem x:Name="CpuComboItem4" Content="0x18 (Dec 24): 高效能工作站/伺服器 (長量子 + 固定配額，高吞吐量)" />
                                        <ComboBoxItem x:Name="CpuComboItem5" Content="0x02 (Dec 2): Windows 官方預設值 (Default)" />
                                    </ComboBox>

                                    <!-- Explanation InfoBar -->
                                    <InfoBar x:Name="CpuExplanationInfoBar" IsOpen="True" Severity="Informational" IsClosable="False"
                                             Title="排程架構原理"
                                             Message="固定時間配額 (Fixed Quantum) 能防止背景任務突發打斷遊戲執行緒，在 CS2、Valorant 等電競遊戲中能大幅改善準心操作一致性與 1% Low 幀率。修改後重開機生效。" />
                                </StackPanel>
                            </Border>

                            <!-- ════ 指定應用程式 CPU 執行緒優先權自訂 (CPU Priority Program Selection & IFEO) ════ -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7EE;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="CpuAppPriorityCardTitle" Text="🎯 指定應用程式 CPU 執行緒優先權自訂 (IFEO 常駐與即時調節)" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="CpuAppPriorityCardDesc" Text="為特定電競遊戲或重載應用程式自訂 CPU 排程優先權 (即時 / 高 / 高於標準 / 標準)。支援 Windows IFEO 登錄檔常駐，開機與每次啟動自動生效，零背景常駐負擔。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="RefreshProcessesBtn" Grid.Column="2" Command="{x:Bind ViewModel.RefreshRunningProcessesCommand}"
                                                Padding="10,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock x:Name="RefreshProcessesBtnText" Text="重新整理行程" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Controls Row -->
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Running Process Selector -->
                                        <ComboBox x:Name="CpuAppProcessCombo" Grid.Column="0"
                                                  Header="選擇執行中處理程序 (Process)"
                                                  ItemsSource="{x:Bind ViewModel.RunningProcesses, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  PlaceholderText="點擊展開選擇執行中之程式..."
                                                  HorizontalAlignment="Stretch" />

                                        <!-- Or Manual Process Input -->
                                        <TextBox x:Name="CpuAppProcessTextBox" Grid.Column="1"
                                                 Header="或手動輸入可執行檔名稱"
                                                 Text="{x:Bind ViewModel.CustomProcessInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="例如: cs2.exe, chrome.exe"
                                                 HorizontalAlignment="Stretch" />

                                        <!-- Priority Selection -->
                                        <ComboBox x:Name="CpuAppPriorityCombo" Grid.Column="2"
                                                  Header="目標 CPU 優先權"
                                                  SelectedIndex="{x:Bind ViewModel.SelectedPriorityIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem x:Name="PriorityItem0" Content="⚡ 即時 (Realtime)" />
                                            <ComboBoxItem x:Name="PriorityItem1" Content="🚀 高 (High)" />
                                            <ComboBoxItem x:Name="PriorityItem2" Content="⬆️ 高於標準 (AboveNormal)" />
                                            <ComboBoxItem x:Name="PriorityItem3" Content="🟢 標準 (Normal)" />
                                        </ComboBox>

                                        <!-- Immediate Apply Button -->
                                        <Button x:Name="ApplyProcessPriorityBtn" Grid.Column="3"
                                                Command="{x:Bind ViewModel.ApplyProcessPriorityCommand}"
                                                VerticalAlignment="Bottom" Padding="12,7">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                <TextBlock x:Name="ApplyProcessPriorityBtnText" Text="即時套用" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Save Persisted Rule Button -->
                                        <Button x:Name="SaveProcessPriorityRuleBtn" Grid.Column="4"
                                                Command="{x:Bind ViewModel.SavePersistedRuleCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                VerticalAlignment="Bottom" Padding="12,7">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                                <TextBlock x:Name="SaveProcessPriorityRuleBtnText" Text="儲存為開機常駐規則 (IFEO)" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Active Persisted Rules List -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock x:Name="PersistedRulesTitle" Text="已建立之 CPU 優先權常駐規則清單 (IFEO Registry)" FontWeight="SemiBold" FontSize="13" />
                                                </StackPanel>
