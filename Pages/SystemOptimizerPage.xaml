                                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock x:Name="DiagTrackCardTitle" Text="DiagTrack 遙測追蹤服務控制 (Connected User Experiences and Telemetry)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock x:Name="DiagTrackCardDesc" Text="一鍵執行 `sc stop DiagTrack &amp; sc config DiagTrack start=disabled` 徹底關閉微軟背景診斷追蹤服務，釋放背景 I/O 與頻寬。關閉後 Windows Update 依然完全正常運作！" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.DiagTrackStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
