<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" MinHeight="80" MaxHeight="400" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshAllCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshAllBtnText" Text="重新整理系統狀態" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- Movable Sub TabView -->
        <TabView x:Name="OptimizerTabView" Grid.Row="1"
                 CanReorderTabs="True" CanDragTabs="True"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>

                <!-- ════ Tab 1: 電競遊戲模式 (Gaming Mode) ════ -->
                <TabViewItem x:Name="TabGaming" Header="🎮 電競遊戲模式 (Gaming Mode)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Master Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                    CornerRadius="10" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="48"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="HeroTitle" Text="電競遊戲極致模式 (Ultra Gaming Mode)" FontWeight="Bold" FontSize="18" />
                                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="FPSHEAVEN &amp; MMCSS" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroSubtitle" Text="一鍵同步調校：CPU 量子時間分配 (0x26)、啟用終極效能電源計畫、解鎖 100% 前台算力 (SystemResponsiveness=0)、關閉網路節流防 Ping 突增、關閉 Game DVR 背景錄影負擔、開啟 HAGS 硬體加速與 1:1 感應器零延遲。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button x:Name="ApplyGamingBtn" Content="🎮 一鍵套用電競模式"
                                                Command="{x:Bind ViewModel.ApplyGamingProfileCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Padding="16,8" FontWeight="SemiBold" />
                                        <Button x:Name="RestoreDefaultsBtn" Content="🛡️ 還原官方預設"
                                                Command="{x:Bind ViewModel.RestoreDefaultsCommand}" Padding="12,8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sub Cards Grid -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: GameDVR & HAGS -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="GpuCardTitle" Text="背景錄影與顯卡硬體排程" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="GameDvrTitle" Text="停用 Game DVR / Xbox Game Bar" FontWeight="SemiBold" />
                                                <TextBlock x:Name="GameDvrDesc" Text="徹底關閉背景錄影與快照虛擬層，釋放顯卡與 CPU 資源。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsGameDvrDisabled, Mode=OneWay}"
                                                          Toggled="GameDvr_Toggled" />
                                        </Grid>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="HagsTitle" Text="硬體加速 GPU 排程 (HAGS)" FontWeight="SemiBold" />
                                                <TextBlock x:Name="HagsDesc" Text="由 GPU 專屬晶片直接管理 VRAM，減少幀生成延遲。(需顯卡支援並重開機 🟡)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsHagsEnabled, Mode=OneWay}"
                                                          Toggled="Hags_Toggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Low Input Latency -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE962;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock x:Name="InputCardTitle" Text="電競周邊零延遲響應" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="InputLatencyTitle" Text="滑鼠 1:1 感應器追蹤 &amp; 鍵盤零延遲" FontWeight="SemiBold" />
                                                <TextBlock x:Name="InputLatencyDesc" Text="移除指針平滑加速度曲線，將鍵盤重複延遲設為 0，消除選單動畫等待時間。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsLowInputLatencyEnabled, Mode=OneWay}"
                                                          Toggled="InputLatency_Toggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 2: CPU排程與工作優先權 (CPU & Task Priority) ════ -->
                <TabViewItem x:Name="TabCpu" Header="⚡ CPU與排程優先權 (CPU &amp; Task)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Win32PrioritySeparation Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="CpuPriorityTitle" Grid.Column="1" Text="CPU 量子時間分配 (Win32PrioritySeparation)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Button x:Name="ApplyCpuPresetBtn" Grid.Column="2" Content="⚡ 套用 CPU 排程方案" Command="{x:Bind ViewModel.ApplyCpuPresetCommand}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>

                                    <ComboBox x:Name="CpuPresetCombo" Header="選擇排程方案 (FPSHeaven &amp; Windows Internals 標準)"
                                              SelectedIndex="{x:Bind ViewModel.SelectedCpuPresetIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem x:Name="CpuComboItem0" Content="0x26 (Dec 38): 電競通用推薦 (短量子 + 前景 3 倍優先權，流暢響應)" />
                                        <ComboBoxItem x:Name="CpuComboItem1" Content="0x2A (Dec 42): FPSHeaven 極致競技 (短量子 + 固定配額 + 前景 3 倍，杜絕排程抖動 Jitter，輸入延遲最低)" />
                                        <ComboBoxItem x:Name="CpuComboItem2" Content="0x28 (Dec 40): FPSHeaven 消除微卡頓 (短量子 + 固定配額 + 平權，使 1% Low 幀率極致穩定)" />
                                        <ComboBoxItem x:Name="CpuComboItem3" Content="0x16 (Dec 22): 經典 FPS 模式 (長量子 + 前景 3 倍)" />
                                        <ComboBoxItem x:Name="CpuComboItem4" Content="0x18 (Dec 24): 高效能工作站/伺服器 (長量子 + 固定配額，高吞吐量)" />
                                        <ComboBoxItem x:Name="CpuComboItem5" Content="0x02 (Dec 2): Windows 官方預設值 (Default)" />
                                    </ComboBox>

                                    <!-- Explanation InfoBar -->
                                    <InfoBar x:Name="CpuExplanationInfoBar" IsOpen="True" Severity="Informational" IsClosable="False"
                                             Title="排程架構原理"
                                             Message="固定時間配額 (Fixed Quantum) 能防止背景任務突發打斷遊戲執行緒，在 CS2、Valorant 等電競遊戲中能大幅改善準心操作一致性與 1% Low 幀率。修改後重開機生效。" />
                                </StackPanel>
                            </Border>

                            <!-- MMCSS & Power Throttling Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="MmcssCardTitle" Text="多媒體類別排程器 (MMCSS) 與能源節流" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="PowerThrottlingLabel" Text="停用 CPU 能源節流 (PowerThrottlingOff = 1)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PowerThrottlingDesc" Text="防止 Windows 10/11 核心對背景執行緒或非活動遊戲視窗強制降頻節能。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsPowerThrottlingDisabled, Mode=OneWay}"
                                                      Toggled="PowerThrottling_Toggled" />
                                    </Grid>

                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="SystemResponsivenessLabel" Text="100% 前台 CPU 算力分配 (SystemResponsiveness = 0)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SystemResponsivenessDesc" Text="釋放 Windows 原生預留給系統背景服務的 20% CPU 保留份額，全數交由前台遊戲享用。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsSystemResponsivenessZero, Mode=OneWay}"
                                                      Toggled="SystemResponsiveness_Toggled" />
                                    </Grid>

                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="NetworkThrottlingLabel" Text="停用網路封包限速佇列 (NetworkThrottlingIndex = 0xFFFFFFFF)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="NetworkThrottlingDesc" Text="停用 Windows 在遊戲與音訊執行期間的網路限速佇列，徹底解決線上遊戲 Ping 忽高忽低與丟包問題。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsNetworkThrottlingDisabled, Mode=OneWay}"
                                                      Toggled="NetworkThrottling_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- MMAgent Memory Management Agent Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MmAgentCardTitle" Grid.Column="1" Text="🧠 記憶體管理代理 (MMAgent - Memory Management)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Button x:Name="QuickGamingRamBtn" Grid.Column="2" Content="🎮 一鍵電競低延遲 (0壓縮/0合併)"
                                                Command="{x:Bind ViewModel.ApplyGamingRamProfileCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                        <Button x:Name="RestoreStockRamBtn" Grid.Column="3" Content="🛡️ 還原官方預設"
                                                Command="{x:Bind ViewModel.RestoreStockRamProfileCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Switch 1: Memory Compression -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="MemCompressionLabel" Text="記憶體壓縮 (Memory Compression -mc)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="MemCompressionDesc" Text="關閉可杜絕高負載遊戲期間 CPU 背景解壓縮分頁引發的突發 CPU 尖峰與微卡頓 (建議 16GB/32GB+ RAM 遊戲機關閉)。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsMemoryCompressionEnabled, Mode=OneWay}"
                                                      Toggled="MemoryCompression_Toggled" />
                                    </Grid>

                                    <!-- Switch 2: Page Combining -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="PageCombiningLabel" Text="記憶體分頁合併 (Page Combining)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PageCombiningDesc" Text="關閉可防止 Windows 定期於背景掃描並合併重複記憶體分頁，大幅降低遊戲期間之記憶體存取延遲。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsPageCombiningEnabled, Mode=OneWay}"
                                                      Toggled="PageCombining_Toggled" />
                                    </Grid>

                                    <!-- Switch 3: Application PreLaunch -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="AppPreLaunchLabel" Text="應用程式預先啟動 (Application PreLaunch)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AppPreLaunchDesc" Text="控制 Windows 是否在背景預先喚醒並載入常用 UWP / 系統應用程式。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsAppPreLaunchEnabled, Mode=OneWay}"
                                                      Toggled="AppPreLaunch_Toggled" />
                                    </Grid>

                                    <!-- Switch 4: Application Launch Profiling -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="AppLaunchProfilingLabel" Text="啟動分析評測 (Application Launch Profiling)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AppLaunchProfilingDesc" Text="控制 Superfetch / SysMain 服務對應用程式啟動時序之長期監控與行為分析。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsAppLaunchProfilingEnabled, Mode=OneWay}"
                                                      Toggled="AppLaunchProfiling_Toggled" />
                                    </Grid>

                                    <!-- Switch 5: Operation Recording -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="OpRecordingLabel" Text="系統操作記錄 (Operation Recording)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="OpRecordingDesc" Text="控制 Prefetch 追蹤開機與操作磁碟讀取模式之記錄機制。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsOperationRecordingEnabled, Mode=OneWay}"
                                                      Toggled="OperationRecording_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Latency, Memory & Group Policy Tweaks Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE772;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="AdvTweaksCardTitle" Text="⚡ 深度低延遲登錄檔與群組原則優化" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Switch 1: Nagle's Algorithm -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="NagleLabel" Text="停用 Nagle 演算法 (TcpAckFrequency = 1 &amp; TCPNoDelay = 1)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="NagleDesc" Text="強制網卡立刻發送 TCP 封包，不進行佇列合併等待，大幅降低線上遊戲連線 Ping 與操作抖動。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsNagleDisabled, Mode=OneWay}"
                                                      Toggled="Nagle_Toggled" />
                                    </Grid>

                                    <!-- Switch 2: Disable Paging Executive -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="PagingExecLabel" Text="核心與驅動鎖定於實體 RAM (DisablePagingExecutive = 1)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PagingExecDesc" Text="禁止 Windows 將核心系統代碼與驅動程式分頁寫入虛擬記憶體硬碟，確保 100% 於高速 RAM 運行。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDisablePagingExecutive, Mode=OneWay}"
                                                      Toggled="DisablePagingExecutive_Toggled" />
                                    </Grid>

                                    <!-- Switch 3: Group Policy Privacy & Telemetry -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="GroupPolicyLabel" Text="本機群組原則隱私防護 (關閉遙測/開始功能表Bing/P2P上傳)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GroupPolicyDesc" Text="關閉 AllowTelemetry、停用開始功能表網路搜尋、關閉傳遞最佳化 P2P 背景佔用。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsGroupPolicyTelemetryDisabled, Mode=OneWay}"
                                                      Toggled="GroupPolicyTelemetry_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 3: 電源計畫與核心喚醒 (Power Plans & Core Unparking) ════ -->
                <TabViewItem x:Name="TabPower" Header="🔋 電源計畫與核心喚醒 (Power Plans)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Unlock & Quick Toggles -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="PowerQuickTitle" Text="電源配置快速調校與旗艦解鎖" FontWeight="SemiBold" FontSize="15" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="UnlockUltimateBtn" Content="⚡ 解鎖並啟用「終極效能 (Ultimate Performance)」"
                                                Command="{x:Bind ViewModel.UnlockUltimatePerformanceCommand}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="UnlockHighBtn" Content="🚀 解鎖「高效能 (High Performance)」"
                                                Command="{x:Bind ViewModel.UnlockHighPerformanceCommand}" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock x:Name="CoreUnparkingLabel" Text="CPU 核心防休眠 (Core Unparking)" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CoreUnparkingDesc" Text="設定 CPMINCORES=100，讓所有核心隨時處於啟用狀態，消除動態喚醒微卡頓。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsCoreUnparked, Mode=OneWay}"
                                                              Toggled="CoreUnparking_Toggled" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock x:Name="MinProcessorStateLabel" Text="鎖定最低 CPU 狀態 100%" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MinProcessorStateDesc" Text="設定 PROCTHROTTLEMIN=100，插電時杜絕降頻，確保遊戲轉場時刻維持極速。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsMinProcessorState100, Mode=OneWay}"
                                                              Toggled="MinProcessorState_Toggled" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Installed Power Plans List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="InstalledPlansTitle" Text="現存電源計畫清單 (Installed Schemes)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedPowerPlan, Mode=TwoWay}"
                                              SelectionMode="Single" MaxHeight="220">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PowerPlanItem">
                                                <Grid Padding="4,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind StatusBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Guid}" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <Button Grid.Column="3" Content="⚡ 套用" Click="SetPlanActive_Click"
                                                            IsEnabled="{x:Bind IsActive, Converter={StaticResource InvertBoolConverter}}"
                                                            Padding="8,2" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- PowerCfg Hibernation & Space Reclamation Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="HibernateCardTitle" Text="⚡ 休眠管理與 SSD 空間瞬間釋放 (PowerCfg Hibernate)" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>

                                    <!-- Switch 1: Hibernate -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="HibernateLabel" Text="Windows 休眠功能 (Hibernate - powercfg -h off/on)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HibernateDesc" Text="關閉休眠將立即刪除 C:\hiberfil.sys，直接為系統磁碟釋放 16GB ~ 64GB 龐大可用空間！" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Bind ViewModel.HiberfilSizeDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsHibernationEnabled, Mode=OneWay}"
                                                      Toggled="Hibernation_Toggled" />
                                    </Grid>

                                    <!-- Switch 2: Fast Startup Reduced -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="FastStartupReducedLabel" Text="快速開機縮減模式 (Fast Startup Reduced Mode)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FastStartupReducedDesc" Text="使用 /type reduced 模式，保留 Windows 快速開機優點，同時休眠檔容量大幅減少 60%。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsFastStartupReduced, Mode=OneWay}"
                                                      Toggled="FastStartupReduced_Toggled" />
                                    </Grid>

                                    <!-- Switch 3: Processor Boost Mode -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="ProcessorBoostLabel" Text="解鎖處理器效能激進提升原則 (Processor Performance Boost Mode)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ProcessorBoostDesc" Text="解鎖 Windows 隱藏的 CPU 激進睿頻策略，可在電源選項進階設定中自由選擇激進/停用/高效能提升。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsProcessorBoostUnhidden, Mode=OneWay}"
                                                      Toggled="ProcessorBoost_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Deep CPU Power Management Panel (EPP, Core Parking, Boost) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="CpuPpmPanelTitle" Text="🎛️ CPU 底層電源管理原則 (EPP / Core Parking / Boost Mode)" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="CpuPpmPanelDesc" Text="直接調節 Windows ACPI 處理器電源管理 GUID，包括能量效能偏好 (EPP)、核心停駐解鎖與激進睿頻。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🎛️ 解鎖全 7 項 CPU 原則" Command="{x:Bind ViewModel.UnhideAllCpuPowerAttributesCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 1. EPP Slider -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="能量效能偏好 (EPP - Energy Performance Preference):" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.CpuEppSliderValue, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="(0 = 最極致效能, 100 = 最極致省電)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind ViewModel.CpuEppSliderValue, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="套用 EPP" Command="{x:Bind ViewModel.ApplyCpuEppCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 2. Core Parking Slider -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="核心停駐最小核心比例 (CPMINCORES):" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.CpuCoreParkingMinPercent, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="% (100% = 全核全開防微卡頓)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="10" Value="{x:Bind ViewModel.CpuCoreParkingMinPercent, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="套用停駐" Command="{x:Bind ViewModel.ApplyCpuCoreParkingCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 3. Boost Mode Selection -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Header="處理器效能激進提升模式 (PERFBOOSTMODE)"
                                                  SelectedIndex="{x:Bind ViewModel.SelectedCpuBoostModeIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="0: 已停用 (Disabled - 降低功耗與溫度)" />
                                            <ComboBoxItem Content="1: 標準啟用 (Enabled - 正常睿頻)" />
                                            <ComboBoxItem Content="2: 極致激進 (Aggressive - 電競極速鎖高頻)" />
                                            <ComboBoxItem Content="3: 節能啟用 (Efficient Enabled)" />
                                            <ComboBoxItem Content="4: 高能效激進 (Efficient Aggressive)" />
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="套用睿頻" Command="{x:Bind ViewModel.ApplyCpuBoostModeCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Wake-Armed Devices Management Card (Individual ToggleSwitch Per Device) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="WakeDevicesTitle" Text="🔌 硬體睡眠喚醒管理器 (Wake-Armed Devices)" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="WakeDevicesDesc" Text="杜絕半夜滑鼠晃動、鍵盤誤碰或網路魔術封包喚醒電腦。每台硬體均設有獨立開關：" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="RefreshWakeDevicesBtn" Grid.Column="2" Content="🔄 重新整理喚醒清單" Command="{x:Bind ViewModel.RefreshWakeDevicesCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoadingWakeDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <ListView ItemsSource="{x:Bind ViewModel.WakeDevices, Mode=OneWay}" SelectionMode="None" MaxHeight="240">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PowerWakeDeviceItem">
                                                <Grid Padding="6,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryIcon}" FontSize="18" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DeviceName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsArmed, Mode=TwoWay}"
                                                                  OffContent="禁止喚醒" OnContent="允許喚醒"
                                                                  Toggled="WakeDevice_Toggled" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- Sleep Blocker & Diagnostics Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE708;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="SleepBlockerTitle" Text="🌙 睡眠阻擋診斷器與能耗健康報告" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="SleepBlockerDesc" Text="檢測阻擋電腦休眠的背景程序 (powercfg /requests) 或產出專業電池健康報告。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="RefreshSleepBlockersBtn" Grid.Column="2" Content="🔍 診斷阻擋程序" Command="{x:Bind ViewModel.RefreshSleepBlockersCommand}"
                                                VerticalAlignment="Center" />
                                        <Button x:Name="BatteryReportBtn" Grid.Column="3" Content="🔋 產生電池健康報告" Command="{x:Bind ViewModel.GenerateBatteryReportCommand}"
                                                VerticalAlignment="Center" />
                                        <Button x:Name="EnergyReportBtn" Grid.Column="4" Content="⚡ 產生能耗診斷報告" Command="{x:Bind ViewModel.GenerateEnergyReportCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Blockers List or Clean State -->
                                    <ListView ItemsSource="{x:Bind ViewModel.SleepBlockers, Mode=OneWay}" SelectionMode="None" MaxHeight="160"
                                              Visibility="{x:Bind ViewModel.HasSleepBlockers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SleepBlockerItem">
                                                <Grid Padding="4,4" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryIcon}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{x:Bind Reason}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 4: 登錄檔備份與還原 (Backup & Restore) ════ -->
                <TabViewItem x:Name="TabBackup" Header="💾 登錄檔備份與還原 (Backup &amp; Restore)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Backup Actions Bar -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="BackupSectionTitle" Text="建立備份與系統還原點" FontWeight="SemiBold" FontSize="15" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBox x:Name="BackupDescBox" Grid.Column="0" Header="備份說明 (Description)"
                                                  Text="{x:Bind ViewModel.ManualBackupDescription, Mode=TwoWay}" PlaceholderText="例如: 遊戲前優化備份" />
                                         <Button x:Name="CreateManualBackupBtn" Grid.Column="1" Content="💾 建立登錄檔備份" Command="{x:Bind ViewModel.CreateManualBackupCommand}"
                                                 Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                         <Button x:Name="CreateRestorePointBtn" Grid.Column="2" Content="🛡️ 建立系統還原點" Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                                 VerticalAlignment="Bottom" />
                                         <Button x:Name="OpenBackupFolderBtn" Grid.Column="3" Content="📂 開啟備份資料夾" Command="{x:Bind ViewModel.OpenBackupFolderCommand}"
                                                 VerticalAlignment="Bottom" />
                                     </Grid>
                                 </StackPanel>
                            </Border>

                            <!-- Backups List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="BackupsListTitle" Text="已建立的登錄檔快照與備份 (.reg)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}"
                                              SelectionMode="Single" MaxHeight="220">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:RegistryBackupItem">
                                                <Grid Padding="4,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Description}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <Button Grid.Column="3" Content="🔄 還原" Click="RestoreBackup_Click" Padding="8,2" FontSize="11" />
                                                    <Button Grid.Column="4" Content="🗑️" Click="DeleteBackup_Click" Padding="6,2" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- System Restore Points List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="RestorePointsListTitle" Text="Windows 系統還原點清單 (System Restore Points)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.RestorePoints, Mode=OneWay}" SelectionMode="None" MaxHeight="180">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SystemRestorePointItem">
                                                <Grid Padding="4,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Summary}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 5: OneDrive 深度管理、修復與徹底卸載 (OneDrive Governance) ════ -->
                <TabViewItem x:Name="TabOneDrive" Header="☁️ OneDrive 深度治理與卸載" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Status Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="40"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="OneDriveStatusTitle" Text="Microsoft OneDrive 系統狀態" FontWeight="Bold" FontSize="16" />
                                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind ViewModel.OneDriveInstalledStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind ViewModel.OneDriveRunningStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OneDriveRedirectStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OneDriveCloudFilesStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OneDriveGhostIconStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OneDrivePolicyStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshOneDriveStatusCommand}"
                                            VerticalAlignment="Center" Padding="12,6" />
                                </Grid>
                            </Border>

                            <!-- Actions Card: Core Repairs & Deep Uninstall -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="OneDrive 網路社群 5 大核心災情修復與深度解除安裝" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="針對微軟 OneDrive 強制綁架桌面/個人資料夾路徑、解除安裝後側邊欄殘留幽靈圖示、同步引擎無限卡死 Processing Changes，提供一鍵安全修復與徹底卸載。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Action 1: Deep Uninstall -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="Crimson" />
                                                    <TextBlock Text="徹底解除安裝 OneDrive (Deep Uninstall)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="強制終止處理程序、執行卸載精靈、清除殘留快取，自動將桌面/文件安全移回本機 %USERPROFILE% 並封鎖自動重裝。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🚀 徹底解除安裝 OneDrive" Command="{x:Bind ViewModel.DeepUninstallOneDriveCommand}"
                                                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 2: Restore User Shell Folders -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="還原桌面與個人資料夾路徑 (Fix Known Folder Move)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="修復被 OneDrive 綁架之 Desktop、Documents、Pictures 路徑，安全遷移檔案回 %USERPROFILE% 原生目錄。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="📁 還原個人資料夾原生路徑" Command="{x:Bind ViewModel.RestoreOneDriveShellFoldersCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 3: Remove Ghost Icon -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="移除檔案總管左側幽靈圖示 (Explorer Ghost Icon)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="清除 CLSID 註冊表中殘留的 OneDrive 導覽樹狀目錄釘選圖示，並重啟檔案總管生效。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🧹 清除檔案總管幽靈圖示" Command="{x:Bind ViewModel.RemoveOneDriveGhostIconCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action 4: Reset Sync Engine -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="重設同步引擎 (Fix Infinite Processing Changes)" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="執行 onedrive.exe /reset 清除損毀之內部同步資料庫與快取，解決 100% CPU 佔用或卡死迴圈。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="🔄 重設同步引擎並重啟" Command="{x:Bind ViewModel.ResetOneDriveSyncEngineCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Policy Block Toggle -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="群組原則永久封鎖 Windows Update 自動重新安裝 (DisableFileSyncNGSC)" FontWeight="SemiBold" />
                                                <TextBlock Text="寫入 HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive，徹底阻止 Windows 更新喚醒 OneDrive。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="切換原則封鎖" Command="{x:Bind ViewModel.ToggleOneDrivePolicyBlockCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 6: OEM 驅動程式清理 (Driver Cleanup - PnPUtil) ════ -->
                <TabViewItem x:Name="TabDrivers" Header="🏎️ OEM 驅動清理 (PnPUtil)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Control Bar Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="PnPUtil OEM 協力廠商驅動程式清理與移除" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="列舉已安裝於 DriverStore 的 oem*.inf 驅動套件，支援強制卸載老舊、重複或孤立的驅動程式。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshDriversCommand}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="☑️ 全選" Click="SelectAllDrivers_Click"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="🗑️ 批次卸載選取項" Command="{x:Bind ViewModel.BatchDeleteSelectedDriversCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoadingDrivers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Drivers ListView Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="已安裝之 OEM 驅動套件清單" FontWeight="SemiBold" />

                                    <ListView ItemsSource="{x:Bind ViewModel.OemDrivers, Mode=OneWay}"
                                              SelectionMode="None" MaxHeight="450">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:OemDriverItem">
                                                <Grid Padding="6,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind SignerName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <Button Grid.Column="3" Content="🗑️ 卸載" Click="DeleteDriverItem_Click"
                                                            VerticalAlignment="Center" Padding="8,4" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>

        <!-- ═══ Bottom Console Output ═══ -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="ConsoleLogTitle" Text="系統最佳化與排程調校終端記錄" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearLogCommand}" Padding="8,2" FontSize="11" />
                </Grid>
                <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="6" Padding="10">
                    <TextBlock Text="{x:Bind ViewModel.ConsoleLog, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
