                                        <Button x:Name="UnlockUltimateBtn" Content="⚡ 解鎖並啟用「終極效能 (Ultimate Performance)」"
                                                Command="{x:Bind ViewModel.UnlockUltimatePerformanceCommand}"
                                                Style="{StaticResource AccentButtonStyle}" />
