                                                Command="{x:Bind ViewModel.UnlockHighPerformanceCommand}" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock x:Name="CoreUnparkingLabel" Text="CPU 核心防休眠 (Core Unparking)" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CoreUnparkingDesc" Text="設定 CPMINCORES=100，讓所有核心隨時處於啟用狀態，消除動態喚醒微卡頓。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsCoreUnparked, Mode=OneWay}"
                                                              Toggled="CoreUnparking_Toggled" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock x:Name="MinProcessorStateLabel" Text="鎖定最低 CPU 狀態 100%" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MinProcessorStateDesc" Text="設定 PROCTHROTTLEMIN=100，插電時杜絕降頻，確保遊戲轉場時刻維持極速。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsMinProcessorState100, Mode=OneWay}"
                                                              Toggled="MinProcessorState_Toggled" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Installed Power Plans List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="InstalledPlansTitle" Text="現存電源計畫清單 (Installed Schemes)" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedPowerPlan, Mode=TwoWay}"
                                              SelectionMode="Single" MaxHeight="220"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PowerPlanItem">
                                                <Grid Padding="4,6" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind StatusBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Guid}" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <Button Grid.Column="3" Content="⚡ 套用" Click="SetPlanActive_Click"
                                                            IsEnabled="{x:Bind IsActive, Converter={StaticResource InvertBoolConverter}}"
                                                            Padding="8,2" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- PowerCfg Hibernation & Space Reclamation Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="HibernateCardTitle" Text="⚡ 休眠管理與 SSD 空間瞬間釋放 (PowerCfg Hibernate)" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>

                                    <!-- Switch 1: Hibernate -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="HibernateLabel" Text="Windows 休眠功能 (Hibernate - powercfg -h off/on)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HibernateDesc" Text="關閉休眠將立即刪除 C:\hiberfil.sys，直接為系統磁碟釋放 16GB ~ 64GB 龐大可用空間！" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Bind ViewModel.HiberfilSizeDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsHibernationEnabled, Mode=OneWay}"
                                                      Toggled="Hibernation_Toggled" />
                                    </Grid>

                                    <!-- Switch 2: Fast Startup Reduced -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="FastStartupReducedLabel" Text="快速開機縮減模式 (Fast Startup Reduced Mode)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FastStartupReducedDesc" Text="使用 /type reduced 模式，保留 Windows 快速開機優點，同時休眠檔容量大幅減少 60%。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsFastStartupReduced, Mode=OneWay}"
                                                      Toggled="FastStartupReduced_Toggled" />
                                    </Grid>

                                    <!-- Switch 3: Processor Boost Mode -->
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="ProcessorBoostLabel" Text="解鎖處理器效能激進提升原則 (Processor Performance Boost Mode)" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ProcessorBoostDesc" Text="解鎖 Windows 隱藏的 CPU 激進睿頻策略，可在電源選項進階設定中自由選擇激進/停用/高效能提升。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsProcessorBoostUnhidden, Mode=OneWay}"
                                                      Toggled="ProcessorBoost_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Deep CPU Power Management Panel (EPP, Core Parking, Boost) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="CpuPpmPanelTitle" Text="🎛️ CPU 底層電源管理原則 (EPP / Core Parking / Boost Mode)" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="CpuPpmPanelDesc" Text="直接調節 Windows ACPI 處理器電源管理 GUID，包括能量效能偏好 (EPP)、核心停駐解鎖與激進睿頻。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🎛️ 解鎖全 7 項 CPU 原則" Command="{x:Bind ViewModel.UnhideAllCpuPowerAttributesCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 1. EPP Slider -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="能量效能偏好 (EPP - Energy Performance Preference):" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.CpuEppSliderValue, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="(0 = 最極致效能, 100 = 最極致省電)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind ViewModel.CpuEppSliderValue, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="套用 EPP" Command="{x:Bind ViewModel.ApplyCpuEppCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 2. Core Parking Slider -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="核心停駐最小核心比例 (CPMINCORES):" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.CpuCoreParkingMinPercent, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="% (100% = 全核全開防微卡頓)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="10" Value="{x:Bind ViewModel.CpuCoreParkingMinPercent, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="套用停駐" Command="{x:Bind ViewModel.ApplyCpuCoreParkingCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 3. Boost Mode Selection -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Header="處理器效能激進提升模式 (PERFBOOSTMODE)"
                                                  SelectedIndex="{x:Bind ViewModel.SelectedCpuBoostModeIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="0: 已停用 (Disabled - 降低功耗與溫度)" />
                                            <ComboBoxItem Content="1: 標準啟用 (Enabled - 正常睿頻)" />
                                            <ComboBoxItem Content="2: 極致激進 (Aggressive - 電競極速鎖高頻)" />
                                            <ComboBoxItem Content="3: 節能啟用 (Efficient Enabled)" />
                                            <ComboBoxItem Content="4: 高能效激進 (Efficient Aggressive)" />
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="套用睿頻" Command="{x:Bind ViewModel.ApplyCpuBoostModeCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Wake-Armed Devices Management Card (Individual ToggleSwitch Per Device) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="WakeDevicesTitle" Text="🔌 硬體睡眠喚醒管理器 (Wake-Armed Devices)" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="WakeDevicesDesc" Text="杜絕半夜滑鼠晃動、鍵盤誤碰或網路魔術封包喚醒電腦。每台硬體均設有獨立開關：" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="RefreshWakeDevicesBtn" Grid.Column="2" Content="🔄 重新整理喚醒清單" Command="{x:Bind ViewModel.RefreshWakeDevicesCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoadingWakeDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <ListView ItemsSource="{x:Bind ViewModel.WakeDevices, Mode=OneWay}" SelectionMode="None" MaxHeight="240"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PowerWakeDeviceItem">
                                                <Grid Padding="6,6" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryIcon}" FontSize="18" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DeviceName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsArmed, Mode=TwoWay}"
                                                                  OffContent="禁止喚醒" OnContent="允許喚醒"
                                                                  Toggled="WakeDevice_Toggled" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- Sleep Blocker & Diagnostics Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE708;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="SleepBlockerTitle" Text="🌙 睡眠阻擋診斷器與能耗健康報告" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="SleepBlockerDesc" Text="檢測阻擋電腦休眠的背景程序 (powercfg /requests) 或產出專業電池健康報告。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="RefreshSleepBlockersBtn" Grid.Column="2" Content="🔍 診斷阻擋程序" Command="{x:Bind ViewModel.RefreshSleepBlockersCommand}"
                                                VerticalAlignment="Center" />
                                        <Button x:Name="BatteryReportBtn" Grid.Column="3" Content="🔋 產生電池健康報告" Command="{x:Bind ViewModel.GenerateBatteryReportCommand}"
                                                VerticalAlignment="Center" />
                                        <Button x:Name="EnergyReportBtn" Grid.Column="4" Content="⚡ 產生能耗診斷報告" Command="{x:Bind ViewModel.GenerateEnergyReportCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 1. Progress Indicator -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                                Visibility="{x:Bind ViewModel.IsLoadingSleepBlockers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingSleepBlockers, Mode=OneWay}" Width="16" Height="16" />
                                        <TextBlock Text="正在執行 powercfg /requests 深入掃描系統背景待命與休眠阻擋..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 2. Clean State (When 0 Blockers found) -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,6,0,0"
                                            Visibility="{x:Bind ViewModel.HasSleepBlockers, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="經診斷，目前系統沒有任何背景程序或驅動程式阻擋電腦休眠 (系統處於最佳待命狀態)"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Blockers List (When Blockers detected) -->
                                    <ListView ItemsSource="{x:Bind ViewModel.SleepBlockers, Mode=OneWay}" SelectionMode="None" MaxHeight="160"
                                              Visibility="{x:Bind ViewModel.HasSleepBlockers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SleepBlockerItem">
                                                <Grid Padding="4,4" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryIcon}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{x:Bind Reason}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 3.5: 檔案總管、右鍵選單與圖示自訂 (Explorer, Context Menu & Icons) ════ -->
                <TabViewItem x:Name="TabExplorerShell" Header="🗂️ 檔案總管與圖示 (Explorer &amp; Icons)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Card 1 (Item 14 & Item 13): Explorer.exe Auto-Recovery Watchdog & Icon Cache Reset -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xEC50;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="WatchdogCardTitle" Text="🛡️ Explorer.exe 檔案總管背景自動守護與救援服務" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.ExplorerWatchdogStatusBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="WatchdogCardDesc" Text="當 Windows 檔案總管 (explorer.exe) 因外掛衝突崩潰、無回應或被意外終止導致黑畫面與工作列消失時，背景守護服務將自動偵測並秒速重啟恢復桌面。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.ExplorerWatchdogRecoverySummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🔄 手動重啟總管" Command="{x:Bind ViewModel.RestartExplorerManuallyCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="手動重啟檔案總管 (explorer.exe)" />
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind ViewModel.IsExplorerWatchdogEnabled, Mode=OneWay}"
                                                      OnContent="自動救援開啟" OffContent="已暫停"
                                                      Toggled="ExplorerWatchdog_Toggled" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="🖼️ 重設與重建檔案總管圖示快取 (Reset Icon &amp; Thumbnail Cache)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="修復桌面白紙圖示、破圖或自訂圖示未更新。提供「免重啟即時刷新 (ie4uinit -show)」與「徹底清除 IconCache.db 重建」雙模式。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.IconCacheStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                           Visibility="{x:Bind ViewModel.IconCacheStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="⚡ 免重啟刷新" Command="{x:Bind ViewModel.QuickRefreshShellIconsCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="免重啟即時刷新圖示 (ie4uinit -show)" />
