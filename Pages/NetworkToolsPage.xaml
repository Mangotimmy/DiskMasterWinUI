                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- NetShare header and actions -->
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
