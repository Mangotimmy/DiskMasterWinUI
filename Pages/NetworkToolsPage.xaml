                                            </Button>
                                            <Button Command="{x:Bind ViewModel.OpenInSystemNotepadCommand}" Style="{StaticResource AccentButtonStyle}"
                                                    MinWidth="0" Padding="9,6"
                                                    ToolTipService.ToolTip="在微軟記事本程式中開啟" AutomationProperties.Name="在微軟記事本程式中開啟">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--
                                    ══ Rendering decision for this editor (editable multi-line text) ══
                                    Win2D (Microsoft.Graphics.Win2D): a custom-draw canvas. Rendering an editable document
                                      with it means re-implementing caret, selection, mouse hit-testing, IME composition,
                                      clipboard, undo and accessibility (UIA) by hand; also the package is not present in this
                                      machine's offline NuGet cache, so it must not become a dependency.
                                    SwapChainPanel: meant for 3D / custom-shader swap chains. It provides no text layout,
                                      no caret and no accessibility at all.
                                    Microsoft.UI.Composition: in-box API (no package). Correct only for overlays and
                                      decorations that do not own the text, e.g. a line-number gutter, minimap or animated
                                      scroll indicator, because their animation runs on the compositor thread.
                                    Decision here: keep the in-box TextBox as the single editable control (WinUI's text stack
                                      already provides caret, selection, IME, clipboard, undo and UIA) and make the XAML path
                                      cheap instead: no per-keystroke document read, no re-parse, no round-trip of the whole
                                      document back into the control, NoWrap + monospace + spell-check off so the layout engine
                                      never reflows a line. Parsing, line counting and the health audit are debounced and run on
                                      a background thread. A future gutter/minimap should be a sibling overlay driven by the
                                      debounced line index, not a replacement for the TextBox.
                                -->
                                <TextBox x:Name="HostsEditorTextBox" Grid.Row="1"
                                         FontSize="{x:Bind ViewModel.EditorFontSize, Mode=OneWay}"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         IsSpellCheckEnabled="False"
                                         IsTextPredictionEnabled="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollMode="Enabled"
                                         ScrollViewer.HorizontalScrollMode="Enabled"
                                         ScrollViewer.IsScrollInertiaEnabled="True"
                                         SelectionChanged="HostsTextBox_SelectionChanged"
                                         TextChanged="HostsTextBox_TextChanged"
                                         FontFamily="Consolas"
                                         BorderThickness="0" Background="Transparent"
                                         AutomationProperties.Name="Hosts 檔案內容編輯器"
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="300" Padding="12" />
                            </Grid>
                        </Border>

