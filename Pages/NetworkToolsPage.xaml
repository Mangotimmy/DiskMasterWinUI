<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.NetworkToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:services="using:DiskMasterWinUI.Services"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.LoadInitialDataCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock x:Name="RefreshNetBtnText" Text="重新整理網路狀態" />
                    </StackPanel>
                </Button>
                <Button Click="OpenSmartDiagDialog_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEC06;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="🧠 智慧網路診斷精靈" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- Movable Sub TabView -->
        <TabView x:Name="NetTabView" Grid.Row="1"
                 CanReorderTabs="True" CanDragTabs="True"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>

                <!-- ════ Tab 1: UPnP 自動通訊埠轉發 ════ -->
                <TabViewItem x:Name="TabUpnp" Header="🔀 UPnP 自動通訊埠轉發" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Status & Quick Presets -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE968;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="UpnpTitleText" Text="UPnP NAT-T / IGD 路由器自動通訊埠轉發" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{x:Bind ViewModel.LocalIpAddress, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='本機區域網路 IP: {0}'}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🔄 探索路由器" Command="{x:Bind ViewModel.RefreshUpnpCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Quick Game Presets Buttons (Responsive 2x3 Grid) -->
                                    <TextBlock Text="熱門遊戲與伺服器範本快速載入：" FontWeight="SemiBold" FontSize="13" />
                                    <Grid ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="⛏️ Minecraft (25565)" Click="PresetMinecraft_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="🎮 Steam CS2 (27015)" Click="PresetSteam_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="🌳 Terraria (7777)" Click="PresetTerraria_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="1" Grid.Column="0" Content="🐺 Palworld (8211)" Click="PresetPalworld_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="🖥️ Windows 遠端桌面 (3389)" Click="PresetRdp_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="🎬 Plex 串流 (32400)" Click="PresetPlex_Click" HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <!-- Manual Add Rule Form -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="外部通訊埠 (WAN Port)" Text="{x:Bind ViewModel.NewExternalPort, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="內部通訊埠 (LAN Port)" Text="{x:Bind ViewModel.NewInternalPort, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="2" Header="協定" SelectedValue="{x:Bind ViewModel.NewProtocol, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="TCP" />
                                                <ComboBoxItem Content="UDP" />
                                            </ComboBox>
                                            <TextBox Grid.Column="3" Header="規則備註 (Description)" Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}" />
                                            <Button Grid.Column="4" Content="➕ 新增轉發規則" Command="{x:Bind ViewModel.AddPortMappingCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Mappings List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="路由器現存 UPnP 轉發清單" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PortMappings, Mode=OneWay}" SelectionMode="None" MaxHeight="300">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:UpnpPortMappingItem">
                                                <Grid Padding="4,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Protocol}" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind ExternalPort, Converter={StaticResource StringFormatConverter}, ConverterParameter='外部埠: {0}'}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind InternalClient}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <Button Grid.Column="3" Content="🗑️ 刪除" Click="DeletePortMapping_Click"
                                                            Padding="8,2" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 2: 推薦 DNS 設定與快取清理 ════ -->
                <TabViewItem x:Name="TabDns" Header="🌐 推薦 DNS 設定" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- DNS Presets Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="DnsTitleText" Text="推薦公用 DNS 伺服器一鍵切換" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="選擇適合您的極速、無廣告或資安防護 DNS，點擊直接套用至目前主要使用中之網卡。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🧹 清除 DNS 快取" Command="{x:Bind ViewModel.FlushDnsCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Network Adapter Selector & Ping Toolbar -->
                                    <Grid ColumnSpacing="12" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="260" MaxWidth="500" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎯 目標網卡:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.NetworkAdapters, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
                                        <Button Grid.Column="2" Content="🔄 重新整理網卡" Command="{x:Bind ViewModel.RefreshNetworkAdaptersCommand}" />
                                        <Button Grid.Column="3" Content="⚡ 測試全網 DNS 延遲 (Ping)" Command="{x:Bind ViewModel.TestDnsPingCommand}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.DnsPingSummary, Mode=OneWay}"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>

                                    <!-- DNS Presets Grid -->
                                    <GridView ItemsSource="{x:Bind ViewModel.DnsPresets, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedDnsPreset, Mode=TwoWay}"
                                              SelectionMode="Single">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="services:DnsPreset">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Width="300" Height="110">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="Bold" />
                                                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{x:Bind PingBadge, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" />
                                                            </Border>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind PrimaryDns, Converter={StaticResource StringFormatConverter}, ConverterParameter='主要: {0}'}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                            <TextBlock Grid.Column="1" Text="🏆 最速推薦" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                       Visibility="{x:Bind IsFastest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="⚡ 一鍵套用所選 DNS" Command="{x:Bind ViewModel.ApplySelectedDnsCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Padding="16,8" />
                                        <Button Content="🏆 一鍵套用最快 DNS" Command="{x:Bind ViewModel.ApplyFastestDnsCommand}"
                                                Padding="16,8" />
                                        <Button Content="🔄 還原為自動 (DHCP)" Command="{x:Bind ViewModel.ResetDnsToDhcpCommand}"
                                                Padding="16,8" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Custom DNS Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="手動輸入自訂 DNS 伺服器" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="慣用 DNS (Preferred DNS)" Text="{x:Bind ViewModel.CustomPrimaryDns, Mode=TwoWay}" PlaceholderText="例如: 1.1.1.1" />
                                        <TextBox Grid.Column="1" Header="其他 DNS (Alternate DNS)" Text="{x:Bind ViewModel.CustomSecondaryDns, Mode=TwoWay}" PlaceholderText="例如: 1.0.0.1" />
                                        <Button Grid.Column="2" Content="套用自訂 DNS" Command="{x:Bind ViewModel.ApplyCustomDnsCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DNS Pollution & Tampering Detection Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="🛡️ DNS 污染 / 投毒檢測與 DoH 加密防護" FontWeight="Bold" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock Text="發送雙軌比對（本機 UDP 53 vs Cloudflare/Google DoH 安全解析），檢測 ISP / 偽造 Bogon 假 IP 投毒，並提供 Windows 原生 DoH 一鍵加密配置。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="測試網域 (可自訂)" Text="{x:Bind ViewModel.TestPollutionDomain, Mode=TwoWay}" PlaceholderText="例如 github.com 或 wikipedia.org" />
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.TestPollutionCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                                                <TextBlock Text="檢測污染" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.ConfigureWindowsDoHCommand}" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                                <TextBlock Text="⚡ 配置原生 DoH (1.1.1.1)" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Pollution Test Results List -->
                                    <ListView ItemsSource="{x:Bind ViewModel.PollutionResults, Mode=OneWay}" MaxHeight="220" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DnsPollutionItem">
                                                <Grid Padding="6,8" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Domain}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Details}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 3: 為什麼網路慢？智慧診斷 ════ -->
                <TabViewItem x:Name="TabDiagnostic" Header="🩺 智慧連線卡頓診斷" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Hero Diagnostic Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="18">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE95A;" FontSize="40" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="智慧 5 階段連線延遲與瓶頸自動探測" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="{x:Bind ViewModel.DiagnosticSummary, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🩺 開始智慧診斷" Command="{x:Bind ViewModel.RunSmartDiagnosticsCommand}"
                                            Style="{StaticResource AccentButtonStyle}" Padding="16,8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Results List -->
                            <ListView ItemsSource="{x:Bind ViewModel.DiagnosticResults, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:DiagnosticStepResult">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,4,0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="20"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Recommendation}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{x:Bind LatencyDisplay}"
                                                           FontWeight="Bold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 4: Windows Hosts 檔案視覺化編輯器 ════ -->
                <TabViewItem x:Name="TabHosts" Header="📝 Hosts 檔案編輯器" IsClosable="False">
                    <Grid RowSpacing="12" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Control Card -->
                        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Windows 本機網域名稱解析 (C:\Windows\System32\drivers\etc\hosts)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshHostsCommand}" />
                                    <Button Grid.Column="2" Content="🛡️ 還原官方預設" Command="{x:Bind ViewModel.RestoreDefaultHostsCommand}" />
                                    <Button Grid.Column="3" Content="💾 儲存 Hosts" Command="{x:Bind ViewModel.SaveRawHostsCommand}" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>

                                <!-- Quick Add Form -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="IP 位址" Text="{x:Bind ViewModel.NewHostIp, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="網域名稱 (Domain Name)" Text="{x:Bind ViewModel.NewHostDomain, Mode=TwoWay}" PlaceholderText="例如: telemetry.microsoft.com" />
                                    <TextBox Grid.Column="2" Header="備註說明" Text="{x:Bind ViewModel.NewHostComment, Mode=TwoWay}" PlaceholderText="可留空" />
                                    <Button Grid.Column="3" Content="➕ 加入條目" Command="{x:Bind ViewModel.AddHostEntryCommand}" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Raw Editor Box with Always-Visible Vertical ScrollBar and Flexible Height -->
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12">
                            <TextBox Text="{x:Bind ViewModel.RawHostsText, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollMode="Enabled"
                                     ScrollViewer.HorizontalScrollMode="Enabled"
                                     FontFamily="Consolas" FontSize="13"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="320" />
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- ════ Tab 5: 網路共用精靈 (One-Click NetShare Wizard) ════ -->
                <TabViewItem x:Name="TabNetShare" Header="🖧 網路共用精靈 (NetShare)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" Margin="0,0,16,20">

                            <!-- Hero MS Account & Profile Fix Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="🛠️ 微軟帳號區域網路共用驗證問題一鍵修復 (MS Account LAN Sharing Fix)" FontWeight="Bold" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock Text="當本機登入微軟帳號時，區域網路其他電腦連線常遭遇 NTLM 身分驗證失敗或存取拒絕。此精靈自動修正 LocalAccountTokenFilterPolicy 政策、開啟防火牆規則與私人網路設定檔。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{x:Bind ViewModel.FixMsAccountPolicyCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                                <TextBlock Text="⚡ 修復微軟帳號權限政策" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SetPrivateNetworkCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B0;" FontSize="13" />
                                                <TextBlock Text="🔒 設為私人網路設定檔" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.EnableSharingFirewallCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                                <TextBlock Text="🔥 開啟檔案共用防火牆" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Create New Share Form -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="➕ 建立新的網路共用資料夾" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="共用名稱 (Share Name)" Text="{x:Bind ViewModel.NewShareName, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="資料夾實體路徑 (Folder Path)" Text="{x:Bind ViewModel.NewSharePath, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Header="備註說明 (Remark)" Text="{x:Bind ViewModel.NewShareRemark, Mode=TwoWay}" />
                                        <Button Grid.Column="3" Content="🚀 一鍵建立共用" Command="{x:Bind ViewModel.CreateShareCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Dedicated Local Sharing User Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="👤 建立區域網路專用連線帳號 (供手機/Mac/電視盒免微軟帳號直接連線)" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="本機帳號名稱" Text="{x:Bind ViewModel.DedicatedUserName, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="帳號密碼" Text="{x:Bind ViewModel.DedicatedUserPassword, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="👤 建立共用專用帳號" Command="{x:Bind ViewModel.CreateDedicatedUserCommand}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Existing Active Shares List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📋 現有區域網路共用資源清單" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshSharesCommand}" />
                                    </Grid>

                                    <ListView ItemsSource="{x:Bind ViewModel.NetShares, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:NetShareItem">
                                                <Grid Padding="8,8" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ShareName}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind ResourcePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind UncIpPath}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Text="{x:Bind UncHostPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Remark}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Content="🗑️ 刪除共用" Click="DeleteShare_Click" Padding="8,4" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 6: 遠端桌面服務 (Remote RDP Server) ════ -->
                <TabViewItem x:Name="TabRdp" Header="🖥️ 遠端桌面 (RDP Server)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" Margin="0,0,16,20">

                            <!-- Status & Unlock Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="Windows 遠端桌面伺服器 (RDP Server)" FontWeight="Bold" FontSize="16" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.RdpStatus.EditionName, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='目前系統版本: {0}'}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔄 檢查狀態" Command="{x:Bind ViewModel.RefreshRdpStatusCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{x:Bind ViewModel.EnableRdpCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                <TextBlock Text="⚡ 一鍵啟用遠端桌面 (3389)" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.DisableRdpCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE71A;" FontSize="13" />
                                                <TextBlock Text="🛑 停用遠端桌面" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.LaunchRdpLoopbackCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                                                <TextBlock Text="🖥️ 本機連線測試 (mstsc)" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Connection Info -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="連線位址指引：" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.RdpStatus.ConnectAddressIp, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='區域網路 IP 連線位址: {0}'}" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.RdpStatus.ConnectAddressHost, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='電腦主機名稱連線位址: {0}'}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Active Sessions List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="👥 當前遠端工作階段 (qwinsta)" FontWeight="Bold" FontSize="14" />
                                    <ListView ItemsSource="{x:Bind ViewModel.RdpSessions, Mode=OneWay}" MaxHeight="200" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:RdpSessionItem">
                                                <Grid Padding="6,6" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind SessionName}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind UserName}" FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind State}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 7: CMD 網路工具箱 (Ping, Netstat, OpenFiles, Nbtstat) ════ -->
                <TabViewItem x:Name="TabCliTools" Header="⚡ CMD 網路工具箱" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="16" Margin="0,0,16,20">

                            <!-- Ping & MTU Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🌐 Ping 延遲探測與最佳路徑 MTU 自動發現 (Path MTU Discovery)" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="目標主機或 IP" Text="{x:Bind ViewModel.PingOptions.TargetHost, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="封包數 (-n)" Text="{x:Bind ViewModel.PingOptions.Count, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Header="緩衝區大小 (-l)" Text="{x:Bind ViewModel.PingOptions.BufferSize, Mode=TwoWay}" />
                                        <Button Grid.Column="3" Content="🚀 開始 Ping" Command="{x:Bind ViewModel.RunPingCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                        <Button Grid.Column="4" Content="🔍 探測 MTU" Command="{x:Bind ViewModel.DetectMtuCommand}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>

                                    <!-- Log Output -->
                                    <TextBox Text="{x:Bind ViewModel.PingOutputLog, Mode=OneWay}" Height="140"
                                             AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <!-- Netstat Port Hunter Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🎯 通訊埠佔用獵手 (Netstat Port Hunter &amp; 1-Click Process Terminator)" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="篩選端口 (例如 80, 443, 8080)" Text="{x:Bind ViewModel.FilterPort, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Content="🔍 查詢通訊埠佔用" Command="{x:Bind ViewModel.RefreshNetstatCommand}" VerticalAlignment="Bottom" Padding="14,8" />
                                        <Button Grid.Column="2" Content="⚡ 一鍵終結佔用此端口程式" Command="{x:Bind ViewModel.KillPortOccupantCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>

                                    <ListView ItemsSource="{x:Bind ViewModel.NetstatConnections, Mode=OneWay}" MaxHeight="220" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:NetstatConnectionItem">
                                                <Grid Padding="4,6" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind LocalAddress}" FontSize="11" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ForeignAddress}" FontSize="11" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind State}" FontSize="11" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Pid}" FontSize="11" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind ProcessName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- OpenFiles and Nbtstat Card -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- OpenFiles -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📂 共享檔案遠端鎖定 (OpenFiles)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="🔄 查詢" Command="{x:Bind ViewModel.RefreshOpenFilesCommand}" Padding="8,4" FontSize="11" />
                                        </Grid>
                                        <ListView ItemsSource="{x:Bind ViewModel.OpenFiles, Mode=OneWay}" MaxHeight="160" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:OpenSharedFileItem">
                                                    <Grid Padding="2,4" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind OpenPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1" Content="🔓 解鎖" Click="DisconnectOpenFile_Click" Padding="6,2" FontSize="10" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <!-- Nbtstat -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="🔄 NetBIOS 快取與名稱釋放 (Nbtstat)" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="當區網電腦更改 IP 或在網路芳鄰中失聯時，強制清除並重整 NetBIOS 快取 (-R &amp; -RR)。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="⚡ 一鍵清除並重載 NetBIOS 快取" Command="{x:Bind ViewModel.FlushNetBiosCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,6" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
