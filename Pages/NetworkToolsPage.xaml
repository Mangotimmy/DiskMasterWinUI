                                                        <TextBlock Grid.Column="2" Text="{x:Bind UncHostPath}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind AccessSummary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind CachingMode}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Share details" FontWeight="Bold" FontSize="14" />
                                            <StackPanel Visibility="{x:Bind ViewModel.HasSelectedShare, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.ShareName, Mode=OneWay}" FontWeight="SemiBold" FontSize="17" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.ResourcePath, Mode=OneWay}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="Network paths" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.UncIpPath, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.UncHostPath, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Permissions" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" />
                                                <ListView ItemsSource="{x:Bind ViewModel.SelectedShareAcl, Mode=OneWay}" SelectionMode="None" MaxHeight="150">
                                                    <ListView.Header>
                                                        <Grid Padding="6,3" ColumnSpacing="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Account" FontWeight="SemiBold" FontSize="10" />
                                                            <TextBlock Grid.Column="1" Text="Access" FontWeight="SemiBold" FontSize="10" />
                                                        </Grid>
                                                    </ListView.Header>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ShareAclItem">
                                                            <Grid Padding="6,3" ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="100" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind Principal}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind AccessRight}" FontSize="11" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock Text="Advanced" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.CachingMode, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Offline: {0}'}" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.ConcurrentUserLimit, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Simultaneous users: {0} (0 = unlimited)'}" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.EncryptData, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Encrypt data: {0}'}" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNetShare.FolderEnumerationMode, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Enumeration: {0}'}" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.SharePermissionSummary, Mode=OneWay}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                                    <Button Content="Manage access and options" Click="ManageShare_Click" Style="{StaticResource AccentButtonStyle}" />
                                                    <Button Content="Delete share" Click="DeleteSelectedShare_Click" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.NetShareStatusMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Select a share to view permissions and advanced options."
                                                       TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind ViewModel.HasSelectedShare, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 6: 遠端桌面服務 (Remote RDP Server & RDP Wrapper) ════ -->
                <TabViewItem x:Name="TabRdp" Header="🖥️ 遠端桌面 (RDP Server)" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Status & Diagnostics Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <!-- Title & Actions Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="Windows 遠端桌面伺服器 (RDP Server) &amp; RDP Wrapper 增強診斷" FontWeight="Bold" FontSize="16" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.RdpStatus.EditionName, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='目前系統版本: {0}'}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.RestartTermServiceCommand}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="🔄 重啟 TermService" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Content="🔍 重新檢查狀態" Command="{x:Bind ViewModel.RefreshRdpStatusCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 4 Diagnostic Badges / Cards -->
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge 1: TermService Status -->
                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="TermService 服務狀態" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsServiceRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsServiceRunning, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    <TextBlock Text="服務運作中 (Running)" FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsServiceRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="已停止 / 停用 (Stopped)" FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsServiceRunning, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Badge 2: Listener Status -->
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="通訊埠監聽狀態" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B0;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsListening, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsListening, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind ViewModel.RdpStatus.Port, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='監聽中: 0.0.0.0:{0}'}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsListening, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind ViewModel.RdpStatus.Port, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='未在埠 {0} 監聽'}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsListening, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Badge 3: termsrv.dll Core Version -->
                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="termsrv.dll 核心版本" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.RdpStatus.TermsrvVersion, Mode=OneWay}"
                                                               FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Badge 4: RDP Wrapper Status -->
                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="RDP Wrapper 模組" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsWrapperInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Visibility="{x:Bind ViewModel.RdpStatus.IsWrapperInstalled, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind ViewModel.RdpStatus.WrapperVersion, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='已載入: {0}'}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsWrapperInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="未載入 (原生模式)" FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{x:Bind ViewModel.RdpStatus.IsWrapperInstalled, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Main Action Buttons -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{x:Bind ViewModel.EnableRdpCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                <TextBlock Text="{x:Bind ViewModel.RdpEnableButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.DisableRdpCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE71A;" FontSize="13" />
                                                <TextBlock Text="🛑 停用遠端桌面" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.LaunchRdpLoopbackCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                                                <TextBlock Text="{x:Bind ViewModel.RdpStatus.Port, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='🖥️ 本機連線測試 (mstsc :{0})'}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Feedback Status Message -->
                                    <TextBlock Text="{x:Bind ViewModel.RdpStatusMessage, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               Visibility="{x:Bind ViewModel.RdpStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Port Configuration & Connection Guide Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B0;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="📡 通訊埠設定與連線位址指引 (Port &amp; Connection Guide)" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>

                                    <!-- Connection Info Banner -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="區域網路 IP 連線指令 (其他電腦或手機使用)：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.RdpStatus.ConnectAddressIp, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='mstsc /v:{0}'}"
                                                           FontFamily="Consolas" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="電腦主機名稱連線指令：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.RdpStatus.ConnectAddressHost, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='mstsc /v:{0}'}"
                                                           FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Port Customization Form -->
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Header="RDP 服務通訊埠 (PortNumber)"
                                                 Text="{x:Bind ViewModel.CustomRdpPort, Mode=TwoWay}"
                                                 PlaceholderText="例如 3387 或 3389" />

                                        <!-- Quick Presets -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                                            <TextBlock Text="常用通訊埠快速選取：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="預設 3389" Command="{x:Bind ViewModel.SetPortPresetCommand}" CommandParameter="3389" Padding="8,4" FontSize="11" />
                                                <Button Content="本機 3387" Command="{x:Bind ViewModel.SetPortPresetCommand}" CommandParameter="3387" Padding="8,4" FontSize="11" />
                                                <Button Content="備用 8389" Command="{x:Bind ViewModel.SetPortPresetCommand}" CommandParameter="8389" Padding="8,4" FontSize="11" />
                                                <Button Content="高位 33890" Command="{x:Bind ViewModel.SetPortPresetCommand}" CommandParameter="33890" Padding="8,4" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="💾 套用新通訊埠" Command="{x:Bind ViewModel.ApplyCustomPortCommand}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>
                                    <TextBlock Text="💡 提示: 套用新通訊埠將自動修改登錄檔 PortNumber、增建 Windows 防火牆 TCP/UDP 放行規則，並重啟 TermService。"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Advanced RDP Wrapper & Multi-Session Policies Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="⚙️ RDP Wrapper 架構多工作階段與安全政策 (Multi-Session &amp; Security)" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Text="依據 stascorp/rdpwrap 核心功能，管理 Windows 終端機服務多連線並存、網路層身分驗證 (NLA) 與遠端陰影監視模式。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Setting 1: Concurrent Sessions (fSingleSessionPerUser) -->
                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="👥 多人同帳號連線政策" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="是否限制每位使用者僅能單一連線 (開起會踢掉先前連線，關閉可多視窗並存)"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Height="32" />
                                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsSingleSessionPerUser, Mode=TwoWay}"
                                                              OnContent="僅限單一連線 (踢舊連線)"
                                                              OffContent="允許多人/多視窗並存" />
                                                <Button Content="套用多連線政策" Command="{x:Bind ViewModel.ToggleSingleSessionCommand}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Setting 2: Network Level Authentication (NLA) -->
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="🔒 網路層身分驗證 (NLA)" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="強制連線前進行網路層使用者身分驗證 (關閉時相容性最佳，未勾選 NLA 的裝置也能連)"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Height="32" />
                                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsNlaRequired, Mode=TwoWay}"
                                                              OnContent="強制 NLA 驗證 (高安全性)"
                                                              OffContent="不強制 NLA (相容性最佳)" />
                                                <Button Content="套用 NLA 設定" Command="{x:Bind ViewModel.ToggleNlaCommand}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Setting 3: Shadow Mode -->
                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="👁️ 遠端陰影監視模式" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="設定管理者是否能即時查看或接管被控端工作階段 (Shadowing Mode)"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Height="32" />
                                                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedShadowMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="0: 停用陰影 (Disable)" />
                                                    <ComboBoxItem Content="1: 完整控制 (需使用者同意)" />
                                                    <ComboBoxItem Content="2: 完整控制 (無需同意)" />
                                                    <ComboBoxItem Content="3: 僅檢視 (需使用者同意)" />
                                                    <ComboBoxItem Content="4: 僅檢視 (無需同意)" />
                                                </ComboBox>
                                                <Button Content="套用陰影模式" Command="{x:Bind ViewModel.ApplyShadowModeCommand}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Community INI Auto-Updater Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="🌐 社群 rdpwrap.ini 偏移量設定庫同步更新 (Windows 11 / 10 支援檔)" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="當 Windows 累積更新升級 termsrv.dll 導致 RDP Wrapper 提示 Not Supported 時，可一鍵從 GitHub / jsDelivr CDN 自動下載最新社群偏移量資料庫並重新載入服務。"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{x:Bind ViewModel.UpdateRdpWrapIniCommand}" VerticalAlignment="Center" Padding="12,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsUpdatingRdpIni, Mode=OneWay}" Width="16" Height="16" />
                                                    <TextBlock Text="📥 線上更新 rdpwrap.ini" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Active Sessions List -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👥 當前遠端工作階段管理 (qwinsta / rwinsta)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="🔄 重新整理清單" Command="{x:Bind ViewModel.RefreshRdpStatusCommand}" Padding="8,4" FontSize="11" />
                                    </Grid>

                                    <ListView ItemsSource="{x:Bind ViewModel.RdpSessions, Mode=OneWay}" MaxHeight="220" SelectionMode="None"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:RdpSessionItem">
                                                <Grid HorizontalAlignment="Stretch" Padding="6,6" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE7F4;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Text="{x:Bind SessionName}" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind UserName}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind State}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind SessionId, Converter={StaticResource StringFormatConverter}, ConverterParameter='ID: {0}'}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="🛑 中斷" Click="DisconnectSession_Click" Padding="8,4" FontSize="11" />
                                                        <Button Content="🚪 登出" Click="LogoffSession_Click" Padding="8,4" FontSize="11" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ════ Tab 7: CMD 網路工具箱 (Ping, Netstat, OpenFiles, Nbtstat, TCP Global AutoTuning) ════ -->
                <TabViewItem x:Name="TabCliTools" Header="⚡ CMD 網路工具箱" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Margin="0,10,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                            <!-- Global TCP Auto-Tuning Card (netsh int tcp set global autotuninglevel=...) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="⚡ 全域 TCP 視窗自動微調與協定堆疊設定 (netsh int tcp set global autotuninglevel)" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="{x:Bind ViewModel.TcpStatusMessage, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔄 讀取目前狀態" Command="{x:Bind ViewModel.RefreshTcpGlobalCommand}"
                                                Padding="10,6" FontSize="12" AutomationProperties.Name="讀取目前全域 TCP 狀態" />
                                        <Button Grid.Column="2" Content="🚀 極速大頻寬最佳化" Command="{x:Bind ViewModel.ApplyTcpExtremePresetCommand}"
                                                Padding="10,6" FontSize="12" ToolTipService.ToolTip="一鍵開啟 AutoTuning + ECN + RSS + RSC + BBR/CUBIC" />
                                        <Button Grid.Column="3" Content="↩️ 還原官方預設" Command="{x:Bind ViewModel.RestoreTcpDefaultPresetCommand}"
                                                Padding="10,6" FontSize="12" />
                                    </Grid>

                                    <!-- Live TCP Parameter Badges -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Auto-Tuning Level" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpAutoTuningLevel, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Congestion Provider" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpCongestionProvider, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="ECN Capability" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpEcnState, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="RSS 多核分流" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpRssState, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="RSC 分段合併" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpRscState, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="5" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Timestamps" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TcpTimestampsState, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Level Selector + Generated Command Box + Apply Button -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Header="自動微調等級 (autotuninglevel)"
                                                  ItemsSource="{x:Bind ViewModel.TcpAutoTuningLevels}"
                                                  SelectedItem="{x:Bind ViewModel.TcpAutoTuningLevel, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBox Grid.Column="1" Header="即將執行的 CMD 指令預覽"
                                                 Text="{x:Bind ViewModel.TcpGeneratedCommand, Mode=OneWay}"
                                                 IsReadOnly="True" FontFamily="Consolas" VerticalAlignment="Bottom" />
                                        <Button Grid.Column="2" Content="📋 複製指令"
                                                Command="{x:Bind ViewModel.CopyTcpAutoTuningCmdCommand}"
                                                VerticalAlignment="Bottom" Padding="12,8" />
                                        <Button Grid.Column="3" Content="⚡ 執行設定套用"
                                                Command="{x:Bind ViewModel.ApplyTcpAutoTuningLevelCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind ViewModel.IsApplyingTcpGlobal, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                                VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>

                                    <!-- 1-Click Quick Level Presets -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="快速切換微調等級：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="normal (預設推薦)" Tag="normal" Click="TcpLevelPreset_Click" Padding="8,4" FontSize="11"
                                                ToolTipService.ToolTip="netsh int tcp set global autotuninglevel=normal (標準動態調整接收視窗)" />
                                        <Button Content="experimental (萬兆/跨國大頻寬)" Tag="experimental" Click="TcpLevelPreset_Click" Padding="8,4" FontSize="11"
                                                ToolTipService.ToolTip="netsh int tcp set global autotuninglevel=experimental (允許極大接收視窗，適合高延遲高頻寬連線)" />
                                        <Button Content="restricted (相容舊路由器)" Tag="restricted" Click="TcpLevelPreset_Click" Padding="8,4" FontSize="11"
                                                ToolTipService.ToolTip="netsh int tcp set global autotuninglevel=restricted (適度限制接收視窗成長幅度)" />
                                        <Button Content="highlyrestricted (高度保守)" Tag="highlyrestricted" Click="TcpLevelPreset_Click" Padding="8,4" FontSize="11"
                                                ToolTipService.ToolTip="netsh int tcp set global autotuninglevel=highlyrestricted (非常保守地放大接收視窗)" />
                                        <Button Content="disabled (停用自動微調)" Tag="disabled" Click="TcpLevelPreset_Click" Padding="8,4" FontSize="11"
                                                ToolTipService.ToolTip="netsh int tcp set global autotuninglevel=disabled (固定接收視窗，排查特定遊戲或老舊防火牆掉包時使用)" />
                                    </StackPanel>

                                    <Expander Header="📄 檢視完整 netsh int tcp show global 原始輸出" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <TextBox Text="{x:Bind ViewModel.TcpGlobalRawOutput, Mode=OneWay}"
                                                 IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                                                 MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Ping & MTU Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🌐 Ping 延遲探測與最佳路徑 MTU 自動發現 (Path MTU Discovery)" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="目標主機或 IP" Text="{x:Bind ViewModel.PingOptions.TargetHost, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="封包數 (-n)" Text="{x:Bind ViewModel.PingOptions.Count, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Header="緩衝區大小 (-l)" Text="{x:Bind ViewModel.PingOptions.BufferSize, Mode=TwoWay}" />
                                        <Button Grid.Column="3" Content="🚀 開始 Ping" Command="{x:Bind ViewModel.RunPingCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                        <Button Grid.Column="4" Content="🔍 探測 MTU" Command="{x:Bind ViewModel.DetectMtuCommand}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>

                                    <!-- Log Output -->
                                    <TextBox Text="{x:Bind ViewModel.PingOutputLog, Mode=OneWay}" Height="140"
                                             AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <!-- Netstat Port Hunter Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🎯 通訊埠佔用獵手 (Netstat Port Hunter &amp; 1-Click Process Terminator)" FontWeight="Bold" FontSize="14" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="篩選端口 (例如 80, 443, 8080)" Text="{x:Bind ViewModel.FilterPort, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Content="🔍 查詢通訊埠佔用" Command="{x:Bind ViewModel.RefreshNetstatCommand}" VerticalAlignment="Bottom" Padding="14,8" />
                                        <Button Grid.Column="2" Content="⚡ 一鍵終結佔用此端口程式" Command="{x:Bind ViewModel.KillPortOccupantCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="14,8" />
                                    </Grid>

                                    <!-- Quick Port Presets -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="常用連接埠快速篩選：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="Web (80)" Tag="80" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                        <Button Content="HTTPS (443)" Tag="443" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                        <Button Content="Dev (8080)" Tag="8080" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                        <Button Content="Node (3000)" Tag="3000" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                        <Button Content="RDP (3389)" Tag="3389" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                        <Button Content="MC (25565)" Tag="25565" Click="NetstatPreset_Click" Padding="8,3" FontSize="11" />
                                    </StackPanel>

                                    <!-- Empty / Vacant State Banner -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10"
                                            Visibility="{x:Bind ViewModel.NetstatEmptyStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.NetstatEmptyStatus, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <ListView ItemsSource="{x:Bind ViewModel.NetstatConnections, Mode=OneWay}" MaxHeight="220" SelectionMode="None"
                                              HorizontalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:NetstatConnectionItem">
                                                <Grid HorizontalAlignment="Stretch" Padding="4,6" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind LocalAddress}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ForeignAddress}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind State}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Pid}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind ProcessName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Button Grid.Column="6" Content="⚡ 終止 PID" Tag="{x:Bind Pid}" Click="KillNetstatRow_Click"
                                                            Padding="8,3" FontSize="11" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- 🌐 遠端伺服器 Port 連通性測試 (Remote Port Reachability Tester) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="🌐 遠端伺服器 Port 連通性測試 (Remote Port Reachability Tester)" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="測試遠端伺服器或特定 IP 的連接埠是否對外開放 (免安裝 Telnet，原生非同步探測)，精確偵測回應延遲與防火牆阻擋狀態。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📦 啟用 Windows 內建 Telnet 用戶端" Command="{x:Bind ViewModel.InstallTelnetClientCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsInstallingTelnet, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                                Padding="10,6" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="目標伺服器主機名稱或 IP" Text="{x:Bind ViewModel.RemoteTestHost, Mode=TwoWay}" PlaceholderText="例如: google.com 或 192.168.1.1" />
                                        <TextBox Grid.Column="1" Header="目標 Port (1-65535)" Text="{x:Bind ViewModel.RemoteTestPort, Mode=TwoWay}" PlaceholderText="例如: 443" />
                                        <Button Grid.Column="2" Content="🚀 測試連通性" Command="{x:Bind ViewModel.TestRemotePortCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsTestingRemotePort, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="16,8" />
                                    </Grid>

                                    <!-- Remote Test Status & Output -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10"
                                            Visibility="{x:Bind ViewModel.RemotePortTestResult, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.RemotePortTestResult, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>

                                    <TextBlock Text="{x:Bind ViewModel.TelnetInstallStatus, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               Visibility="{x:Bind ViewModel.TelnetInstallStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- OpenFiles and Nbtstat Card -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- OpenFiles -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📂 共享檔案遠端鎖定 (OpenFiles)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="🔄 查詢" Command="{x:Bind ViewModel.RefreshOpenFilesCommand}" Padding="8,4" FontSize="11" />
                                        </Grid>
                                        <ListView ItemsSource="{x:Bind ViewModel.OpenFiles, Mode=OneWay}" MaxHeight="160" SelectionMode="None"
                                                  HorizontalAlignment="Stretch"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:OpenSharedFileItem">
                                                    <Grid HorizontalAlignment="Stretch" Padding="2,4" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind OpenPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1" Content="🔓 解鎖" Click="DisconnectOpenFile_Click" Padding="6,2" FontSize="10" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <!-- Nbtstat -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="🔄 NetBIOS 快取與名稱釋放 (Nbtstat)" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="當區網電腦更改 IP 或在網路芳鄰中失聯時，強制清除並重整 NetBIOS 快取 (-R &amp; -RR)。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="⚡ 一鍵清除並重載 NetBIOS 快取" Command="{x:Bind ViewModel.FlushNetBiosCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,6" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 🔐 L2TP/IPsec VPN 連線錯誤 789/809 終極修復 (PolicyAgent NAT-T Fix) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="🔐 L2TP/IPsec VPN 無法連線修復 (AssumeUDPEncapsulationContextOnSendRule = 2)" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="修復 Windows 10/11 連線至 NAT 路由器後方 L2TP/IPsec VPN 伺服器時卡在「正在連線」或報錯 789 / 809 的問題。寫入 HKLM\SYSTEM\CurrentControlSet\Services\PolicyAgent 下 AssumeUDPEncapsulationContextOnSendRule = 2 (REG_DWORD)，重開機後生效。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="⚡ 一鍵套用 L2TP NAT-T 修復 (設為 2)" Command="{x:Bind ViewModel.ApplyL2tpVpnNatTFixCommand}" Style="{StaticResource AccentButtonStyle}" Padding="12,6" />
                                            <Button Content="↩️ 還原預設" Command="{x:Bind ViewModel.RestoreL2tpVpnNatTDefaultCommand}" Padding="10,6" />
                                            <Button Content="🔄 狀態" Command="{x:Bind ViewModel.RefreshL2tpVpnNatTStatusCommand}" Padding="10,6" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.L2tpVpnNatTStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
