                                                    ToolTipService.ToolTip="重設縮放為 100%" AutomationProperties.Name="重設縮放為 100%">
                                                <FontIcon Glyph="&#xE71E;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
