<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="SettingsTitleText" Text="⚙️ 應用程式偏好設定" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SettingsSubtitleText" Text="自訂 DiskMaster Pro 介面外觀、全域縮放、安全防呆確認與磁碟預設行為。"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 0. Language & Region -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="LanguageCardTitle" Text="🌐 介面語言與地區" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LanguageCardDesc" Text="選擇 DiskMaster Pro 顯示語言，全域介面即時無重啟切換。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LanguageBox" Header="選擇介面語言" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 0.1 Custom UI Fonts & Typography -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="FontsCardTitle" Text="🔤 自訂介面字型與排版" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="FontsCardDesc" Text="自由挑選喜愛的系統字型或手動輸入任何已安裝字型家族名稱，全視窗立即同步套用。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FontFamilyBox" Grid.Column="0" Header="精選介面字型" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.FontOptionList, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFontOption, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock x:Name="FontScaleLabel" Text="字級比例縮放:" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.CustomFontScale, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="CustomFontScaleSlider" Minimum="90" Maximum="125" StepFrequency="5"
                                    Value="{x:Bind ViewModel.CustomFontScale, Mode=TwoWay}"
                                    ValueChanged="CustomFontScaleSlider_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- Custom Font Name Input -->
                    <TextBox x:Name="CustomFontBox" Header="自訂字型家族名稱"
                             Text="{x:Bind ViewModel.CustomFontFamily, Mode=TwoWay}"
                             PlaceholderText="例如: Cascadia Code, Microsoft JhengHei UI, Segoe UI Variable"
                             Visibility="{x:Bind ViewModel.IsCustomFontInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Live Typography Preview Box -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                        <StackPanel x:Name="FontPreviewPanel" Spacing="4">
                            <TextBlock x:Name="FontPreviewHeader" Text="字型即時預覽效果:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PreviewTwText" Text="繁體中文：磁碟大師 系統部署與引導修復" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewCnText" Text="简体中文：磁盘大师 系统部署与引导修复" FontSize="13" />
                            <TextBlock x:Name="PreviewEnText" Text="English: The quick brown fox jumps over the lazy dog. 1234567890" FontSize="13" />
                            <TextBlock x:Name="PreviewJaText" Text="日本語：迅速な茶色の狐は怠惰な犬を飛び越えます。" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 0.2 Adobe Workspace Layout Presets -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="WorkspaceCardTitle" Text="🗂️ 工作區佈局預設" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceCardDesc" Text="依據目前工作情境一鍵切換分頁優先級與工作區，提供如專業軟體般的佈局體驗。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="WorkspacePresetBox" Header="工作區佈局預設檔" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.WorkspacePresetOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedWorkspacePreset, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 1. Appearance & Scale -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="AppearanceHeader" Text="🎨 外觀與顯示" Style="{StaticResource SubtitleTextBlockStyle}" />
                    
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ThemeBox" Grid.Column="0" Header="應用程式主題" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                        <ComboBox x:Name="ScaleBox" Grid.Column="1" Header="介面縮放比例" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ScaleOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedScale, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DisplayMetricsDescription, Mode=OneWay}"
                                   VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="AutoDetectScaleBtn" Grid.Column="1" Content="⚡ 自動偵測最適縮放"
                                Command="{x:Bind ViewModel.AutoDetectScaleCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Custom Background & Companion Avatar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="BackgroundCardTitle" Text="🎭 自訂背景圖片與桌布小助手" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Custom Wallpaper -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WallpaperTitle" Text="自訂桌面背景圖" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackgroundImagePathBox" Grid.Column="0" Text="{x:Bind ViewModel.BackgroundImagePath, Mode=TwoWay}"
                                     PlaceholderText="請選擇圖片檔案路徑" />
                            <Button x:Name="BrowseBackgroundBtn" Grid.Column="1" Content="📁 瀏覽圖片..." Command="{x:Bind ViewModel.BrowseBackgroundImageCommand}" />
                            <Button x:Name="ClearBackgroundBtn" Grid.Column="2" Content="❌ 清除背景" Command="{x:Bind ViewModel.ClearBackgroundImageCommand}" />
                        </Grid>

                        <Grid ColumnSpacing="12" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WallpaperOpacityLabel" Grid.Column="0" Text="桌布底圖不透明度:" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.05" Maximum="1.0" StepFrequency="0.05"
                                    Value="{x:Bind ViewModel.BackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.BackgroundOpacity, Mode=OneWay}"
                                       VerticalAlignment="Center" Width="40" />
                        </Grid>

                        <!-- Glass / Translucent Mode -->
                        <ToggleSwitch x:Name="GlassTransparencyToggle" Header="💎 啟用卡片磨砂半透明模式"
                                      OffContent="已停用" OnContent="已啟用"
                                      IsOn="{x:Bind ViewModel.EnableGlassTransparency, Mode=TwoWay}" Margin="0,6,0,0" />

                        <Grid ColumnSpacing="12" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.EnableGlassTransparency, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CardOpacityLabel" Grid.Column="0" Text="卡片不透明度:" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.15" Maximum="1.0" StepFrequency="0.05"
                                    Value="{x:Bind ViewModel.CardOpacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CardOpacity, Mode=OneWay}"
                                       VerticalAlignment="Center" Width="40" />
                        </Grid>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Live2D / 3D VRM Companion Avatar -->
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="CompanionAvatarToggle" Header="啟用桌布互動小助手"
                                      OffContent="已關閉" OnContent="已開啟"
                                      IsOn="{x:Bind ViewModel.EnableCompanionAvatar, Mode=TwoWay}" />

                        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.EnableCompanionAvatar, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CompanionTypeBox" Grid.Column="0" Header="模型架構類型" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.CompanionTypeOptions}"
                                      SelectedItem="{x:Bind ViewModel.CompanionAvatarType, Mode=TwoWay}" />
                            <TextBox x:Name="CompanionModelPathBox" Grid.Column="1" Header="自訂模型檔案"
                                     Text="{x:Bind ViewModel.CompanionModelPath, Mode=TwoWay}"
                                     PlaceholderText="空白時使用內建經典小助手" />
                            <Button x:Name="BrowseCompanionModelBtn" Grid.Column="2" Content="📂 選擇模型..."
                                    Command="{x:Bind ViewModel.BrowseCompanionModelCommand}"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Safety & Confirmations -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SafetyHeader" Text="🛡️ 安全與防呆機制" Style="{StaticResource SubtitleTextBlockStyle}" />
                    
                    <ToggleSwitch x:Name="SafetyConfirmationsToggle" Header="破壞性操作二次安全確認"
                                  OffContent="已停用" OnContent="已啟用"
                                  IsOn="{x:Bind ViewModel.EnableSafetyConfirmations, Mode=TwoWay}" />
                    <TextBlock x:Name="SafetyDescText" Text="建議保持啟用，可防止誤點清除、刪除磁碟分區或重置 Windows 更新備份組件。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Prompt Windows & Diagnostics -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90A;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="PromptCardTitle" Text="🔔 彈出視窗提示與系統除錯診斷" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Prompt Window Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="PromptWindowsToggle" Grid.Column="0"
                                      Header="彈出式模態提示視窗"
                                      OffContent="僅頂部橫幅" OnContent="主動彈出對話框"
                                      IsOn="{x:Bind ViewModel.EnablePromptWindows, Mode=TwoWay}" />
                        <Button x:Name="TestPromptDialogBtn" Grid.Column="1" Content="🧪 測試提示視窗"
                                Click="TestPromptDialog_Click"
                                VerticalAlignment="Center" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Debug Diagnostics Export -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DiagnosticsTitle" Text="系統深度除錯與診斷報告匯出" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagnosticsDesc" Text="一鍵收集本機 OS 版本、CPU、記憶體、硬碟型號、S.M.A.R.T. 健康、更新服務、TCP 堆疊與近期防護日誌，輸出為完整 .txt 診斷報告。"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExportDiagnosticsBtn" Grid.Column="0" Content="📤 匯出系統除錯診斷日誌"
                                    Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="12,6" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DiagnosticExportMessage, Mode=OneWay}"
                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Defaults for Partitions & Disks -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DefaultsHeader" Text="💾 磁碟與部署預設值" Style="{StaticResource SubtitleTextBlockStyle}" />
                    
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PartitionStyleBox" Grid.Column="0" Header="預設分割表樣式" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PartitionStyleOptions}"
                                  SelectedItem="{x:Bind ViewModel.DefaultPartitionStyle, Mode=TwoWay}" />
                        <ComboBox x:Name="FileSystemBox" Grid.Column="1" Header="預設檔案系統格式" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.FileSystemOptions}"
                                  SelectedItem="{x:Bind ViewModel.DefaultFileSystem, Mode=TwoWay}" />
                    </Grid>

                    <TextBox x:Name="DefaultBackupFolderBox" Header="預設備份與匯出目錄"
                             Text="{x:Bind ViewModel.DefaultBackupFolder, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 4. Global Internet Download & Proxy -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="DownloadCardTitle" Text="🌐 全域網際網路下載與代理加速" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Global Download Folder -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GlobalDownloadPathBox" Grid.Column="0" Header="全域預設 ISO 下載目錄"
                                 Text="{x:Bind ViewModel.GlobalDownloadPath, Mode=TwoWay}" />
                        <Button x:Name="BrowseGlobalDownloadBtn" Grid.Column="1" Content="📁 瀏覽目錄..."
                                Command="{x:Bind ViewModel.BrowseGlobalDownloadFolderCommand}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- HTTP Range & Threads -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ParallelThreadsBox" Grid.Column="0" Header="預設並行連線數" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ParallelThreadOptions}"
                                  SelectedItem="{x:Bind ViewModel.ParallelThreadCount, Mode=TwoWay}" />
                        <ComboBox x:Name="ChunkBufferSizeBox" Grid.Column="1" Header="預設分塊快取大小" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ChunkSizeOptions}"
                                  SelectedItem="{x:Bind ViewModel.ChunkBufferSizeKB, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="HttpRangeToggle" Grid.Column="0" Header="預設啟用 HTTP Range 多線程加速"
                                      OffContent="單線程" OnContent="多線程並行"
                                      IsOn="{x:Bind ViewModel.HttpRangeParallelEnabled, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="KeepResumeCacheToggle" Grid.Column="1" Header="保留斷點續傳快取檔"
                                      OffContent="取消時刪除" OnContent="保留以供續傳"
                                      IsOn="{x:Bind ViewModel.KeepResumeCache, Mode=TwoWay}" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Proxy Settings -->
                    <TextBlock x:Name="ProxyTitle" Text="網路連線代理伺服器" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProxyModeBox" Grid.Column="0" Header="代理模式" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ProxyModeOptions}"
                                  SelectedItem="{x:Bind ViewModel.ProxyMode, Mode=TwoWay}" />
                        <TextBox x:Name="CustomProxyUrlBox" Grid.Column="1" Header="自訂代理網址"
                                 Text="{x:Bind ViewModel.CustomProxyUrl, Mode=TwoWay}"
                                 PlaceholderText="http://127.0.0.1:7890" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. TCP Network Stack Optimization -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="TcpCardTitle" Text="⚡ TCP 網路協定堆疊最佳化" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Real-time Status Badge -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.TcpSettingsSummary, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="RefreshTcpBtn" Grid.Column="1" Content="🔄 重新整理狀態"
                                    Command="{x:Bind ViewModel.RefreshTcpSettingsCommand}"
                                    Padding="8,2" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- AutoTuning & Congestion -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TcpAutoTuningBox" Grid.Column="0" Header="接收視窗自動微調" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.TcpAutoTuningOptions}"
                                  SelectedItem="{x:Bind ViewModel.TcpAutoTuningLevel, Mode=TwoWay}" />
                        <ComboBox x:Name="TcpCongestionBox" Grid.Column="1" Header="擁塞控制演算法" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.TcpCongestionOptions}"
                                  SelectedItem="{x:Bind ViewModel.TcpCongestionProvider, Mode=TwoWay}" />
                    </Grid>

                    <!-- Toggles: ECN, RSS, RSC, Timestamps -->
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleSwitch x:Name="TcpEcnToggle" Grid.Row="0" Grid.Column="0" Header="ECN 顯式擁塞通知"
                                      OffContent="已停用" OnContent="已啟用"
                                      IsOn="{x:Bind ViewModel.TcpEcnEnabled, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="TcpRssToggle" Grid.Row="0" Grid.Column="1" Header="RSS 網卡多核心佇列分流"
                                      OffContent="已停用" OnContent="已啟用"
                                      IsOn="{x:Bind ViewModel.TcpRssEnabled, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="TcpRscToggle" Grid.Row="1" Grid.Column="0" Header="RSC 封包硬體分段合併卸載"
                                      OffContent="已停用" OnContent="已啟用"
                                      IsOn="{x:Bind ViewModel.TcpRscEnabled, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="TcpTimestampsToggle" Grid.Row="1" Grid.Column="1" Header="關閉 RFC 1323 時間戳"
                                      OffContent="保留時間戳" OnContent="關閉時間戳"
                                      IsOn="{x:Bind ViewModel.TcpTimestampsDisabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- 1-Click Operations -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ApplyTcpPresetBtn" Grid.Column="0" Content="⚡ 一鍵套用極速下載與電競網路"
                                Command="{x:Bind ViewModel.ApplyTcpThroughputPresetCommand}"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button x:Name="RestoreTcpDefaultsBtn" Grid.Column="1" Content="🔄 還原 Windows 官方網路預設值"
                                Command="{x:Bind ViewModel.RestoreTcpDefaultsCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="FlushDnsBtn" Grid.Column="2" Content="🌐 清除 DNS 快取"
                                Command="{x:Bind ViewModel.FlushDnsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6.1 System Tray & Notifications -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="TrayCardTitle" Text="📥 系統匣後台與操作反饋" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TrayCardDesc" Text="設定最小化至系統匣、任務完成工作列閃爍與 Windows 系統音效提示。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Row="0" Grid.Column="0" Header="視窗最小化時縮小至系統匣"
                                      OffContent="一般最小化" OnContent="縮小至系統匣"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Row="0" Grid.Column="1" Header="點擊關閉 (X) 時縮小至系統匣"
                                      OffContent="直接退出" OnContent="後台保留"
                                      IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="TaskbarFlashToggle" Grid.Row="1" Grid.Column="0" Header="任務完成或警告時閃爍工作列"
                                      OffContent="已停用" OnContent="已啟用"
                                      IsOn="{x:Bind ViewModel.EnableTaskbarFlash, Mode=TwoWay}" />
                        <ToggleSwitch x:Name="AudioFeedbackToggle" Grid.Row="1" Grid.Column="1" Header="操作成功與完成播放提示音效"
                                      OffContent="靜音" OnContent="音效啟用"
                                      IsOn="{x:Bind ViewModel.EnableAudioFeedback, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6.2 Auto Updater -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="UpdaterCardTitle" Text="🚀 自動更新與版本管理" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="UpdaterCardDesc" Text="透過 GitHub Releases 檢查最新版本，可自由設定啟動自動檢查或手動點擊更新。"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Grid.Column="0" Header="自動檢查版本更新"
                                      OffContent="僅手動檢查" OnContent="自動檢查"
                                      IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                        <ComboBox x:Name="UpdateFrequencyBox" Grid.Column="1" Header="檢查更新頻率" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.UpdateFrequencyOptions}"
                                  SelectedItem="{x:Bind ViewModel.UpdateFrequency, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdateBtn" Content="🔍 立即檢查更新"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="DownloadUpdateBtn" Content="🌐 下載最新版本"
                                Command="{x:Bind ViewModel.OpenUpdateDownloadCommand}"
                                Visibility="{x:Bind ViewModel.HasAvailableUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 6. Cache & Maintenance -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="MaintenanceHeader" Text="🧹 維護與暫存清理" Style="{StaticResource SubtitleTextBlockStyle}" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CleanTempCacheBtn" Content="🧹 清理暫存腳本檔案" Command="{x:Bind ViewModel.CleanTempCacheCommand}" />
                        <Button x:Name="ResetDefaultsBtn" Content="🔄 恢復預設設定" Command="{x:Bind ViewModel.ResetToDefaultsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. System Info -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AboutHeader" Text="ℹ️ 軟體與系統環境資訊" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SystemInfo}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Save Action & Status -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,24">
                <Button x:Name="SaveSettingsBtn" Content="💾 儲存並套用設定" Command="{x:Bind ViewModel.SaveSettingsCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,8" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
