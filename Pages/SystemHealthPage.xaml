<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.SystemHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Top Status & Elevation Bar ═══ -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />

            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                          Width="22" Height="22" Margin="0,0,8,0" />

            <InfoBar x:Name="AdminInfoBar" Grid.Column="2" IsOpen="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                     Severity="Warning" Title="未具備系統管理員權限" IsClosable="False"
                     Message="SFC 與 DISM 修復需要管理員權限。">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartAdminBtn" Content="以管理員身分重啟" Command="{x:Bind ViewModel.RestartAsAdminCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- ═══ Unified Main Scrollable Workspace (Gives laptops full vertical breathing room) ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12" Margin="0,0,8,12">

                <!-- ═══ 1-Click Complete System Repair Banner ═══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                        CornerRadius="8" Padding="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE90F;" FontSize="32"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="OneClickTitleText" Text="🚀 一鍵全自動 Windows 健康度修復 (DISM 三段 + SFC)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                            <TextBlock Text="依序執行 DISM ScanHealth → CheckHealth → RestoreHealth 修復元件存放區，再執行 SFC /scannow 自動替換損毀系統檔案。"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Padding="14,8"
                                Command="{x:Bind ViewModel.RunOneClickRepairCommand}" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock x:Name="StartRepairBtnText" Text="開始全自動修復" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ 🛡️ File Safety Protection & Quarantine Restore Vault ═══ -->
                <Expander x:Name="ProtectionVaultExpander" Header="🛡️ 檔案安全防護與隔離還原庫 (Protection &amp; Restore Vault)"
                          IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="多層安全防護已啟用：自動鎖定系統核心／個人文件／瀏覽器帳密，清理檔案先移入隔離還原庫可隨時一鍵復原。"
                                               FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.QuarantineVaultSummary, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshQuarantineVaultCommand}" Padding="8,4" FontSize="11" />
                                <Button Grid.Column="2" Content="📂 開啟目錄" Command="{x:Bind ViewModel.OpenQuarantineFolderCommand}" Padding="8,4" FontSize="11" />
                                <Button Grid.Column="3" Content="🧹 清空隔離庫" Command="{x:Bind ViewModel.PurgeQuarantineVaultCommand}" Padding="8,4" FontSize="11" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="啟用隔離還原庫 (7天 / 2GB 上限)"
                                      IsChecked="{x:Bind ViewModel.EnableQuarantineBackup, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1" Content="暫存檔 24 小時新檔保護 (防誤刪安裝／未存檔)"
                                      IsChecked="{x:Bind ViewModel.EnableTempFileAgeGuard, Mode=TwoWay}" />
                            <CheckBox Grid.Column="2" Content="高風險清理前自動建立系統還原點"
                                      IsChecked="{x:Bind ViewModel.CreateRestorePointBeforeRiskyClean, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasQuarantineSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="♻️ 可還原的清理備份批次 (點擊即可還原至原始路徑，不覆蓋較新檔案):" FontWeight="SemiBold" FontSize="12" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.QuarantineSessions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:QuarantineSessionItem">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6" Margin="0,2">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind DisplayTime}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind StatusBadge, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="♻️ 一鍵還原" Click="RestoreQuarantineSession_Click"
                                                        Style="{StaticResource AccentButtonStyle}" Padding="10,3" FontSize="11" />
                                                <Button Grid.Column="3" Content="🗑️" Click="DeleteQuarantineSession_Click"
                                                        ToolTipService.ToolTip="移除此備份批次" Padding="7,3" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- ═══ Individual SFC and DISM Operations ═══ -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: SFC Tools -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="SfcTitleText" Text="系統檔案檢查程式 (SFC)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                            </StackPanel>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{x:Bind ViewModel.RunSfcScanNowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="🔍 sfc /scannow" FontWeight="SemiBold" />
                                    <TextBlock Text="掃描所有受保護系統檔案並自動從健康元件庫替換損毀項目。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{x:Bind ViewModel.RunSfcVerifyOnlyCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="📋 sfc /verifyonly" FontWeight="SemiBold" />
                                    <TextBlock Text="僅檢查系統檔案完整性（唯讀模式，不修改任何檔案）。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: DISM Tools -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="DismTitleText" Text="映像部署與維護服務 (DISM)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.RunDismCheckHealthCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="⚡ CheckHealth" FontWeight="SemiBold" />
                                        <TextBlock Text="快速檢查損毀標記。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.RunDismScanHealthCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="🔬 ScanHealth" FontWeight="SemiBold" />
                                        <TextBlock Text="深度掃描元件存放區。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.RunDismRestoreHealthCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="🛠️ RestoreHealth" FontWeight="SemiBold" />
                                        <TextBlock Text="修復損毀系統映像檔。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.RunDismCleanupCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="🧹 Cleanup WinSxS" FontWeight="SemiBold" />
                                        <TextBlock Text="清理舊版元件釋放空間。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ Windows Update 修復與更新管理 (含 0x800F0831 CBS 修復中心) ═══ -->
                <Expander x:Name="WindowsUpdateExpander" Header="🔄 Windows Update 與 0x800F0831 修復設定中心 (Update &amp; CBS Repair)"
                          IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <!-- Status Bar -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <Grid ColumnSpacing="14" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="更新服務狀態:" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind ViewModel.WuInfo.StatusBadge, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="SoftwareDistribution:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.WuInfo.SoftwareDistributionDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Catroot2:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.WuInfo.Catroot2Display, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="3" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshWindowsUpdateStatusCommand}"
                                        Padding="8,3" FontSize="11" />

                                <!-- TrustedInstaller / TiWorker Health Row -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="元件安裝引擎:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.WuInfo.TiWorkerSummary, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🛠️ 還原 TrustedInstaller 為手動 (省 RAM)"
                                            Command="{x:Bind ViewModel.RestoreTrustedInstallerDefaultCommand}"
                                            Visibility="{x:Bind ViewModel.WuInfo.IsTiWorkerAbnormal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                            Padding="10,3" FontSize="11" />
                                </Grid>

                                <InfoBar Grid.Row="2" Grid.ColumnSpan="4" IsOpen="{x:Bind ViewModel.WuInfo.IsRebootRequired, Mode=OneWay}"
                                         Severity="Warning" IsClosable="False" Margin="0,2,0,0"
                                         Title="需要重新開機 (Reboot Required)"
                                         Message="系統偵測到待處理之更新或 CBS 修復變更，建議完成修復後重新啟動電腦。">
                                    <InfoBar.ActionButton>
                                        <Button Content="🔄 排程重新啟動" Command="{x:Bind ViewModel.PromptRestartComputerCommand}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </Grid>
                        </Border>

                        <!-- Error Code Quick Preset Selector -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡ 錯誤碼快速診斷預設:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.WuErrorPresets}"
                                              SelectedItem="{x:Bind ViewModel.SelectedWuPreset, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SelectedWuPresetDescription, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Granular Repair Settings Checklist -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🛠️ 自訂 Windows Update 修復項目設定 (依勾選順序安全執行)" FontWeight="SemiBold" FontSize="13" />
                                <Grid ColumnSpacing="16" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="1. DISM /ScanHealth (深度掃描存放區損毀)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.RunDismScanHealth, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="2. DISM /CheckHealth (檢查損毀標記)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.RunDismCheckHealth, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="3. DISM /RestoreHealth (線上/來源修復元件庫)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.RunDismRestoreHealth, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="4. SFC /scannow (修復受保護系統檔案)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.RunSfcScanNow, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="5. 重設 WU / BITS 服務與清空 BITS 佇列"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ResetWuServicesAndBits, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="6. 重建 SoftwareDistribution 快取目錄"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ResetSoftwareDistribution, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="3" Grid.Column="0" Content="7. 重新註冊 30+ Windows Update 核心 DLL"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ReRegisterCoreDlls, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="8. 還原 bits / wuauserv 服務權限 (SDSet ACL)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ResetServiceSecurityDescriptors, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="4" Grid.Column="0" Content="9. 修復 TrustedInstaller 啟動類型為預設 Manual"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.FixTrustedInstallerStartupType, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="4" Grid.Column="1" Content="10. 修復後觸發現代更新掃描 (UsoClient)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.TriggerUpdateScanAfter, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="5" Grid.Column="0" Content="進階：同時重置 Catroot2 (短暫重啟 CryptSvc)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ResetCatroot2WithCryptSvc, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="5" Grid.Column="1" Content="進階：重置網路堆疊 Winsock/IP (⚠ 需重開機)"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.ResetNetworkStack, Mode=TwoWay}" />

                                    <CheckBox Grid.Row="6" Grid.Column="0" Content="DISM RestoreHealth 使用本機 WIM/ESD 來源"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.UseLocalRepairSource, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="6" Grid.Column="1" Content="修復完成且需要時提示重新啟動電腦"
                                              IsChecked="{x:Bind ViewModel.WuRepairOptions.PromptRebootAfterRepair, Mode=TwoWay}" />
                                </Grid>

                                <TextBox Visibility="{x:Bind ViewModel.WuRepairOptions.UseLocalRepairSource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Header="本機修復映像來源 (適用 0x800F0831 / 0x800F081F)"
                                         PlaceholderText="例如: wim:D:\sources\install.wim:1 或 esd:D:\sources\install.esd:1"
                                         Text="{x:Bind ViewModel.WuRepairOptions.LocalRepairSourcePath, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.FixWindowsUpdateErrorsCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                    <TextBlock Text="🛠️ 執行自訂 Windows Update 修復流程" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ResetSoftwareDistributionCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="📂 重建 SoftwareDistribution 快取" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Content="🔎 觸發更新掃描"
                                    Command="{x:Bind ViewModel.TriggerUpdateCheckCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>

                        <!-- CBS.log & Failed Update History Diagnostics + Catalog + Troubleshooter -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="🔎 CBS.log 損毀分析、失敗 KB 查詢與手動套件安裝 (對應 0x800F0831 步驟 2 &amp; 3)" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.CbsScanSummary, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsScanningCbs, Mode=OneWay}" Width="18" Height="18" />
                                    <Button Grid.Column="2" Content="🔍 掃描 CBS.log 與更新歷程"
                                            Command="{x:Bind ViewModel.ScanCbsAndUpdateHistoryCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsScanningCbs, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                                </Grid>

                                <!-- Quick Catalog Search + Local MSU/CAB Installer + Official Troubleshooter -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="輸入 KB 編號或套件名稱搜尋 Microsoft Update 目錄 (例如 KB5034441)..."
                                             Text="{x:Bind ViewModel.ManualCatalogSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="🌐 Update 目錄"
                                            Command="{x:Bind ViewModel.OpenCatalogForQueryCommand}"
                                            ToolTipService.ToolTip="前往 Microsoft Update 目錄搜尋並下載獨立更新套件" />
                                    <Button Grid.Column="2" Content="📦 安裝 .msu/.cab"
                                            Command="{x:Bind ViewModel.InstallLocalUpdatePackageCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                            ToolTipService.ToolTip="手動安裝從 Microsoft Update 目錄下載的 .msu 或 .cab 套件" />
                                    <Button Grid.Column="3" Content="🩺 更新疑難排解員"
                                            Command="{x:Bind ViewModel.LaunchWuTroubleshooterCommand}"
                                            ToolTipService.ToolTip="開啟 Windows 設定 → 疑難排解 → Windows Update 疑難排解員" />
                                    <Button Grid.Column="4" Content="📖 官方指南"
                                            Command="{x:Bind ViewModel.OpenTroubleshootGuideCommand}"
                                            ToolTipService.ToolTip="開啟 Microsoft 官方 0x800F0831 疑難排解文件" />
                                </Grid>

                                <!-- CBS.log Findings List -->
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasCbsFindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="📋 CBS.log 偵測到的元件存放區錯誤與缺失套件:" FontWeight="SemiBold" FontSize="12" />
                                    <ListView ItemsSource="{x:Bind ViewModel.CbsFindings, Mode=OneWay}" MaxHeight="160" SelectionMode="None" HorizontalAlignment="Stretch">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="36" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CbsDiagnosticFinding">
                                                <Grid Padding="6,4" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="🌐 搜尋目錄" Click="OpenCbsCatalog_Click" Padding="8,2" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Failed Update History List -->
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFailedUpdateHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🕒 Windows 更新歷程失敗記錄 (可一鍵前往目錄下載手動安裝):" FontWeight="SemiBold" FontSize="12" />
                                    <ListView ItemsSource="{x:Bind ViewModel.FailedUpdateHistory, Mode=OneWay}" MaxHeight="160" SelectionMode="None" HorizontalAlignment="Stretch">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="36" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:WindowsUpdateHistoryItem">
                                                <Grid Padding="6,4" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DateDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="🌐 搜尋目錄" Click="OpenHistoryCatalog_Click" Padding="8,2" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Options & Policy Controls -->
                        <Grid ColumnSpacing="16" Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="停用 Windows Update 自動更新" FontWeight="SemiBold" />
                                <TextBlock Text="透過停用服務與寫入群組原則 NoAutoUpdate，防止系統於背景強制重啟或下載更新"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <CheckBox Grid.Column="1" Content="重建前備份舊目錄 (.bak)"
                                      IsChecked="{x:Bind ViewModel.BackupSoftwareDist, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.WuInfo.IsDisabled, Mode=OneWay}"
                                          Toggled="WindowsUpdate_Toggled"
                                          IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                          OnContent="已停用" OffContent="正常運作" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ═══ 系統暫存與垃圾深度清理 ═══ -->
                <Expander x:Name="TempCleanExpander" Header="🧹 系統暫存與垃圾深度清理 (System Temp &amp; Deep Cache Cleanup)"
                          IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <!-- Top Summary -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="可釋放空間總計:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TotalScannedTempDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsScanningTemp, Mode=OneWay}" Width="20" Height="20" Margin="0,0,8,0" />

                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ScanTempCategoriesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsScanningTemp, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="🔍 重新掃描暫存" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Items ListView Container with distinct border to prevent top-clipping -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2">
                            <ListView ItemsSource="{x:Bind ViewModel.TempCategories, Mode=OneWay}"
                                      MaxHeight="260" SelectionMode="None"
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="40" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TempCategoryItem">
                                        <Grid Padding="6,4" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Icon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsRisky, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="⚠ 不可復原" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                                <TextBlock Text="{x:Bind RiskText}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="10"
                                                           Visibility="{x:Bind HasRiskText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SizeDisplay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- Dedicated Direct Cleaner Action Bar -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{x:Bind ViewModel.CleanTempFilesOnlyCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🧹" />
                                    <TextBlock Text="清理暫存檔案 (Temp)" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.CleanWindowsOldOnlyCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="💾" />
                                    <TextBlock Text="清理 Windows.old 備份" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.CleanAppCacheOnlyCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🌐" />
                                    <TextBlock Text="清理 App 應用與瀏覽器快取" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Live Cleaning & Deletion Status Banner (Real-Time Current Status) -->
                        <Border Visibility="{x:Bind ViewModel.HasCleaningStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsCleaningTemp, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsCleaningTemp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Width="22" Height="22" VerticalAlignment="Center" />

                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          Visibility="{x:Bind ViewModel.IsCleaningTemp, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CleaningStatusMessage, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.CleaningDetailMessage, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind ViewModel.CleaningProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 IsIndeterminate="{x:Bind ViewModel.IsCleaningIndeterminate, Mode=OneWay}"
                                                 Visibility="{x:Bind ViewModel.IsCleaningTemp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Height="4" CornerRadius="2" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Cancel Operation Button (visible while cleaning) -->
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelOperationCommand}"
                                        Visibility="{x:Bind ViewModel.IsCleaningTemp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Content="停止" Style="{StaticResource DefaultButtonStyle}"
                                        Padding="12,5" VerticalAlignment="Center" />

                                <!-- Clear / Delete current status button (always available when status banner is open) -->
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearCleaningStatusCommand}"
                                        ToolTipService.ToolTip="清除目前狀態 (Delete Current Status)"
                                        Padding="8,6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE894;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bottom Clean Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="全選"
                                      IsChecked="{x:Bind ViewModel.IsAllTempSelected, Mode=TwoWay}"
                                      Click="SelectAllTemp_Click" VerticalAlignment="Center" />

                            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.CleanSelectedTempCategoriesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="🧹 一鍵清理已勾選暫存項目" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Content="🚀 Windows 磁碟清理 (Cleanmgr)"
                                    Command="{x:Bind ViewModel.RunCleanmgrCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Advanced Cleanup -->
                <Expander x:Name="AdvCleanupExpander" Header="🧹 進階清理 (Advanced Cleanup)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Button x:Name="AnalyzeStoreBtn" Content="📊 分析元件存放區 (AnalyzeComponentStore)"
                                Command="{x:Bind ViewModel.RunDismAnalyzeStoreCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        <Button x:Name="ResetBaseBtn" Content="🗑️ 深度清理 /ResetBase (不可逆)"
                                Command="{x:Bind ViewModel.RunDismResetBaseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                    </StackPanel>
                </Expander>

                <!-- RestoreHealth with Source -->
                <Expander x:Name="SourceRepairExpander" Header="🔧 指定修復來源 (Repair with Source)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="修復錯誤 0x800f081f：指定 WIM/ESD 作為修復來源。" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="RepairSourceBox" Header="修復來源路徑 (如 wim:D:\sources\install.wim:1)"
                                 Text="{x:Bind ViewModel.RepairSourcePath, Mode=TwoWay}" PlaceholderText="wim:D:\sources\install.wim:1" />
                        <Button x:Name="RestoreWithSourceBtn" Content="🛠️ 使用來源修復 RestoreHealth"
                                Command="{x:Bind ViewModel.RunDismRestoreWithSourceCommand}" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                    </StackPanel>
                </Expander>

                <!-- Windows Features -->
                <Expander x:Name="FeaturesExpander" Header="⚙️ Windows 功能管理 (Features)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚡ 點擊「載入功能清單」後即可即時搜尋、點選並一鍵開關系統功能（如 NetFx3、Hyper-V、WSL 等），無需再死記名稱或切換到終端機。"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ListFeaturesBtn" Grid.Column="0" Command="{x:Bind ViewModel.RunDismGetFeaturesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock x:Name="ListFeaturesBtnText" Text="載入/重整功能清單" />
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="1" PlaceholderText="🔍 即時搜尋功能 (例如: IIS, NetFx, WSL, Virtual...)"
                                     Text="{x:Bind ViewModel.FeatureFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Empty Placeholder Hint -->
                        <Border Visibility="{x:Bind ViewModel.HasFeatures, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="💡 尚未載入功能清單。請點擊上方「載入/重整功能清單」按鈕，系統將自動透過 DISM 讀取本機所有功能並以互動卡片呈現。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView Visibility="{x:Bind ViewModel.HasFeatures, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.FilteredFeatures, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFeature, Mode=TwoWay}"
                                  MaxHeight="260" SelectionMode="Single"
                                  HorizontalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WindowsFeatureItem">
                                    <Grid Padding="8,4" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind StateBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FeatureName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="{x:Bind ActionButtonLabel}" Click="FeatureToggle_Click" Padding="8,2" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander Header="進階：手動輸入或指定 SxS 來源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FeatureNameBox" Grid.Column="0" Header="功能名稱 (Feature Name)"
                                             Text="{x:Bind ViewModel.FeatureName, Mode=TwoWay}" PlaceholderText="e.g. NetFx3, Microsoft-Windows-Subsystem-Linux" />
                                    <TextBox x:Name="FeatureSourceBox" Grid.Column="1" Header="來源路徑 (選填)"
                                             Text="{x:Bind ViewModel.FeatureSourcePath, Mode=TwoWay}" PlaceholderText="D:\sources\sxs" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="EnableFeatureBtn" Content="✅ 啟用功能" Command="{x:Bind ViewModel.RunDismEnableFeatureCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                                    <Button x:Name="DisableFeatureBtn" Content="❌ 停用功能" Command="{x:Bind ViewModel.RunDismDisableFeatureCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- Package Management -->
                <Expander x:Name="PackagesExpander" Header="📦 已安裝更新管理 (Package Management)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚡ 點擊「載入更新清單」後可直接搜尋 KB 號碼與套件名稱，並支援一鍵單獨解除安裝指定更新。"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ListPackagesBtn" Grid.Column="0" Command="{x:Bind ViewModel.RunDismGetPackagesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock x:Name="ListPackagesBtnText" Text="載入/重整更新清單" />
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="1" PlaceholderText="🔍 即時搜尋 KB 號碼 (例如: KB5034441)..."
                                     Text="{x:Bind ViewModel.PackageFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Empty Placeholder Hint -->
                        <Border Visibility="{x:Bind ViewModel.HasPackages, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="💡 尚未載入更新套件清單。請點擊上方「載入/重整套件清單」按鈕，系統將自動列舉所有更新套件與 KB 補丁。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView Visibility="{x:Bind ViewModel.HasPackages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                                  MaxHeight="240" SelectionMode="Single"
                                  HorizontalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WindowsPackageItem">
                                    <Grid Padding="8,4" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🗑️ 移除套件" Click="PackageRemove_Click" Padding="8,2" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander Header="進階：手動輸入套件名稱移除" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PackageNameBox" Grid.Column="0" Header="套件名稱 (Package Name)"
                                         Text="{x:Bind ViewModel.PackageName, Mode=TwoWay}" PlaceholderText="Package_for_KB..." />
                                <Button x:Name="RemovePackageBtn" Grid.Column="1" Content="🗑️ 移除套件"
                                        Command="{x:Bind ViewModel.RunDismRemovePackageCommand}" VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- Driver Export -->
                <Expander x:Name="DriverExpander" Header="💾 驅動程式備份 (Driver Export)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DriverExportBox" Grid.Column="0" Header="輸出目錄"
                                     Text="{x:Bind ViewModel.DriverExportDir, Mode=TwoWay}" PlaceholderText="D:\DriverBackup" />
                            <Button x:Name="ExportDriversBtn" Grid.Column="1" Content="💾 匯出所有驅動"
                                     Command="{x:Bind ViewModel.RunDismExportDriversCommand}" VerticalAlignment="Bottom"
                                     Style="{StaticResource AccentButtonStyle}"
                                     IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Offline System Repair (WinPE / Dual-boot) -->
                <Expander x:Name="OfflineRepairExpander" Header="🧰 WinPE 離線系統修復 (Offline Image &amp; SFC Repair)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="當系統無法開機，在 WinPE 或雙系統環境下，指定離線系統磁區目錄直接進行 DISM 映像與 SFC 檔案修復。"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineWinDirBox" Grid.Column="0" Header="離線 Windows 目錄 (Offline Windows Dir)"
                                     Text="{x:Bind ViewModel.OfflineWinDir, Mode=TwoWay}" PlaceholderText="D:\Windows" />
                            <TextBox x:Name="OfflineBootDirBox" Grid.Column="1" Header="離線開機磁碟區 (Offline Boot Dir)"
                                     Text="{x:Bind ViewModel.OfflineBootDir, Mode=TwoWay}" PlaceholderText="D:\" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OfflineDismBtn" Content="🛠️ 離線 DISM 修復 (Offline RestoreHealth)"
                                    Command="{x:Bind ViewModel.RunDismOfflineRestoreHealthCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                            <Button x:Name="OfflineSfcBtn" Content="🔍 離線 SFC 掃描修復 (Offline SFC)"
                                    Command="{x:Bind ViewModel.RunSfcOfflineCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Collapsible Live Streaming Terminal (saves 220px vertical space when collapsed) ═══ -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📟 即時修復與清理終端機輸出 (Live Console)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.ConsoleToggleLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleConsoleExpandedCommand}" Padding="8,3" FontSize="11" />
                    <Button Grid.Column="2" Content="⏹️ 停止" Command="{x:Bind ViewModel.CancelOperationCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Padding="8,3" FontSize="11" />
                    <Button Grid.Column="3" Content="清除" Command="{x:Bind ViewModel.ClearTerminalCommand}" Padding="8,3" FontSize="11" />
                </Grid>

                <ScrollViewer Grid.Row="1" Height="180"
                              Visibility="{x:Bind ViewModel.IsConsoleExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CornerRadius="6" Padding="10">
                    <TextBlock Text="{x:Bind ViewModel.TerminalOutput, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
