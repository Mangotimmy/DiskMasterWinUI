<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.SystemHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" MinHeight="100" x:Name="ConsoleRowDef" />
        </Grid.RowDefinitions>

        <!-- ═══ Top Status & Elevation Bar ═══ -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                          Width="24" Height="24" Margin="0,0,12,0" />

            <InfoBar x:Name="AdminInfoBar" Grid.Column="2" IsOpen="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                     Severity="Warning" Title="Not Admin" IsClosable="False"
                     Message="SFC and DISM require Administrator privileges.">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartAdminBtn" Content="Restart as Admin" Command="{x:Bind ViewModel.RestartAsAdminCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- ═══ 1-Click Complete System Repair Banner ═══ -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE90F;" FontSize="36"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="OneClickTitleText" Text="1-Click Complete Windows Health Repair" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                    <TextBlock Text="Executes DISM /RestoreHealth to download healthy component store packages, followed by SFC /scannow to replace corrupted files automatically."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Padding="16,10"
                        Command="{x:Bind ViewModel.RunOneClickRepairCommand}" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                        <TextBlock x:Name="StartRepairBtnText" Text="Start Full Health Repair" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Individual SFC and DISM Operations ═══ -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: SFC Tools -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="SfcTitleText" Text="System File Checker (SFC)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                    </StackPanel>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.RunSfcScanNowCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🔍 sfc /scannow" FontWeight="SemiBold" />
                            <TextBlock Text="Scans all protected OS files and replaces corrupt files from cached store."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.RunSfcVerifyOnlyCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="📋 sfc /verifyonly" FontWeight="SemiBold" />
                            <TextBlock Text="Scans integrity of all system files without repairing or making changes."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right: DISM Tools -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="DismTitleText" Text="Deployment Image Servicing (DISM)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.RunDismCheckHealthCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="⚡ CheckHealth" FontWeight="SemiBold" />
                                <TextBlock Text="Instant corruption flag check." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.RunDismScanHealthCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🔬 ScanHealth" FontWeight="SemiBold" />
                                <TextBlock Text="Deep scan of component store." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.RunDismRestoreHealthCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🛠️ RestoreHealth" FontWeight="SemiBold" />
                                <TextBlock Text="Repairs corrupted image files." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.RunDismCleanupCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🧹 Cleanup WinSxS" FontWeight="SemiBold" />
                                <TextBlock Text="Reclaims space from old packages." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ System Health Tools, Windows Update & Cleanup ═══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- ═══ Windows Update 修復與更新管理 ═══ -->
                <Expander x:Name="WindowsUpdateExpander" Header="🔄 Windows Update 修復與更新管理 (Update Repair &amp; Reset)"
                          IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <!-- Status Bar -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="更新服務狀態:" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind ViewModel.WuInfo.StatusBadge, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="SoftwareDistribution:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.WuInfo.SoftwareDistributionDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Catroot2:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.WuInfo.Catroot2Display, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="3" Content="🔄 重新整理" Command="{x:Bind ViewModel.RefreshWindowsUpdateStatusCommand}"
                                        Padding="8,3" FontSize="11" />

                                <InfoBar Grid.Row="1" Grid.ColumnSpan="4" IsOpen="{x:Bind ViewModel.WuInfo.IsRebootRequired, Mode=OneWay}"
                                         Severity="Warning" IsClosable="False" Margin="0,6,0,0"
                                         Title="需要重新開機 (Reboot Required)"
                                         Message="系統偵測到待處理之更新安裝，建議完成修復後重新啟動電腦。" />
                            </Grid>
                        </Border>

                        <TextBlock Text="針對 0x80070002、0x80070003、0x80240034 等常見錯誤碼，自動停止服務、清空佇列、重新註冊 30+ 核心元件並重置網路堆疊；重置 SoftwareDistribution 可解決更新下載停滯問題。"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <!-- Action Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.FixWindowsUpdateErrorsCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                    <TextBlock Text="🛠️ 一鍵修復 Windows Update 錯誤" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ResetSoftwareDistributionCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="📂 重建 SoftwareDistribution 資料夾" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Content="🔎 觸發更新掃描"
                                    Command="{x:Bind ViewModel.TriggerUpdateCheckCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>

                        <!-- Options & Policy Controls -->
                        <Grid ColumnSpacing="16" Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="停用 Windows Update 自動更新" FontWeight="SemiBold" />
                                <TextBlock Text="透過停用服務與寫入群組原則 NoAutoUpdate，防止系統於背景強制重啟或下載更新"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <CheckBox Grid.Column="1" Content="重建前備份舊目錄 (.bak)"
                                      IsChecked="{x:Bind ViewModel.BackupSoftwareDist, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.WuInfo.IsDisabled, Mode=OneWay}"
                                          Toggled="WindowsUpdate_Toggled"
                                          IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                          OnContent="已停用" OffContent="正常運作" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ═══ 系統暫存與垃圾深度清理 ═══ -->
                <Expander x:Name="TempCleanExpander" Header="🧹 系統暫存與垃圾深度清理 (System Temp &amp; Deep Cache Cleanup)"
                          IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <!-- Top Summary -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="可釋放空間總計:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TotalScannedTempDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsScanningTemp, Mode=OneWay}" Width="20" Height="20" Margin="0,0,8,0" />

                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ScanTempCategoriesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsScanningTemp, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="🔍 重新掃描暫存" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Items ListView -->
                        <ListView ItemsSource="{x:Bind ViewModel.TempCategories, Mode=OneWay}"
                                  MaxHeight="220" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TempCategoryItem">
                                    <Grid Padding="6,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Icon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeDisplay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Bottom Clean Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="全選"
                                      IsChecked="{x:Bind ViewModel.IsAllTempSelected, Mode=TwoWay}"
                                      Click="SelectAllTemp_Click" VerticalAlignment="Center" />

                            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.CleanSelectedTempCategoriesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="🧹 一鍵清理已勾選暫存項目" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Content="🚀 Windows 磁碟清理 (Cleanmgr)"
                                    Command="{x:Bind ViewModel.RunCleanmgrCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Advanced Cleanup -->
                <Expander x:Name="AdvCleanupExpander" Header="🧹 進階清理 (Advanced Cleanup)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Button x:Name="AnalyzeStoreBtn" Content="📊 分析元件存放區 (AnalyzeComponentStore)"
                                Command="{x:Bind ViewModel.RunDismAnalyzeStoreCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        <Button x:Name="ResetBaseBtn" Content="🗑️ 深度清理 /ResetBase (不可逆)"
                                Command="{x:Bind ViewModel.RunDismResetBaseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                    </StackPanel>
                </Expander>

                <!-- RestoreHealth with Source -->
                <Expander x:Name="SourceRepairExpander" Header="🔧 指定修復來源 (Repair with Source)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="修復錯誤 0x800f081f：指定 WIM/ESD 作為修復來源。" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="RepairSourceBox" Header="修復來源路徑 (如 wim:D:\sources\install.wim:1)"
                                 Text="{x:Bind ViewModel.RepairSourcePath, Mode=TwoWay}" PlaceholderText="wim:D:\sources\install.wim:1" />
                        <Button x:Name="RestoreWithSourceBtn" Content="🛠️ 使用來源修復 RestoreHealth"
                                Command="{x:Bind ViewModel.RunDismRestoreWithSourceCommand}" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                    </StackPanel>
                </Expander>

                <!-- Windows Features -->
                <Expander x:Name="FeaturesExpander" Header="⚙️ Windows 功能管理 (Features)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚡ 點擊「載入功能清單」後即可即時搜尋、點選並一鍵開關系統功能（如 NetFx3、Hyper-V、WSL 等），無需再死記名稱或切換到終端機。"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ListFeaturesBtn" Grid.Column="0" Command="{x:Bind ViewModel.RunDismGetFeaturesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock x:Name="ListFeaturesBtnText" Text="載入/重整功能清單" />
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="1" PlaceholderText="🔍 即時搜尋功能 (例如: IIS, NetFx, WSL, Virtual...)"
                                     Text="{x:Bind ViewModel.FeatureFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Empty Placeholder Hint -->
                        <Border Visibility="{x:Bind ViewModel.HasFeatures, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="💡 尚未載入功能清單。請點擊上方「載入/重整功能清單」按鈕，系統將自動透過 DISM 讀取本機所有功能並以互動卡片呈現。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView Visibility="{x:Bind ViewModel.HasFeatures, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.FilteredFeatures, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFeature, Mode=TwoWay}"
                                  MaxHeight="260" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WindowsFeatureItem">
                                    <Grid Padding="8,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind StateBadge}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FeatureName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="{x:Bind ActionButtonLabel}" Click="FeatureToggle_Click" Padding="8,2" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander Header="進階：手動輸入或指定 SxS 來源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FeatureNameBox" Grid.Column="0" Header="功能名稱 (Feature Name)"
                                             Text="{x:Bind ViewModel.FeatureName, Mode=TwoWay}" PlaceholderText="e.g. NetFx3, Microsoft-Windows-Subsystem-Linux" />
                                    <TextBox x:Name="FeatureSourceBox" Grid.Column="1" Header="來源路徑 (選填)"
                                             Text="{x:Bind ViewModel.FeatureSourcePath, Mode=TwoWay}" PlaceholderText="D:\sources\sxs" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="EnableFeatureBtn" Content="✅ 啟用功能" Command="{x:Bind ViewModel.RunDismEnableFeatureCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                                    <Button x:Name="DisableFeatureBtn" Content="❌ 停用功能" Command="{x:Bind ViewModel.RunDismDisableFeatureCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- Package Management -->
                <Expander x:Name="PackagesExpander" Header="📦 已安裝更新管理 (Package Management)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚡ 點擊「載入更新清單」後可直接搜尋 KB 號碼與套件名稱，並支援一鍵單獨解除安裝指定更新。"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ListPackagesBtn" Grid.Column="0" Command="{x:Bind ViewModel.RunDismGetPackagesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock x:Name="ListPackagesBtnText" Text="載入/重整更新清單" />
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="1" PlaceholderText="🔍 即時搜尋 KB 號碼 (例如: KB5034441)..."
                                     Text="{x:Bind ViewModel.PackageFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Empty Placeholder Hint -->
                        <Border Visibility="{x:Bind ViewModel.HasPackages, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="12" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="💡 尚未載入更新套件清單。請點擊上方「載入/重整套件清單」按鈕，系統將自動列舉所有更新套件與 KB 補丁。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView Visibility="{x:Bind ViewModel.HasPackages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                                  MaxHeight="240" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WindowsPackageItem">
                                    <Grid Padding="8,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🗑️ 移除套件" Click="PackageRemove_Click" Padding="8,2" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander Header="進階：手動輸入套件名稱移除" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PackageNameBox" Grid.Column="0" Header="套件名稱 (Package Name)"
                                         Text="{x:Bind ViewModel.PackageName, Mode=TwoWay}" PlaceholderText="Package_for_KB..." />
                                <Button x:Name="RemovePackageBtn" Grid.Column="1" Content="🗑️ 移除套件"
                                        Command="{x:Bind ViewModel.RunDismRemovePackageCommand}" VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- Driver Export -->
                <Expander x:Name="DriverExpander" Header="💾 驅動程式備份 (Driver Export)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DriverExportBox" Grid.Column="0" Header="輸出目錄"
                                     Text="{x:Bind ViewModel.DriverExportDir, Mode=TwoWay}" PlaceholderText="D:\DriverBackup" />
                            <Button x:Name="ExportDriversBtn" Grid.Column="1" Content="💾 匯出所有驅動"
                                     Command="{x:Bind ViewModel.RunDismExportDriversCommand}" VerticalAlignment="Bottom"
                                     Style="{StaticResource AccentButtonStyle}"
                                     IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Offline System Repair (WinPE / Dual-boot) -->
                <Expander x:Name="OfflineRepairExpander" Header="🧰 WinPE 離線系統修復 (Offline Image &amp; SFC Repair)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="當系統無法開機，在 WinPE 或雙系統環境下，指定離線系統磁區目錄直接進行 DISM 映像與 SFC 檔案修復。"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineWinDirBox" Grid.Column="0" Header="離線 Windows 目錄 (Offline Windows Dir)"
                                     Text="{x:Bind ViewModel.OfflineWinDir, Mode=TwoWay}" PlaceholderText="D:\Windows" />
                            <TextBox x:Name="OfflineBootDirBox" Grid.Column="1" Header="離線開機磁碟區 (Offline Boot Dir)"
                                     Text="{x:Bind ViewModel.OfflineBootDir, Mode=TwoWay}" PlaceholderText="D:\" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OfflineDismBtn" Content="🛠️ 離線 DISM 修復 (Offline RestoreHealth)"
                                    Command="{x:Bind ViewModel.RunDismOfflineRestoreHealthCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                            <Button x:Name="OfflineSfcBtn" Content="🔍 離線 SFC 掃描修復 (Offline SFC)"
                                    Command="{x:Bind ViewModel.RunSfcOfflineCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Splitter Separator -->
        <Border Grid.Row="4" Height="8" Background="Transparent" VerticalAlignment="Center">
            <Rectangle Height="2" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Border>

        <!-- ═══ Live Streaming Terminal ═══ -->
        <Grid Grid.Row="5" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Live Console Output" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="⏹️ Stop / Cancel" Command="{x:Bind ViewModel.CancelOperationCommand}"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Clear Output" Command="{x:Bind ViewModel.ClearTerminalCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="12">
                <TextBlock Text="{x:Bind ViewModel.TerminalOutput, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
