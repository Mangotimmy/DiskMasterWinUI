<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.BootManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:controls="using:DiskMasterWinUI.Controls"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Top Control Bar ═══ -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshEntriesCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshBcdBtnText" Text="Refresh BCD Entries" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Command="{x:Bind ViewModel.ScanWindowsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                    <TextBlock x:Name="DeepScanBtnText" Text="🔍 全盤探測並掛載開機 (Deep Scan)" />
                </StackPanel>
            </Button>

            <Button x:Name="MountEspBtn" Grid.Column="2" Content="💿 掛載 ESP" Command="{x:Bind ViewModel.MountEspCommand}"
                    ToolTipService.ToolTip="掛載 ESP 系統開機分割區至 S: (mountvol /s)" />
            <Button x:Name="UnmountEspBtn" Grid.Column="3" Content="⏏️ 卸載 ESP" Command="{x:Bind ViewModel.UnmountEspCommand}"
                    ToolTipService.ToolTip="卸載 ESP 開機分割區 (mountvol /d)" />
            <Button x:Name="BcdExportBtn" Grid.Column="4" Content="💾 備份 BCD" Command="{x:Bind ViewModel.BcdExportCommand}"
                    ToolTipService.ToolTip="備份當前 BCD 設定至檔案" />
            <Button x:Name="BcdImportBtn" Grid.Column="5" Content="📥 還原 BCD" Command="{x:Bind ViewModel.BcdImportCommand}"
                    ToolTipService.ToolTip="從備份檔案還原 BCD 設定" />

            <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="7" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- ═══ Movable TabView ═══ -->
        <TabView x:Name="BootTabView" Grid.Row="1"
                 CanReorderTabs="True" CanDragTabs="True"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>

            <!-- ── Tab 1: Visual BCD Management & Searcher ── -->
            <TabViewItem x:Name="TabBootEntries" Header="開機項目管理 (Boot Entries)" IsClosable="False">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Search Filter & List -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Live Search Filter Box -->
                            <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search by OS Name, UUID, Device..."
                                     Text="{x:Bind ViewModel.SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <!-- Search icon inside -->
                                </TextBox.Resources>
                            </TextBox>

                            <!-- BCD Items ListView -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DisplayEntries, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BootEntryDetail">
                                        <Grid Padding="8,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="20"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsDefault, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="DEFAULT" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Discovered Windows Expander -->
                            <Expander Grid.Row="2" Header="Discovered Offline Windows" IsExpanded="False"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6" Padding="4">
                                    <ListView ItemsSource="{x:Bind ViewModel.DiscoveredWindows, Mode=OneWay}" MaxHeight="120">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnSpacing="8" Padding="2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" FontSize="12" />
                                                    <Button Grid.Column="1" Content="➕ Add to BCD"
                                                            Padding="6,2" FontSize="11"
                                                            Click="AddToBcd_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <controls:AdobeSplitter Grid.Column="1" Orientation="Vertical" Margin="4,0" />

                    <!-- Right: Entry Editor & Actions -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="EditEntryTitle" Text="Edit Boot Entry" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>

                                <!-- Rename Description -->
                                <TextBox x:Name="DescBox" Header="Description (Display Name in Boot Menu)"
                                         Text="{x:Bind ViewModel.EditDescriptionText, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveDescBtn" Content="💾 Save Description" Command="{x:Bind ViewModel.SaveDescriptionCommand}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="SetDefaultBtn" Content="⭐ Set as Default OS" Command="{x:Bind ViewModel.SetDefaultEntryCommand}" />
                                    <Button x:Name="CloneEntryBtn" Content="📋 Clone Entry" Command="{x:Bind ViewModel.CloneEntryCommand}" />
                                    <Button x:Name="DeleteEntryBtn" Content="🗑️ Delete Entry" Command="{x:Bind ViewModel.DeleteEntryCommand}" />
                                </StackPanel>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                                <!-- Details Readout -->
                                <TextBlock Text="Raw Entry Specification" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ScrollViewer MaxHeight="260" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                              CornerRadius="6" Padding="12">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedEntry.RawText, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ── Tab 2: Build New Boot Partition Wizard ── -->
            <TabViewItem x:Name="TabBuildBoot" Header="全新分割區建置開機引導 (Build New Boot Partition)" IsClosable="False">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Wizard Configuration Form -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC06;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="New Boot Partition Wizard" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>

                                <TextBlock Text="Create a fresh, standalone EFI System Partition (ESP) or active MBR boot partition from any Windows source."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                <!-- Source Windows Directory -->
                                <TextBox Header="Source Windows Directory"
                                         Text="{x:Bind ViewModel.NewBootSourcePath, Mode=TwoWay}"
                                         PlaceholderText="e.g. C:\Windows or D:\Windows" />

                                <!-- Target Disk Number -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Target Disk Number"
                                             Text="{x:Bind ViewModel.NewBootDiskNumber, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Partition Size (MB)"
                                             Text="{x:Bind ViewModel.NewBootSizeMB, Mode=TwoWay}" />
                                </Grid>

                                <!-- Firmware Boot Mode -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Header="Firmware Mode" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FirmwareOptions}"
                                              SelectedItem="{x:Bind ViewModel.NewBootFirmware, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Temp Letter"
                                             Text="{x:Bind ViewModel.NewBootLetter, Mode=TwoWay}" />
                                </Grid>

                                <ToggleSwitch Header="建置完成後卸載暫存磁碟機代號 (Unmount Temp Letter)"
                                              IsOn="{x:Bind ViewModel.NewBootRemoveLetter, Mode=TwoWay}"
                                              OffContent="保留代號" OnContent="自動卸載" />

                                <!-- Execute Button -->
                                <Button Command="{x:Bind ViewModel.BuildNewBootPartitionCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="12" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE90F;" FontSize="16" />
                                        <TextBlock x:Name="BuildBootBtnText" Text="🚀 Build New Boot Manager on Partition" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Execution Log Console -->
                    <Border Grid.Column="1" Margin="12,0,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Build Output &amp; Verification Console" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBuildingBoot, Mode=OneWay}" Width="16" Height="16" Margin="8,0,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="6" Padding="12">
                                <TextBlock Text="{x:Bind ViewModel.NewBootLog, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ── Tab 3: Global Boot Settings ── -->
            <TabViewItem x:Name="TabGlobalSettings" Header="全域開機設定 (Global Settings)" IsClosable="False">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20" Margin="0,10,16,20" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Boot Configuration Data (BCD) Global Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <!-- Timeout -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Boot Menu Timeout (Seconds)" FontWeight="SemiBold" />
                            <Slider Minimum="0" Maximum="60" StepFrequency="1"
                                    Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.TimeoutSeconds, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <!-- Policy -->
                        <ToggleSwitch Header="Boot Menu Policy (Metro vs Legacy F8)"
                                      IsOn="{x:Bind ViewModel.IsModernMenuPolicy, Mode=TwoWay}"
                                      OnContent="Standard (Modern Blue Metro Menu)"
                                      OffContent="Legacy (Classic Text/F8 Menu)" />

                        <Button x:Name="ApplyGlobalSettingsBtn" Content="💾 Apply Global Settings" Command="{x:Bind ViewModel.ApplyGlobalSettingsCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </TabViewItem>

            <!-- ── Tab 4: MSConfig 安全開機與旗標 (Safe Boot & Advanced Boot Flags) ── -->
            <TabViewItem x:Name="TabSafeBoot" Header="🛡️ 安全開機 (Safe Boot)" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">
                        <!-- Hero Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7EF;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="SafeBootTitleText" Text="MSConfig 系統安全開機模式與進階開機旗標" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="SafeBootSubtitleText"
                                           Text="直接調用 Windows BCD 控制底層啟動參數，支援 Minimal、Network、AlternateShell、DsRepair 安全模式，以及無 GUI 開機、開機記錄檔與測試簽署。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{x:Bind ViewModel.LoadSafeBootConfigCommand}" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock x:Name="LoadSafeBootBtnText" Text="🔄 讀取當前開機設定" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.ApplySafeBootConfigCommand}"
                                            Style="{StaticResource AccentButtonStyle}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                                            <TextBlock x:Name="ApplySafeBootBtnText" Text="💾 套用安全開機設定" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SafeBootOperationStatus, Mode=OneWay}"
                                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Safe Boot Mode Selection Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SafeBootModeHeader" Text="安全開機模式 (Safe Boot Mode)" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ComboBox x:Name="SafeBootModeCombo"
                                          SelectedValue="{x:Bind ViewModel.SafeBootMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="正常開機 (Normal Boot - 已清除安全開機旗標)" Tag="Normal" />
                                    <ComboBoxItem Content="最小安全開機 (Minimal - 僅載入必要核心驅動)" Tag="Minimal" />
                                    <ComboBoxItem Content="具備命令提示字元 (Alternate Shell - 命令列環境)" Tag="AlternateShell" />
                                    <ComboBoxItem Content="具備網路功能 (Network - 支援網路通訊驅動)" Tag="Network" />
                                    <ComboBoxItem Content="目錄服務修復 (Active Directory Repair - dsrepair)" Tag="DsRepair" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Boot Flags Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AdvancedFlagsHeader" Text="進階開機旗標與診斷開機 (Advanced Boot Flags)" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <ToggleSwitch x:Name="NoGuiBootSwitch"
                                              Header="無 GUI 開機 (No GUI Boot / noguiboot)"
                                              IsOn="{x:Bind ViewModel.NoGuiBoot, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="BootLogSwitch"
                                              Header="開機記錄檔 (Boot Log / bootlog - 輸出至 ntbtlog.txt)"
                                              IsOn="{x:Bind ViewModel.BootLog, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="BaseVideoSwitch"
                                              Header="基本視訊 (Base Video / basevideo - 使用標準 VGA 驅動)"
                                              IsOn="{x:Bind ViewModel.BaseVideo, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="SosSwitch"
                                              Header="顯示作業系統開機資訊 (OS Boot Information / sos)"
                                              IsOn="{x:Bind ViewModel.Sos, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="TestSigningSwitch"
                                              Header="測試簽署模式 (Test Signing / testsigning)"
                                              IsOn="{x:Bind ViewModel.TestSigning, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="NoIntegritySwitch"
                                              Header="停用驅動程式完整性檢查 (No Integrity Checks / nointegritychecks)"
                                              IsOn="{x:Bind ViewModel.NoIntegrityChecks, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="HypervisorSwitch"
                                              Header="Hypervisor 虛擬化平台 (Hypervisor Launch / auto vs off)"
                                              IsOn="{x:Bind ViewModel.HypervisorEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
