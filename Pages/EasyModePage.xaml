<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.EasyModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:controls="using:DiskMasterWinUI.Controls"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Top Bar ═══ -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshDisksCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshDisksBtnText" Text="Refresh Disks" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />

            <InfoBar x:Name="AdminInfoBar" Grid.Column="3" IsOpen="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                     Severity="Warning" Title="Not Admin" IsClosable="False"
                     Message="Run as Admin for disk operations.">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartAdminBtn" Content="Restart as Admin" Command="{x:Bind ViewModel.RestartAsAdminCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- ═══ Hero System Drive Status & One-Click Quick Actions (Fluent 2) ═══ -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Health & Temperature Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="8,4" CornerRadius="6">
                        <TextBlock x:Name="HeroStatusLabel" Text="🛡️ 系統狀態:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeroStatusValue" Text="健康良好" FontSize="12" FontWeight="SemiBold" Foreground="#107C41" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="8,4" CornerRadius="6">
                        <TextBlock x:Name="HeroTempLabel" Text="🌡️ 硬碟溫度:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeroTempValue" Text="即時監控中" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="8,4" CornerRadius="6">
                        <TextBlock x:Name="HeroBitLockerLabel" Text="🔒 BitLocker:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeroBitLockerValue" Text="安全守護中" FontSize="12" FontWeight="SemiBold" Foreground="#107C41" />
                    </StackPanel>
                </StackPanel>

                <!-- One-Click Quick Action Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="HeroHealthCheckBtn" Content="⚡ 一鍵健康體檢" Command="{x:Bind ViewModel.OneClickHealthCheckCommand}"
                            Padding="10,4" FontSize="12" />
                    <Button x:Name="HeroBootRepairBtn" Content="🔧 快速修復引導" Command="{x:Bind ViewModel.BootRepairAutoCommand}"
                            Padding="10,4" FontSize="12" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="HeroDiskCleanBtn" Content="🧹 磁碟清理" Command="{x:Bind ViewModel.CleanDiskCommand}"
                            Padding="10,4" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Adobe-Style Resizable Workspace ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Disks List (Resizable) -->
                <ColumnDefinition x:Name="ColDisks" Width="280" MinWidth="180" MaxWidth="600" />
                <!-- Adobe Vertical Splitter (Drag ↔) -->
                <ColumnDefinition Width="Auto" />
                <!-- Right Workspace -->
                <ColumnDefinition x:Name="ColWorkspace" Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- ── Left: Disks Panel ── -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="DisksPanelTitle" Text="Disks" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Disks, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedDisk, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiskInfo">
                                <Grid Padding="6,8" ColumnSpacing="10">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="🔍 深入檢視磁碟詳細規格" Click="DiskContext_Detail_Click" />
                                            <MenuFlyoutItem Text="🩺 S.M.A.R.T. 健康檢查" Click="DiskContext_Smart_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="🧹 清除磁碟分區表 (Clean)" Click="DiskContext_Clean_Click" />
                                            <MenuFlyoutItem Text="🔄 轉換為 GPT 樣式" Click="DiskContext_ConvertGpt_Click" />
                                            <MenuFlyoutItem Text="🔄 轉換為 MBR 樣式" Click="DiskContext_ConvertMbr_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="📋 複製磁碟資訊摘要" Click="DiskContext_CopySummary_Click" />
                                            <MenuFlyoutItem Text="📂 開啟 Windows 磁碟管理" Click="DiskContext_OpenDiskMgmt_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="24"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Summary}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ── Adobe Vertical Splitter (Drag ↔) ── -->
            <controls:AdobeSplitter Grid.Column="1"
                                    Orientation="Vertical"
                                    TargetColumn="{x:Bind ColDisks}"
                                    MinSize="180"
                                    MaxSize="600"
                                    Margin="4,0" />

            <!-- ── Right Workspace ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Top: Interactive Partition Map & Mouse Sizer -->
                    <RowDefinition x:Name="RowPartitionMap" Height="260" MinHeight="140" MaxHeight="600" />
                    <!-- Adobe Horizontal Splitter 1 (Drag ↕) -->
                    <RowDefinition Height="Auto" />
                    <!-- Middle: Tools & Suggested Command Preview -->
                    <RowDefinition x:Name="RowTools" Height="*" MinHeight="120" />
                    <!-- Adobe Horizontal Splitter 2 (Drag ↕) -->
                    <RowDefinition Height="Auto" />
                    <!-- Bottom: Output Terminal Console -->
                    <RowDefinition x:Name="RowConsole" Height="170" MinHeight="50" MaxHeight="500" />
                </Grid.RowDefinitions>

                <!-- 1. Interactive Partition Map & Mouse Sizer Panel -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Header with Legend -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="PartitionMapTitle" Text="Graphical Partition Map &amp; Sizer" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                                </StackPanel>

                                <!-- Legend -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle Width="8" Height="8" Fill="#1976D2" RadiusX="2" RadiusY="2" />
                                        <TextBlock x:Name="LegendEfiText" Text="EFI" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle Width="8" Height="8" Fill="#00897B" RadiusX="2" RadiusY="2" />
                                        <TextBlock x:Name="LegendBootText" Text="Boot/OS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle Width="8" Height="8" Fill="#2E7D32" RadiusX="2" RadiusY="2" />
                                        <TextBlock x:Name="LegendDataText" Text="Data" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle Width="8" Height="8" Fill="#E65100" RadiusX="2" RadiusY="2" />
                                        <TextBlock x:Name="LegendRecoveryText" Text="Recovery" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle Width="8" Height="8" Fill="#424242" RadiusX="2" RadiusY="2" />
                                        <TextBlock x:Name="LegendFreeText" Text="Free" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal Interactive Partition Bar -->
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedDisk.VisualBlocks, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedBlock, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      Height="106"
                                      Padding="0,4,0,18"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,6,0" />
                                        <Setter Property="MinHeight" Value="64" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PartitionBlock">
                                        <Border Background="{x:Bind BackgroundBrush}"
                                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="{x:Bind BorderThicknessValue, Mode=OneWay}"
                                                CornerRadius="6" Padding="12,8" 
                                                Width="{x:Bind DisplayWidth, Mode=OneWay}"
                                                MinWidth="110" Height="64">
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind HeaderText}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SubtitleText}" FontSize="11"
                                                           Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Selected Partition Badge -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedBlockBadge, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Mouse Move & Resize Slider Section with KPI Cards -->
                            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <Slider Minimum="10" Maximum="100" StepFrequency="1"
                                            IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.ResizeSliderValue, Mode=TwoWay}" />
                                    <!-- Quick Size Preset Chips (Zero-Keyboard) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="QuickSizeLabel" Text="Quick Size:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button Content="10 GB" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="10" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                        <Button Content="20 GB" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="20" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                        <Button Content="50 GB" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="50" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                        <Button Content="100 GB" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="100" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                        <Button Content="50%" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="50%" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                        <Button Content="Max" Command="{x:Bind ViewModel.ApplySizePresetCommand}" CommandParameter="Max" Padding="8,3" FontSize="11" IsEnabled="{x:Bind ViewModel.IsResizeSliderEnabled, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Target Size KPI Card -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,6" MinWidth="130" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TargetSizeLabel" Text="Target Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ResizeTargetSizeDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                </Border>

                                <!-- Operation Delta KPI Card -->
                                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,6" MinWidth="140" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="OperationDeltaLabel" Text="Operation Delta" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ResizeDeltaDisplay, Mode=OneWay}"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── Adobe Horizontal Splitter 1 (Drag ↕) ── -->
                <controls:AdobeSplitter Grid.Row="1"
                                        Orientation="Horizontal"
                                        TargetRow="{x:Bind RowPartitionMap}"
                                        MinSize="140"
                                        MaxSize="600"
                                        Margin="0,4" />

                <!-- 2. Middle: Suggested Command Preview + Management Tools -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="12">
                        <!-- Suggested DiskPart Command -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="SuggestedCommandTitle" Text="Suggested DiskPart Command" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                    </StackPanel>

                                    <Button x:Name="CopyCmdBtn" Grid.Column="1" Content="📋 Copy" Command="{x:Bind ViewModel.CopySuggestedCommandCommand}" Margin="0,0,8,0" Padding="8,4" FontSize="12" />
                                    <Button x:Name="ExecuteCmdBtn" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                            Content="▶️ Execute Command"
                                            Command="{x:Bind ViewModel.ExecuteSuggestedCommandCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                            Padding="10,4" FontSize="12" />
                                </Grid>

                                <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80"
                                         Text="{x:Bind ViewModel.SuggestedCommandText, Mode=OneWay}"
                                         FontFamily="Consolas" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Partition & Volume Management Tools -->
                        <Expander x:Name="ToolsExpander" Header="Partition &amp; Volume Management Tools" IsExpanded="True"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <!-- Format & Drive Letter -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="FsBox" Grid.Column="0" Header="File System"
                                              ItemsSource="{x:Bind ViewModel.FileSystemOptions}"
                                              SelectedItem="{x:Bind ViewModel.FormatFileSystem, Mode=TwoWay}" />

                                    <ComboBox x:Name="ClusterBox" Grid.Column="1" Header="Cluster Size"
                                              ItemsSource="{x:Bind ViewModel.ClusterSizes}"
                                              SelectedItem="{x:Bind ViewModel.SelectedClusterSize, Mode=TwoWay}" />

                                    <Grid Grid.Column="2" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="LabelBox" Grid.Column="0" Header="Volume Label"
                                                 Text="{x:Bind ViewModel.FormatLabel, Mode=TwoWay}" MinWidth="110" />
                                        <Button x:Name="SetLabelBtn" Grid.Column="1" Content="🏷️" VerticalAlignment="Bottom"
                                                Command="{x:Bind ViewModel.SetVolumeLabelCommand}"
                                                ToolTipService.ToolTip="變更磁碟區標籤 (免格式化直接重命名)" />
                                    </Grid>

                                    <ToggleSwitch x:Name="QuickFormatSwitch" Grid.Column="3"
                                                  IsOn="{x:Bind ViewModel.QuickFormat, Mode=TwoWay}"
                                                  OffContent="完整格式化" OnContent="快速格式化"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,2" />

                                    <Button x:Name="FormatBtn" Grid.Column="4" Content="💾 Format"
                                            Command="{x:Bind ViewModel.FormatVolumeCommand}" VerticalAlignment="Bottom" />

                                    <ComboBox x:Name="LetterBox" Grid.Column="5" Header="Drive Letter"
                                              ItemsSource="{x:Bind ViewModel.AvailableLetters}"
                                              SelectedItem="{x:Bind ViewModel.AssignLetter, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                        <Button x:Name="AssignLetterBtn" Content="📌 Assign"
                                                Command="{x:Bind ViewModel.AssignLetterCommand}" />
                                        <Button x:Name="RemoveLetterBtn" Content="🚫 Remove"
                                                Command="{x:Bind ViewModel.RemoveLetterCommand}" />
                                        <Button x:Name="DetailVolumeBtn" Content="ℹ️ Detail"
                                                Command="{x:Bind ViewModel.DetailVolumeCommand}" />
                                        <Button x:Name="SetVolReadOnlyBtn" Content="🔒 Read-Only"
                                                Command="{x:Bind ViewModel.SetVolumeReadOnlyCommand}"
                                                ToolTipService.ToolTip="Set Volume Read-Only" />
                                        <Button x:Name="ClearVolReadOnlyBtn" Content="🔓 Clear R/O"
                                                Command="{x:Bind ViewModel.ClearVolumeReadOnlyCommand}"
                                                ToolTipService.ToolTip="Clear Volume Read-Only" />
                                    </StackPanel>
                                </Grid>

                                <!-- Quick Label Chips (Zero-Keyboard) -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="QuickLabelsLabel" Text="Quick Labels:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Windows" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="Windows" Padding="6,2" FontSize="11" />
                                    <Button Content="Data" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="Data" Padding="6,2" FontSize="11" />
                                    <Button Content="Backup" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="Backup" Padding="6,2" FontSize="11" />
                                    <Button Content="Games" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="Games" Padding="6,2" FontSize="11" />
                                    <Button Content="Storage" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="Storage" Padding="6,2" FontSize="11" />
                                    <Button Content="USB" Command="{x:Bind ViewModel.ApplyLabelPresetCommand}" CommandParameter="USB" Padding="6,2" FontSize="11" />
                                </StackPanel>

                                <!-- Create, Delete, Clean -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PartSizeBox" Grid.Column="0" Header="New Size (MB, blank=Max)"
                                             Text="{x:Bind ViewModel.PartitionSizeMB, Mode=TwoWay}"
                                             PlaceholderText="Full unallocated" />

                                    <Button x:Name="CreatePartBtn" Grid.Column="1" Content="➕ Create Primary"
                                            Command="{x:Bind ViewModel.CreatePartitionCommand}" VerticalAlignment="Bottom" />

                                    <Button x:Name="ExtendVolumeBtn" Grid.Column="2" Content="↔️ Extend"
                                            Command="{x:Bind ViewModel.ExtendVolumeCommand}" VerticalAlignment="Bottom" />

                                    <Button x:Name="DeletePartBtn" Grid.Column="3" Content="🗑️ Delete Partition"
                                            Command="{x:Bind ViewModel.DeletePartitionCommand}" VerticalAlignment="Bottom" />

                                    <Button x:Name="CleanDiskBtn" Grid.Column="4" Content="🧹 Clean Disk"
                                            Command="{x:Bind ViewModel.CleanDiskCommand}" VerticalAlignment="Bottom" />

                                    <Button x:Name="DetailDiskBtn" Grid.Column="5" Content="ℹ️ Detail"
                                            Command="{x:Bind ViewModel.DetailDiskCommand}" VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- Advanced Partition & Layout Actions -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StdUefiLayoutBtn" Content="⚡ 一鍵標準 UEFI 4分區佈局"
                                            Command="{x:Bind ViewModel.CreateStandardUefiLayoutCommand}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="CreateWinReBtn" Content="🩹 建立 WinRE 修復磁區"
                                            Command="{x:Bind ViewModel.CreateRecoveryPartitionCommand}" />
                                    <Button x:Name="ExtendFsBtn" Content="↔️ 延伸檔案系統 (Extend FS)"
                                            Command="{x:Bind ViewModel.ExtendFilesystemCommand}" />
                                    <Button x:Name="ShrinkQueryBtn" Content="🔍 查詢最大可縮減空間"
                                            Command="{x:Bind ViewModel.ShrinkQueryMaxCommand}" />
                                </StackPanel>

                                <!-- Boot Repair -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WinDirBox" Grid.Column="0" Header="Windows Directory"
                                             Text="{x:Bind ViewModel.WindowsDirectory, Mode=TwoWay}" />
                                    <Button x:Name="AutoBootBtn" Grid.Column="1" Content="🚀 Auto Boot Repair"
                                             Command="{x:Bind ViewModel.BootRepairAutoCommand}"
                                             Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Adobe Horizontal Splitter 2 (Drag ↕) ── -->
                <controls:AdobeSplitter Grid.Row="3"
                                        Orientation="Horizontal"
                                        TargetRow="{x:Bind RowConsole}"
                                        ResizeMode="TargetSecond"
                                        MinSize="50"
                                        MaxSize="500"
                                        Margin="0,4" />

                <!-- 3. Bottom: Output Log Console -->
                <Border Grid.Row="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header with Clear Button -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="OutputLogTitle" Text="Output Log" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                            </StackPanel>
                            <Button x:Name="ClearLogBtn" Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearLogCommand}" Padding="8,2" FontSize="11" />
                        </Grid>

                        <!-- Terminal Text Output -->
                        <ScrollViewer Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      CornerRadius="4" Padding="8">
                            <ScrollViewer.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="📋 複製全部終端記錄" Click="LogContext_CopyAll_Click" />
                                    <MenuFlyoutItem Text="🧹 清除記錄 (Ctrl+L)" Command="{x:Bind ViewModel.ClearLogCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="💾 另存日誌文字檔 (.txt)" Click="LogContext_SaveAs_Click" />
                                </MenuFlyout>
                            </ScrollViewer.ContextFlyout>
                            <TextBlock Text="{x:Bind ViewModel.OutputLog, Mode=OneWay}" 
                                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
