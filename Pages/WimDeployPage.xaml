<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.WimDeployPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:services="using:DiskMasterWinUI.Services"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="PageHeaderTitle" Text="WIM/ESD 系統映像部署與 Windows 附加元件"
                           Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" MinWidth="460" MaxWidth="720" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Options & Parameters -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- 🌐 Official Windows ISO / WIM Downloader Expander -->
                        <Expander Header="🌐 下載微軟官方 Windows 系統映像"
                                  IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10" Padding="0,4,0,0">
                                <!-- 下載模式切換器 (Mode Selector: Dynamic Rufus vs Classic MSDN) -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4">
                                    <RadioButtons SelectedIndex="{x:Bind ViewModel.DownloadModeIndex, Mode=TwoWay}"
                                                  MaxColumns="2" HorizontalAlignment="Stretch">
                                        <RadioButton x:Name="RufusModeRadio" Content="⚡ 微軟官方直鏈" FontSize="12" />
                                        <RadioButton x:Name="MsdnModeRadio" Content="📦 經典官方發行庫" FontSize="12" />
                                    </RadioButtons>
                                </Border>

                                <!-- ⚡ Mode 0: 微軟官方原版直鏈獲取引擎 (Rufus Fido) -->
                                <Border Visibility="{x:Bind ViewModel.IsDynamicDownloadMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="10">
                                        <!-- Card Header: 2-Row Layout (Zero Clipping) -->
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Title and Progress Ring -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock x:Name="RufusEngineHeaderTitle" Text="⚡ 微軟官方原版直鏈引擎" FontWeight="Bold" FontSize="13" />
                                                </StackPanel>
                                                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsFetchingRufusUrl, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Row 1: Auto-fetch checkbox and Refresh button -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoFetchCheck" Grid.Column="0" Content="選項變更時自動獲取最新直鏈"
                                                          IsChecked="{x:Bind ViewModel.AutoFetchDirectUrl, Mode=TwoWay}"
                                                          FontSize="11" MinHeight="0" Padding="4,0,0,0" VerticalAlignment="Center"
                                                          ToolTipService.ToolTip="選取作業系統、版本或語言時自動連線微軟官方取得最新有效直鏈" />
                                                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshWindowsVersionsCommand}"
                                                        ToolTipService.ToolTip="向微軟雲端與 Fido 腳本更新最新 Windows 11/10 發行版本清單"
                                                        Padding="8,3" MinHeight="0" FontSize="11"
                                                        IsEnabled="{x:Bind ViewModel.IsRefreshingVersions, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                                        <TextBlock x:Name="RefreshVersionsText" Text="🔄 檢查最新版本" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <!-- Selectors Row 1: OS and Architecture side-by-side -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="RufusOsBox" Grid.Column="0" Header="作業系統" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind ViewModel.RufusOsList}"
                                                      SelectedItem="{x:Bind ViewModel.SelectedRufusOs, Mode=TwoWay}" />
                                            <ComboBox x:Name="RufusArchBox" Grid.Column="1" Header="架構" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind ViewModel.RufusArchList}"
                                                      SelectedItem="{x:Bind ViewModel.SelectedRufusArch, Mode=TwoWay}" />
                                        </Grid>

                                        <!-- Selectors Row 2: Release (Full Width, completely visible build string) -->
                                        <ComboBox x:Name="RufusReleaseBox" Header="版本號" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.RufusReleaseList, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedRufusRelease, Mode=TwoWay}" />

                                        <!-- Selectors Row 3: Official Language (Full Width) -->
                                        <ComboBox x:Name="RufusLanguageBox" Header="官方語言" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.RufusLanguageList}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedRufusLanguage, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="services:RufusLanguageItem">
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Direct Link Box -->
                                        <TextBox x:Name="RufusDirectUrlBox" Header="微軟官方原版直鏈"
                                                 Text="{x:Bind ViewModel.RufusDirectUrl, Mode=TwoWay}"
                                                 PlaceholderText="選取上方版本或點擊下方按鈕，由微軟官方自動簽發直鏈..." />

                                        <!-- Direct Link Quick Actions -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="⚡ 獲取直鏈"
                                                    Command="{x:Bind ViewModel.FetchRufusDirectUrlCommand}"
                                                    IsEnabled="{x:Bind ViewModel.IsFetchingRufusUrl, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                                    HorizontalAlignment="Stretch" FontSize="11" Padding="4,4" />
                                            <Button Grid.Column="1" Content="📋 貼上直鏈"
                                                    Command="{x:Bind ViewModel.PasteDirectLinkCommand}"
                                                    HorizontalAlignment="Stretch" FontSize="11" Padding="4,4" />
                                            <Button Grid.Column="2" Content="🌐 微軟官網"
                                                    Command="{x:Bind ViewModel.OpenMicrosoftPortalCommand}"
                                                    HorizontalAlignment="Stretch" FontSize="11" Padding="4,4" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 📦 Mode 1: 經典 MSDN 官方發行清單 -->
                                <StackPanel Visibility="{x:Bind ViewModel.IsClassicDownloadMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Spacing="10">
                                    <!-- Category Filter Buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="FilterAllBtn" Content="全部" Command="{x:Bind ViewModel.FilterCatalogCommand}" CommandParameter="All" Padding="8,3" FontSize="11" />
                                        <Button x:Name="FilterModernBtn" Content="現代" Command="{x:Bind ViewModel.FilterCatalogCommand}" CommandParameter="Modern" Padding="8,3" FontSize="11" />
                                        <Button x:Name="FilterClassicBtn" Content="經典" Command="{x:Bind ViewModel.FilterCatalogCommand}" CommandParameter="Classic" Padding="8,3" FontSize="11" />
                                        <Button x:Name="FilterLegacyBtn" Content="舊版" Command="{x:Bind ViewModel.FilterCatalogCommand}" CommandParameter="Legacy" Padding="8,3" FontSize="11" />
                                    </StackPanel>

                                    <!-- Catalog Selection -->
                                    <ComboBox x:Name="CatalogSelectBox" Header="選擇欲下載之 Windows 官方發行版" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.DownloadCatalog, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedDownloadItem, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:WindowsDownloadItem">
                                                <TextBlock Text="{x:Bind DisplayTitle}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Selected Item Details Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDownloadItem.FileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDownloadItem.HashBadgeDisplay, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.SelectedDownloadItem.HashBadgeDisplay, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                                       FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDownloadItem.Description, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Download Destination Folder -->
                                <TextBox x:Name="DownloadDestFolderBox" Header="下載儲存目錄"
                                         Text="{x:Bind ViewModel.DownloadDestinationFolder, Mode=TwoWay}" />

                                <!-- ⚡ HTTP Range 多線程分段加速設定 -->
                                <Expander Header="⚡ HTTP Range 多線程分段加速設定"
                                          IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                    <StackPanel Spacing="10" Padding="4">
                                        <!-- Capability Indicator -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ServerRangeCapabilityText, Mode=OneWay}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Button Grid.Column="1" Content="🔍 探測伺服器"
                                                        Command="{x:Bind ViewModel.ProbeServerRangeCommand}"
                                                        Padding="8,2" FontSize="11" />
                                            </Grid>
                                        </Border>

                                        <!-- Toggle & Threads & Buffers -->
                                        <Grid ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <ToggleSwitch Grid.Row="0" Grid.Column="0"
                                                          Header="HTTP Range 多線程並行傳輸"
                                                          OffContent="停用 (單線程安全模式)" OnContent="啟用 (多連線突破限速)"
                                                          IsOn="{x:Bind ViewModel.HttpRangeParallelEnabled, Mode=TwoWay}" />

                                            <ComboBox Grid.Row="0" Grid.Column="1" Header="並行傳輸線程數量"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind ViewModel.ParallelThreadOptions}"
                                                      SelectedItem="{x:Bind ViewModel.ParallelThreadCount, Mode=TwoWay}" />

                                            <ComboBox Grid.Row="1" Grid.Column="0" Header="分塊緩衝區大小"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Bind ViewModel.ChunkBufferSizeOptions}"
                                                      SelectedItem="{x:Bind ViewModel.ChunkBufferSizeKB, Mode=TwoWay}" />

                                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                                          Header="保留中斷暫存檔"
                                                          OffContent="取消時刪除暫存" OnContent="保留暫存 (.tmp_dm)"
                                                          IsOn="{x:Bind ViewModel.KeepResumeCache, Mode=TwoWay}" />
                                        </Grid>

                                        <!-- Custom URL Input & Temp Clean -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="自訂高速鏡像/直鏈網址 (選填)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="🌐 開啟微軟官網獲取直鏈" Command="{x:Bind ViewModel.OpenMicrosoftPortalCommand}"
                                                            Padding="8,2" FontSize="11" ToolTipService.ToolTip="於預設瀏覽器開啟微軟官方網站獲取當日有效直鏈" />
                                                    <Button Content="📋 貼上剪貼簿直鏈" Command="{x:Bind ViewModel.PasteDirectLinkCommand}"
                                                            Style="{StaticResource AccentButtonStyle}" Padding="8,2" FontSize="11"
                                                            ToolTipService.ToolTip="自動貼上剪貼簿中的 .iso/.wim 網址並觸發 Range 探針" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBox Text="{x:Bind ViewModel.CustomDownloadUrl, Mode=TwoWay}"
                                                     PlaceholderText="https://... 可貼上微軟當日直鏈或校園高速鏡像 (右鍵選單支援快捷操作)">
                                                <TextBox.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="📋 貼上剪貼簿直鏈" Command="{x:Bind ViewModel.PasteDirectLinkCommand}" />
                                                        <MenuFlyoutItem Text="🌐 開啟微軟官網獲取直鏈" Command="{x:Bind ViewModel.OpenMicrosoftPortalCommand}" />
                                                        <MenuFlyoutItem Text="🔍 探測 HTTP Range 支援" Command="{x:Bind ViewModel.ProbeServerRangeCommand}" />
                                                    </MenuFlyout>
                                                </TextBox.ContextFlyout>
                                            </TextBox>
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CacheStatsText, Mode=OneWay}"
                                                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="1" Content="🔄 檢查暫存"
                                                    Command="{x:Bind ViewModel.RefreshCacheStatsCommand}"
                                                    Padding="8,4" FontSize="11" />
                                            <Button Grid.Column="2" Content="🧹 清理下載快取"
                                                    Command="{x:Bind ViewModel.CleanDownloadTempCommand}"
                                                    Padding="8,4" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Action Buttons (Unified Controls with Pause/Resume) -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🚀 一鍵極速下載"
                                            Command="{x:Bind ViewModel.DownloadSelectedWindowsCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsDownloadingWindows, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.TogglePauseResumeDownloadCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsDownloadingWindows, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" Content="⏹️ 取消"
                                            Command="{x:Bind ViewModel.CancelWindowsDownloadCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsDownloadingWindows, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="3" Content="📦 載入部署"
                                            Command="{x:Bind ViewModel.UseDownloadedImageCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <!-- Download Progress -->
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsDownloadingWindows, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}" Maximum="100" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind ViewModel.DownloadStatusText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind ViewModel.DownloadSpeedText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.DownloadEtaText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Hash Verification Badge -->
                                <TextBlock Text="{x:Bind ViewModel.DownloadVerificationBadge, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           Visibility="{x:Bind ViewModel.DownloadVerificationBadge, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Expander>

                        <MenuFlyoutSeparator />

                        <!-- Image Path & Browse -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImagePathBox" Grid.Column="0" Header="WIM / ESD / ISO 映像檔路徑"
                                     Text="{x:Bind ViewModel.ImagePath, Mode=TwoWay}"
                                     PlaceholderText="請點選瀏覽或輸入 .wim / .esd / .iso" />
                            <Button x:Name="BrowseImageBtn" Grid.Column="1" Content="📁 瀏覽..."
                                    Command="{x:Bind ViewModel.BrowseImageFileCommand}"
                                    VerticalAlignment="Bottom" />
                            <Button x:Name="ParseImageBtn" Grid.Column="2" Content="🔍 解析"
                                    Command="{x:Bind ViewModel.LoadImageInfoCommand}"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- ISO Mounted Badge & Dismount -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6"
                                Visibility="{x:Bind ViewModel.MountedIsoPath, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="IsoBadgeText" Text="已自動掛載 ISO 虛擬磁碟" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button x:Name="DismountIsoBtn" Grid.Column="1" Content="⏏️ 卸載 ISO"
                                        Command="{x:Bind ViewModel.DismountIsoCommand}"
                                        Padding="8,2" FontSize="11" />
                            </Grid>
                        </Border>

                        <!-- Edition Selector -->
                        <ComboBox x:Name="EditionBox" Header="安裝版本與索引" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ImageEditions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WimImageInfo">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Selected Image Details Card (Zero Clipping & Human Readable) -->
                        <Border Visibility="{x:Bind ViewModel.HasSelectedImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,-4,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedImageDetailedSummary, Mode=OneWay}"
                                               FontSize="11" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedImageSizeBadge, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Destination & Boot Partitions (ComboBox Dropdowns) -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TargetDriveBox" Grid.Column="0" Header="目標安裝磁區"
                                      HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      ItemsSource="{x:Bind ViewModel.AvailableTargetDrives, Mode=OneWay}"
                                      Text="{x:Bind ViewModel.TargetDrive, Mode=TwoWay}" />
                            <ComboBox x:Name="BootDriveBox" Grid.Column="1" Header="引導磁區"
                                      HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      ItemsSource="{x:Bind ViewModel.AvailableBootDrives, Mode=OneWay}"
                                      Text="{x:Bind ViewModel.BootDrive, Mode=TwoWay}" />
                        </Grid>

                        <!-- Firmware Mode -->
                        <ComboBox x:Name="FirmwareBox" Header="韌體開機引導模式" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.FirmwareOptions}"
                                  SelectedItem="{x:Bind ViewModel.FirmwareMode, Mode=TwoWay}" />

                        <!-- 🛡️ Windows 7/8/10/11 Boot Compatibility Guard InfoBar -->
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="{x:Bind ViewModel.GuardTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.GuardMessage, Mode=OneWay}" />

                        <!-- Extra Addons / Optimization Tweaks -->
                        <TextBlock x:Name="AddonsTitle" Text="Windows 附加元件與繞過選項" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        
                        <CheckBox x:Name="BypassWin11Check" Content="🛡️ 一鍵繞過 Win11 硬體限制"
                                  IsChecked="{x:Bind ViewModel.BypassWin11, Mode=TwoWay}" />
                        
                        <CheckBox x:Name="BypassNroCheck" Content="🌐 繞過微軟帳戶強制聯網"
                                  IsChecked="{x:Bind ViewModel.BypassOnlineAccount, Mode=TwoWay}" />

                        <CheckBox x:Name="CompactOsCheck" Content="⚡ Compact OS 緊湊壓縮部署"
                                  IsChecked="{x:Bind ViewModel.IsCompactOs, Mode=TwoWay}" />

                        <CheckBox x:Name="AutoBootCheck" Content="🚀 部署後自動生成 BCD 開機引導檔"
                                  IsChecked="{x:Bind ViewModel.AutoCreateBoot, Mode=TwoWay}" />

                        <CheckBox x:Name="InjectWin7DriversCheck" Content="⚡ 自動注入 Windows 7 USB 3.0 與 NVMe 驅動"
                                  IsChecked="{x:Bind ViewModel.AutoInjectWin7Drivers, Mode=TwoWay}" />

                        <!-- Driver Injection with Browse Folder -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DriverFolderBox" Grid.Column="0" Header="離線驅動注入目錄 (選填)"
                                     Text="{x:Bind ViewModel.DriverFolderPath, Mode=TwoWay}"
                                     PlaceholderText="包含 .inf 驅動之資料夾 (如 NVMe、WiFi)" />
                            <Button x:Name="BrowseDriverBtn" Grid.Column="1" Content="📂 瀏覽..."
                                    Command="{x:Bind ViewModel.BrowseDriverFolderCommand}"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- Execute Button -->
                        <Button Command="{x:Bind ViewModel.DeployImageCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Padding="14" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="18" />
                                <TextBlock x:Name="StartDeployBtnText" Text="🚀 開始部署 Windows 系統映像" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Native VHDX Boot Deployment Option -->
                        <Expander Header="💽 一鍵部署至 VHDX 虛擬硬碟"
                                  IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <StackPanel Spacing="10" Padding="4">
                                <TextBlock Text="將 Windows 映像直接解壓套用至全新 VHDX 虛擬硬碟中，並向主機 BCD 註冊開機引導項。開機時可自由進入此系統，享受 100% 原生硬體效能且完全不影響現有實體磁碟！"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="VHDX 儲存路徑"
                                             Text="{x:Bind ViewModel.VhdxFilePath, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="容量 (GB)"
                                               Value="{x:Bind ViewModel.VhdxSizeGB, Mode=TwoWay}"
                                               Minimum="20" Maximum="2048" SpinButtonPlacementMode="Compact" />
                                </Grid>
                                <TextBox Header="開機選單顯示名稱"
                                         Text="{x:Bind ViewModel.VhdxBootTitle, Mode=TwoWay}" />
                                <Button Content="🚀 建立 VHDX 並套用映像註冊開機"
                                        Command="{x:Bind ViewModel.DeployToVhdxCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsDeploying, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Expander>

                        <!-- ═══ Image Management Tools ═══ -->
                        <Expander x:Name="ImageMgmtExpander" Header="🔄 映像管理工具" IsExpanded="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                            <StackPanel Spacing="12">
                                <!-- Capture Image -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="CaptureTitle" Text="📸 備份磁碟為 WIM 映像" FontWeight="SemiBold" />
                                        <TextBox x:Name="CaptureDirBox" Header="來源目錄"
                                                 Text="{x:Bind ViewModel.CaptureDir, Mode=TwoWay}" PlaceholderText="C:\" />
                                        <TextBox x:Name="CaptureOutputBox" Header="輸出 WIM 路徑"
                                                 Text="{x:Bind ViewModel.CaptureOutputPath, Mode=TwoWay}" PlaceholderText="D:\Backup.wim" />
                                        <TextBox x:Name="CaptureNameBox" Header="映像名稱"
                                                 Text="{x:Bind ViewModel.CaptureName, Mode=TwoWay}" />
                                        <Button x:Name="CaptureImageBtn" Content="📸 開始備份" Command="{x:Bind ViewModel.CaptureImageCommand}"
                                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <!-- Export Image (ESD to WIM) -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="ExportTitle" Text="🔄 ESD ↔ WIM 格式轉換" FontWeight="SemiBold" />
                                        <TextBlock Text="先選擇來源 WIM/ESD 並選擇版本索引，再指定輸出路徑。" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox x:Name="ExportDestBox" Header="輸出檔案路徑"
                                                 Text="{x:Bind ViewModel.ExportDestPath, Mode=TwoWay}" PlaceholderText="D:\install.wim" />
                                        <Button x:Name="ExportImageBtn" Content="🔄 開始轉換" Command="{x:Bind ViewModel.ExportImageCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <!-- Split Image -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="SplitTitle" Text="✂️ 分割 WIM 至 FAT32 USB" FontWeight="SemiBold" />
                                        <TextBox x:Name="SplitOutputBox" Header="輸出 SWM 路徑"
                                                 Text="{x:Bind ViewModel.SplitOutputPath, Mode=TwoWay}" PlaceholderText="E:\sources\install.swm" />
                                        <Button x:Name="SplitImageBtn" Content="✂️ 開始分割" Command="{x:Bind ViewModel.SplitImageCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <!-- Mount/Unmount WIM -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="MountWimTitle" Text="📂 掛載 WIM 映像" FontWeight="SemiBold" />
                                        <TextBox x:Name="MountDirBox" Header="掛載目錄"
                                                 Text="{x:Bind ViewModel.MountDir, Mode=TwoWay}" PlaceholderText="C:\WimMount" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="MountWimBtn" Content="📂 掛載 WIM" Command="{x:Bind ViewModel.MountWimImageCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="UnmountWimBtn" Content="⏏️ 卸載" Command="{x:Bind ViewModel.UnmountWimImageCommand}" />
                                            <Button x:Name="CleanupMountsBtn" Content="🧹 清理孤立掛載" Command="{x:Bind ViewModel.CleanupMountpointsCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Realtime Deployment Console -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="DeployLogTitle" Text="Deployment Progress &amp; DISM Console" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CopyDeployLogBtn" Content="📋 複製日誌" Command="{x:Bind ViewModel.CopyDeployLogCommand}" Padding="8,2" FontSize="11" />
                            <Button x:Name="ClearDeployLogBtn" Content="Clear" Command="{x:Bind ViewModel.ClearDeployLogCommand}" Padding="8,2" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar & Text (FIXED: NO INVALID CONVERTER) -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                     Maximum="100" Height="8" CornerRadius="4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressPercentDisplay, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>

                    <!-- Terminal ScrollViewer -->
                    <ScrollViewer x:Name="DeployLogScrollViewer" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                  CornerRadius="6" Padding="12">
                        <TextBlock Text="{x:Bind ViewModel.DeployLog, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
