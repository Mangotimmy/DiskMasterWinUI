<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.DiskToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:services="using:DiskMasterWinUI.Services"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshAllCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshToolsBtnText" Text="Refresh Tools &amp; Hardware Info" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24" />
        </Grid>

        <!-- Movable Sub TabView -->
        <TabView x:Name="DiskToolsTabView" Grid.Row="1"
                 CanReorderTabs="True"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>

                <!-- ── Tab 0: Disk Health & Integrity ── -->
                <TabViewItem x:Name="TabHealth" Header="🩺 磁碟健康 (Disk Health)" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="HealthCardsStack" Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                        <!-- S.M.A.R.T. Health Overview -->
                        <Border x:Name="SmartOverviewCard" Tag="SmartOverviewCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="⬆️ 向上移動此卡片" Click="CardOverview_MoveUp_Click" />
                                    <MenuFlyoutItem Text="⬇️ 向下移動此卡片" Click="CardOverview_MoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="📌 移至最頂部" Click="CardOverview_MoveTop_Click" />
                                    <MenuFlyoutItem Text="📌 移至最底部" Click="CardOverview_MoveBottom_Click" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9F9;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="SmartTitle" Grid.Column="1" Text="S.M.A.R.T. 磁碟健康監控" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <Button x:Name="RefreshHealthBtn" Grid.Column="2" Content="🔄 重新掃描"
                                            Command="{x:Bind ViewModel.RefreshDiskHealthCommand}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="SmartPredictionBtn" Grid.Column="3" Content="🔮 預測性故障偵測"
                                            Command="{x:Bind ViewModel.GetSmartPredictionCommand}" />
                                    <ProgressRing Grid.Column="4" IsActive="{x:Bind ViewModel.IsHealthLoading, Mode=OneWay}"
                                                  Width="20" Height="20" />
                                </Grid>

                                <ListView ItemsSource="{x:Bind ViewModel.DiskHealthItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDiskHealth, Mode=TwoWay}"
                                          SelectionChanged="DiskList_SelectionChanged"
                                          SelectionMode="Single" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="24"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <TextBlock Text="{Binding MediaType}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        <TextBlock Text="{Binding BusType}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        <TextBlock Text="{Binding TemperatureDisplay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        <TextBlock Text="{Binding OperationalStatus}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Full S.M.A.R.T. Deep Telemetry Card -->
                        <Border x:Name="SmartTelemetryCard" Tag="SmartTelemetryCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="⬆️ 向上移動此卡片" Click="CardTelemetry_MoveUp_Click" />
                                    <MenuFlyoutItem Text="⬇️ 向下移動此卡片" Click="CardTelemetry_MoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="📌 移至最頂部" Click="CardTelemetry_MoveTop_Click" />
                                    <MenuFlyoutItem Text="📌 移至最底部" Click="CardTelemetry_MoveBottom_Click" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="📊 完整 S.M.A.R.T. 深度解析與硬體遙測" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />

                                    <!-- Switch 1: Temp Unit -->
                                    <ToggleSwitch Grid.Column="2" x:Name="TempUnitSwitch"
                                                  IsOn="{x:Bind ViewModel.IsFahrenheit, Mode=OneWay}"
                                                  OffContent="攝氏 (°C)" OnContent="華氏 (°F)"
                                                  Toggled="TempUnit_Toggled" VerticalAlignment="Center" />

                                    <!-- Switch 2: Hex view -->
                                    <ToggleSwitch Grid.Column="3" x:Name="RawHexSwitch"
                                                  IsOn="{x:Bind ViewModel.IsRawHex, Mode=OneWay}"
                                                  OffContent="十進位" OnContent="十六進位"
                                                  Toggled="RawHex_Toggled" VerticalAlignment="Center" />

                                    <!-- Copy Button -->
                                    <Button Grid.Column="4" Content="📋 複製報告"
                                            Command="{x:Bind ViewModel.CopyFullSmartReportCommand}"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <!-- Loading Indicator -->
                                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsFullSmartLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- NVMe Dashboard (When Selected Disk is NVMe) -->
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelectedNvme, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="⚡ NVMe 原生硬體健康指標 (NVMe 1.4 / 2.0 IOCTL 解碼)" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Card 1: Core Temperature -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="🌡️ 核心溫度 (Composite Temp)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.CompositeTemperatureDisplay, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="原生開氏溫標精準換算" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: SSD Health & Wear -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="🩺 健康度與耗損" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.HealthPercentDisplay, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#107C41" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.PercentageUsedDisplay, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: TBW -->
                                        <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="📝 累計總寫入量 (TBW)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.TotalWrittenDisplay, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                                <TextBlock Text="主機寫入累計資料區塊" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: TBR -->
                                        <Border Grid.Row="0" Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="📖 累計總讀取量 (TBR)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.TotalReadDisplay, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                                <TextBlock Text="主機讀取累計資料區塊" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 5: Power-On Hours -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="⏱️ 通電運作時數" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.PowerOnHoursDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 6: Power Cycles -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="🔌 通電次數" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.PowerCyclesDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 7: Unsafe Shutdowns -->
                                        <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="⚡ 不正常斷電次數" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.UnsafeShutdownsDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 8: Available Spare -->
                                        <Border Grid.Row="1" Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="🛡️ 備用空間比例" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedNvmeHealth.AvailableSpareDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- ATA SMART Attributes Table (When Selected Disk is SATA/HDD) -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasSelectedAta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🗄️ ATA S.M.A.R.T. 30 項硬體診斷指標資料表" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                                        <ListView ItemsSource="{x:Bind ViewModel.AtaSmartAttributes, Mode=OneWay}" SelectionMode="None" MaxHeight="280">
                                            <ListView.HeaderTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="4,4" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="屬性名稱" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="2" Text="當前" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="3" Text="最差" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="4" Text="臨界" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="5" Text="原始數據" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="6" Text="狀態" FontWeight="Bold" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.HeaderTemplate>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:SmartAttributeItem">
                                                    <Grid Padding="4,4" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind IdHex}" FontFamily="Consolas" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Current}" FontSize="11" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Worst}" FontSize="11" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind Threshold}" FontSize="11" />
                                                        <TextBlock Grid.Column="5" Text="{x:Bind RawValueDisplay}" FontFamily="Consolas" FontSize="11" />
                                                        <TextBlock Grid.Column="6" Text="{x:Bind StatusIcon}" FontSize="12" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                 </StackPanel>

                                <!-- Fallback Summary Panel (When device does not expose raw ATA registers) -->
                                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasNoSmartTelemetry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="ℹ️ 磁碟健康與基礎遙測摘要 (Basic Hardware Diagnostics)" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="14">
                                        <Grid ColumnSpacing="16" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="裝置名稱 / 型號" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedDiskHealth.FriendlyName, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="介面與類型" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedDiskHealth.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="目前核心溫度" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedDiskHealth.TemperatureDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="16" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reliability Counters Detail -->
                        <Expander x:Name="ReliabilityExpander" Tag="ReliabilityExpander" Header="📊 詳細可靠性指標" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="⬆️ 向上移動此卡片" Click="CardReliability_MoveUp_Click" />
                                    <MenuFlyoutItem Text="⬇️ 向下移動此卡片" Click="CardReliability_MoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="📌 移至最頂部" Click="CardReliability_MoveTop_Click" />
                                    <MenuFlyoutItem Text="📌 移至最底部" Click="CardReliability_MoveBottom_Click" />
                                </MenuFlyout>
                            </Expander.ContextFlyout>
                            <ListView ItemsSource="{x:Bind ViewModel.ReliabilityItems, Mode=OneWay}" SelectionMode="None">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="16" Padding="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="磁碟名稱 / 型號" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="溫度" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="耗損率" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Grid.Column="3" Text="通電時數" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Grid.Column="4" Text="讀取錯誤" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Grid.Column="5" Text="寫入錯誤" FontWeight="Bold" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="16" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding TemperatureDisplay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WearDisplay}" />
                                            <TextBlock Grid.Column="3" Text="{Binding PowerOnDisplay}" />
                                            <TextBlock Grid.Column="4" Text="{Binding ReadErrorsDisplay}" />
                                            <TextBlock Grid.Column="5" Text="{Binding WriteErrorsDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>

                        <!-- chkdsk Filesystem Check -->
                        <Border x:Name="ChkdskCard" Tag="ChkdskCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="⬆️ 向上移動此卡片" Click="CardChkdsk_MoveUp_Click" />
                                    <MenuFlyoutItem Text="⬇️ 向下移動此卡片" Click="CardChkdsk_MoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="📌 移至最頂部" Click="CardChkdsk_MoveTop_Click" />
                                    <MenuFlyoutItem Text="📌 移至最底部" Click="CardChkdsk_MoveBottom_Click" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="ChkdskTitle" Text="chkdsk 檔案系統完整性檢查" FontWeight="SemiBold" FontSize="15" />
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChkdskDriveBox" Grid.Column="0" Header="磁碟機" Width="80"
                                             Text="{x:Bind ViewModel.ChkdskDrive, Mode=TwoWay}" />
                                    <Button x:Name="ChkdskScanBtn" Grid.Column="1" Content="🔍 線上掃描" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskScanCommand}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="ChkdskSpotFixBtn" Grid.Column="2" Content="🔧 快速修復" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskSpotFixCommand}" />
                                    <Button x:Name="ChkdskFixBtn" Grid.Column="3" Content="🛠️ 完整修復" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskFixCommand}" />
                                    <Button x:Name="ChkdskFullBtn" Grid.Column="4" Content="🩹 壞軌修復" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskFullRepairCommand}" />
                                    <Button x:Name="ChkdskDirtyBtn" Grid.Column="5" Content="❓ Dirty Bit" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskQueryDirtyCommand}" />
                                    <Button x:Name="ChkdskBootBtn" Grid.Column="6" Content="📅 排程開機檢查" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.ChkdskScheduleBootCommand}" />
                                    <Button x:Name="ChkdskCancelBtn" Grid.Column="7" Content="⏹️ 停止" VerticalAlignment="Bottom"
                                             Command="{x:Bind ViewModel.CancelChkdskCommand}"
                                             IsEnabled="{x:Bind ViewModel.IsChkdskRunning, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ── Tab 1: Windows License Keys & Serials ── -->
            <TabViewItem x:Name="TabKeys" Header="金鑰與硬體序號 (Keys &amp; Serials)" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                        <!-- OEM BIOS Key Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="BiosOemKeyTitle" Text="UEFI / BIOS OEM 原廠嵌入金鑰 (MSDM Table)" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                             Text="{x:Bind ViewModel.LicenseInfo.BiosOemKey, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="📋 Copy Key"
                                             Command="{x:Bind ViewModel.CopyTextCommand}"
                                             CommandParameter="{x:Bind ViewModel.LicenseInfo.BiosOemKey, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Installed Windows Key Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="InstalledKeyTitle" Text="目前系統啟動金鑰 (Installed Windows 10/11 Product Key)" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                             Text="{x:Bind ViewModel.LicenseInfo.InstalledProductKey, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="📋 Copy Key"
                                             Command="{x:Bind ViewModel.CopyTextCommand}"
                                             CommandParameter="{x:Bind ViewModel.LicenseInfo.InstalledProductKey, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Motherboard & BIOS Hardware Serials Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="HardwareSerialsTitle" Text="主機板與 BIOS 實體硬體序號 (Hardware Identification)" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="BiosSerialBox" Grid.Row="0" Grid.Column="0" Header="BIOS 序號 (Serial Number)" IsReadOnly="True"
                                             Text="{x:Bind ViewModel.LicenseInfo.BiosSerialNumber, Mode=OneWay}" FontFamily="Consolas" />
                                    <TextBox x:Name="MotherboardProductBox" Grid.Row="0" Grid.Column="1" Header="主機板型號 (Motherboard Product)" IsReadOnly="True"
                                             Text="{x:Bind ViewModel.LicenseInfo.MotherboardProduct, Mode=OneWay}" />
                                    <TextBox x:Name="ManufacturerBox" Grid.Row="1" Grid.Column="0" Header="原廠製造商 (Manufacturer)" IsReadOnly="True"
                                             Text="{x:Bind ViewModel.LicenseInfo.MotherboardManufacturer, Mode=OneWay}" />
                                    <TextBox x:Name="WindowsProductNameBox" Grid.Row="1" Grid.Column="1" Header="Windows 版本名稱" IsReadOnly="True"
                                             Text="{x:Bind ViewModel.LicenseInfo.WindowsProductName, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Offline Windows Key Extractor -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="OfflineKeyTitle" Text="離線 Windows 金鑰提取器 (Offline System Registry Hive)" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock x:Name="OfflineKeyDesc" Text="在 WinPE 或雙系統下，指定無法開機的副磁區路徑（如 D:\Windows），直接解碼提取原系統金鑰。"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OfflineWindowsPathBox" Grid.Column="0" Header="Offline Windows Path"
                                             Text="{x:Bind ViewModel.OfflineWindowsPath, Mode=TwoWay}" />
                                    <Button x:Name="ReadOfflineKeyBtn" Grid.Column="1" Content="🔍 提取離線金鑰"
                                            Command="{x:Bind ViewModel.ReadOfflineLicenseCommand}"
                                            VerticalAlignment="Bottom" />
                                </Grid>

                                <TextBox x:Name="ExtractedOfflineKeyBox" Header="Extracted Offline Key" IsReadOnly="True"
                                         Text="{x:Bind ViewModel.LicenseInfo.OfflineProductKey, Mode=OneWay}"
                                         FontFamily="Consolas" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ── Tab 2: Environment Doctor & In-App Setup ── -->
            <TabViewItem x:Name="TabEnv" Header="環境健檢與套件補齊 (Environment Doctor)" IsClosable="False">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="EnvDoctorDesc" Grid.Row="0" Text="自動偵測本機是否具備各項進階磁碟與修復工具。若有缺失，可於應用內一鍵背景下載安裝："
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ToolItems, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:ToolEnvironmentItem">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12" Margin="0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind StatusGlyph}"
                                                  FontSize="22" VerticalAlignment="Center"
                                                  Foreground="{x:Bind StatusBrush}" />

                                        <!-- Tool Info -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind PathFound}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- In-App Winget Setup Button -->
                                        <Button Grid.Column="2" Content="⬇️ 一鍵下載並安裝"
                                                Visibility="{x:Bind CanInstallViaWinget, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                VerticalAlignment="Center"
                                                Click="InstallTool_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <!-- ── Tab 3: Disk Optimization & Advanced Recovery ── -->
            <TabViewItem x:Name="TabOptimize" Header="進階維護與救援 (Optimization &amp; Recovery)" IsClosable="False">
                <Grid Margin="0,10,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. SSD TRIM & Defrag -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="SsdTrimCardTitle" Text="SSD TRIM &amp; 磁碟最佳化" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBox x:Name="OptimizeDriveBox" Header="磁碟機代號 (Drive Letter)" Text="{x:Bind ViewModel.OptimizeDriveLetter, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RunTrimBtn" Grid.Column="0" Content="⚡ SSD TRIM" Command="{x:Bind ViewModel.SsdTrimCommand}"
                                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="AnalyzeDefragBtn" Grid.Column="1" Content="📊 碎片分析" Command="{x:Bind ViewModel.AnalyzeFragmentationCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DefragHddBtn" Grid.Column="0" Content="🧹 HDD 重組" Command="{x:Bind ViewModel.DefragVolumeCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="OptimizeSmartBtn" Grid.Column="1" Content="🚀 智慧最佳化" Command="{x:Bind ViewModel.OptimizeAutoCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Button x:Name="ConsolidateFreeBtn" Content="🧱 合併可用空間 (/X)" Command="{x:Bind ViewModel.ConsolidateFreeSpaceCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Grid Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="SsdTrimSupportLabel" Text="SSD TRIM 支援" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SsdTrimSupportDesc" Text="保持快閃記憶體寫入壽命與垃圾回收效能" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsTrimEnabled, Mode=OneWay}"
                                                      Toggled="Trim_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Security Wipe & Shadow Copies -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="SafeEraseCardTitle" Text="安全抹除與陰影複本" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="CipherDescText" Text="cipher.exe: 3 遍完整覆寫可用空間，防已刪檔案還原"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="RunCipherBtn" Content="🛡️ 安全抹除已刪檔案 (cipher /w)" Command="{x:Bind ViewModel.SecureWipeFreeSpaceCommand}"
                                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                    <TextBlock x:Name="VssTitleText" Text="vssadmin: 磁碟區陰影複本 (Volume Shadow Copies)"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ListShadowsBtn" Grid.Column="0" Content="📋 列出複本 (UI 清單)" Command="{x:Bind ViewModel.LoadShadowsStructuredCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="DeleteAllShadowsBtn" Grid.Column="1" Content="🗑️ 清除所有複本" Command="{x:Bind ViewModel.DeleteAllShadowsCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <!-- Structured VSS Shadows List -->
                                    <ListView ItemsSource="{x:Bind ViewModel.AllShadows, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedShadow, Mode=TwoWay}"
                                              MaxHeight="120" SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:VssShadowItem">
                                                <Grid Padding="2" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Summary}" FontSize="10" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="🗑️" Click="DeleteShadow_Click" Padding="4,2" FontSize="10" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock x:Name="RestorePointsTitleText" Text="System Restore: 系統還原點 (Restore Points)"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ListRestorePointsBtn" Grid.Column="0" Content="📸 列出還原點" Command="{x:Bind ViewModel.ListRestorePointsCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="CreateRestorePointBtn" Grid.Column="1" Content="➕ 建立還原點" Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. BitLocker Management -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="BitLockerCardTitle" Text="BitLocker 磁碟加密管理" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BitLockerDriveBox" Grid.Column="0" Header="磁區" Width="60" Text="{x:Bind ViewModel.BitLockerDrive, Mode=TwoWay}" />
                                        <TextBox x:Name="BitLockerPasswordBox" Grid.Column="1" Header="修復密碼 (48位數字)" Text="{x:Bind ViewModel.BitLockerPassword, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BitLockerStatusBtn" Grid.Column="0" Content="📋 加密狀態" Command="{x:Bind ViewModel.BitLockerStatusCommand}"
                                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="BitLockerProtectorsBtn" Grid.Column="1" Content="🔑 金鑰保護者" Command="{x:Bind ViewModel.BitLockerProtectorsCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Grid Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="BitLockerProtectLabel" Text="BitLocker 保護狀態" FontWeight="SemiBold" />
                                            <TextBlock x:Name="BitLockerProtectDesc" Text="暫停保護或恢復硬體層級加密" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsBitLockerActive, Mode=OneWay}"
                                                      Toggled="BitLockerProtect_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BitLockerLockBtn" Grid.Column="0" Content="🔒 立即強制鎖定" Command="{x:Bind ViewModel.BitLockerLockVolumeCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="BitLockerBackupKeyBtn" Grid.Column="1" Content="🔑 備份修復金鑰" Command="{x:Bind ViewModel.BitLockerExportKeyCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BitLockerUnlockBtn" Grid.Column="0" Content="🔓 解鎖磁區" Command="{x:Bind ViewModel.BitLockerUnlockCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="BitLockerDecryptBtn" Grid.Column="1" Content="🔓 永久解密 (Decrypt)" Command="{x:Bind ViewModel.BitLockerDecryptCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. WinFR Deleted File Recovery -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="WinFrCardTitle" Text="微軟官方檔案救援 (WinFR)" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBox x:Name="WinFrSourceBox" Header="來源磁碟區 (Source Drive)" Text="{x:Bind ViewModel.WinFrSourceDrive, Mode=TwoWay}" />
                                    <TextBox x:Name="WinFrDestBox" Header="救援存放資料夾 (Destination Folder)" Text="{x:Bind ViewModel.WinFrDestinationFolder, Mode=TwoWay}" />
                                    <Button x:Name="RunWinFrBtn" Content="🔍 開始掃描救回檔案" Command="{x:Bind ViewModel.RunWinFrRecoveryCommand}"
                                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- 5. ISO / VHD / VHDX Virtual Disk Mount -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="VirtualDiskCardTitle" Text="掛載虛擬磁碟 (ISO/VHD)" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VirtualDiskPathBox" Grid.Column="0" Header="映像檔路徑" Text="{x:Bind ViewModel.VirtualDiskPath, Mode=TwoWay}"
                                                 PlaceholderText=".iso / .vhd / .vhdx" />
                                        <Button Grid.Column="1" Content="📁" Command="{x:Bind ViewModel.BrowseVirtualDiskCommand}"
                                                VerticalAlignment="Bottom" ToolTipService.ToolTip="瀏覽映像檔案" />
                                    </Grid>
                                    <Button x:Name="MountVirtualDiskBtn" Content="💿 一鍵掛載映像 (Mount)" Command="{x:Bind ViewModel.MountVirtualDiskCommand}"
                                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="DismountVirtualDiskBtn" Content="⏏️ 卸載映像 (Dismount)" Command="{x:Bind ViewModel.DismountVirtualDiskCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- 6. WSL2 EXT4 Linux Mount & Drivers -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="Ext4CardTitle" Text="EXT4 Linux 磁區 &amp; 驅動" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBox x:Name="Ext4DiskBox" Header="實體磁碟編號 (Disk #)" Text="{x:Bind ViewModel.Ext4DiskNumber, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MountExt4Btn" Grid.Column="0" Content="🐧 掛載 EXT4" Command="{x:Bind ViewModel.MountExt4Command}"
                                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="UnmountExt4Btn" Grid.Column="1" Content="⏏️ 卸載 EXT4" Command="{x:Bind ViewModel.UnmountExt4Command}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Button x:Name="InstallDriverBtn" Content="➕ 安裝/注入驅動程式 (.inf)" Command="{x:Bind ViewModel.InstallDriverCommand}"
                                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LoadDriversBtn" Grid.Column="0" Content="📋 列舉驅動 (UI 清單)" Command="{x:Bind ViewModel.LoadDriversStructuredCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button x:Name="ExportDriversBtn" Grid.Column="1" Content="💾 匯出驅動" Command="{x:Bind ViewModel.ExportDriversViaPnpCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <!-- Structured OEM Drivers List -->
                                    <TextBox x:Name="DriverFilterBox" PlaceholderText="🔍 搜尋驅動 (OEM/Class/Provider)..." Text="{x:Bind ViewModel.DriverSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SelectAllDriversBtn" Grid.Column="0" Content="全選" Command="{x:Bind ViewModel.SelectAllDriversCommand}"
                                                HorizontalAlignment="Stretch" FontSize="11" />
                                        <Button x:Name="DeselectAllDriversBtn" Grid.Column="1" Content="取消全選" Command="{x:Bind ViewModel.DeselectAllDriversCommand}"
                                                HorizontalAlignment="Stretch" FontSize="11" />
                                        <Button x:Name="DeleteSelectedDriversBtn" Grid.Column="2" Content="批量卸載" Click="DeleteSelectedDrivers_Click"
                                                HorizontalAlignment="Stretch" FontSize="11" />
                                    </Grid>
                                    <ListView ItemsSource="{x:Bind ViewModel.FilteredDrivers, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedDriver, Mode=TwoWay}"
                                              MaxHeight="120" SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:OemDriverItem">
                                                <Grid Padding="2" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="ℹ️" Click="InspectDriver_Click" Padding="4,2" FontSize="10" ToolTipService.ToolTip="檢視驅動詳情" />
                                                    <Button Grid.Column="3" Content="🗑️" Click="DeleteDriver_Click" Padding="4,2" FontSize="10" ToolTipService.ToolTip="強制解除安裝驅動" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Log Output -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ActionLogTitle" Text="執行日誌 (Action Output Log)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Content="Clear" Command="{x:Bind ViewModel.ClearLogCommand}" Padding="8,2" FontSize="11" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="6" Padding="10">
                                <TextBlock Text="{x:Bind ViewModel.OutputLog, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ── Tab 4: VHD / VHDX 虛擬硬碟與暫存清理管理箱 ── -->
            <TabViewItem x:Name="TabVhdx" Header="💽 VHD/VHDX 虛擬磁碟與快取清理" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                        <!-- Card 1: VHD/VHDX Virtual Disk Manager -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="💽 VHD / VHDX 虛擬硬碟管理箱" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="支援建立 VHDX (最高64TB) 與 VHD (最高2TB)、動態擴充與固定容量，並支援掛載 (唯讀保護)、卸載、空間壓縮與容量上限擴展。"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- File Path & Browse -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="VHD / VHDX 映像路徑"
                                             Text="{x:Bind ViewModel.VirtualDiskPath, Mode=TwoWay}"
                                             PlaceholderText="D:\VirtualDisks\MyDisk.vhdx" />
                                    <Button Grid.Column="1" Content="📁 瀏覽檔案..."
                                            Command="{x:Bind ViewModel.BrowseVirtualDiskCommand}"
                                            VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- Creation Parameters -->
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Header="磁碟格式" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.VhdFormatOptions}"
                                              SelectedItem="{x:Bind ViewModel.VhdFormat, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1" Header="分配類型" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.VhdTypeOptions}"
                                              SelectedItem="{x:Bind ViewModel.VhdType, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="2" Header="容量 (GB)"
                                               Value="{x:Bind ViewModel.VhdSizeGB, Mode=TwoWay}"
                                               Minimum="1" Maximum="65536" SpinButtonPlacementMode="Compact" />
                                </Grid>

                                <!-- Preset Size Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="常用容量預設:" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Content="32 GB" Command="{x:Bind ViewModel.SetVhdPresetSizeCommand}" CommandParameter="32" Padding="8,2" FontSize="11" />
                                    <Button Content="64 GB" Command="{x:Bind ViewModel.SetVhdPresetSizeCommand}" CommandParameter="64" Padding="8,2" FontSize="11" />
                                    <Button Content="128 GB" Command="{x:Bind ViewModel.SetVhdPresetSizeCommand}" CommandParameter="128" Padding="8,2" FontSize="11" />
                                    <Button Content="256 GB" Command="{x:Bind ViewModel.SetVhdPresetSizeCommand}" CommandParameter="256" Padding="8,2" FontSize="11" />
                                </StackPanel>

                                <!-- Toggles & Formatting Options -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch Grid.Column="0" Header="建立後自動初始化並格式化為 NTFS"
                                                  OffContent="僅建立空白磁碟檔" OnContent="自動格式化並分配磁碟代號"
                                                  IsOn="{x:Bind ViewModel.VhdAutoFormatNtfs, Mode=TwoWay}" />
                                    <ToggleSwitch Grid.Column="1" Header="以唯讀保護模式掛載 (Mount as Read-Only)"
                                                  OffContent="一般讀寫模式" OnContent="唯讀保護 (防誤改寫)"
                                                  IsOn="{x:Bind ViewModel.VhdReadOnly, Mode=TwoWay}" />
                                </Grid>

                                <!-- Action Buttons Row 1: Create, Attach, Detach -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✨ 建立全新虛擬硬碟"
                                            Command="{x:Bind ViewModel.CreateVhdCommand}"
                                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="📌 掛載虛擬磁碟"
                                            Command="{x:Bind ViewModel.AttachVhdCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" Content="⏏️ 安全卸載磁碟"
                                            Command="{x:Bind ViewModel.DetachVhdCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <MenuFlyoutSeparator />

                                <!-- Action Buttons Row 2: Compact & Expand -->
                                <TextBlock Text="進階磁碟維護與無損擴展 (Maintenance &amp; Expand)" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🗜️ 壓縮收縮動態 VHDX (釋放空間)"
                                            Command="{x:Bind ViewModel.CompactVhdCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <NumberBox Grid.Column="1" Header="擴展後新上限 (GB)"
                                               Value="{x:Bind ViewModel.VhdNewExpandSizeGB, Mode=TwoWay}"
                                               Minimum="10" Maximum="65536" SpinButtonPlacementMode="Compact" />
                                    <Button Grid.Column="2" Content="📐 擴展容量上限"
                                            Command="{x:Bind ViewModel.ExpandVhdCommand}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                                </Grid>

                                <Button Content="🔍 查詢虛擬磁碟幾何與詳細資訊"
                                        Command="{x:Bind ViewModel.GetVhdDetailsCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Cache & Temporary Files Cleaner -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="🧹 下載暫存快取與系統殘留深度清理" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="清理多線程分段下載隔離區 (.tmp_dm)、未完成的 ISO 暫存檔、DISM 孤立掛載鎖定點與 DiskPart 臨時腳本，安全釋放硬碟空間。"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📥 清理下載暫存 (.tmp_dm)"
                                            Command="{x:Bind ViewModel.CleanDownloadCacheCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="🔒 清理 DISM 掛載鎖"
                                            Command="{x:Bind ViewModel.CleanDismMountsCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" Content="📜 清理臨時指令檔"
                                            Command="{x:Bind ViewModel.CleanDiskPartScriptsCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⚡ 一鍵全域快取清理"
                                            Command="{x:Bind ViewModel.PerformFullCleanupCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" Padding="12" />
                                    <Button Grid.Column="1" Content="🧹 全系統暫存深度清理"
                                            Command="{x:Bind ViewModel.PerformSystemDeepCleanupCommand}"
                                            HorizontalAlignment="Stretch" Padding="12" />
                                </Grid>

                                <TextBlock Text="{x:Bind ViewModel.CacheCleanupSummary, Mode=OneWay}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           Visibility="{x:Bind ViewModel.CacheCleanupSummary, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ── Tab 7: 磁碟目錄空間與功能指南 (Storage Directory Encyclopedia) ── -->
            <TabViewItem x:Name="TabDirectoryAnalyzer" Header="📁 目錄空間指南 (Storage Directory Guide)" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,16,20">

                        <!-- Hero Header Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Name="DirEncyclopediaTitle" Text="磁碟核心目錄空間分析與用途百科 (Directory Space &amp; Function Encyclopedia)" FontWeight="Bold" FontSize="18" />
                                    </StackPanel>
                                    <TextBlock x:Name="DirEncyclopediaSubtitle"
                                               Text="清楚盤點 WinSxS、SoftwareDistribution、DriverStore、Installer、Temp、hiberfil.sys 等重要目錄與系統檔案，提供容量佔用、安全清理指引與一鍵操作處置。"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{x:Bind ViewModel.ScanStorageDirectoriesCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE721;" FontSize="16" />
                                            <TextBlock x:Name="ScanDirectoriesBtnText" Text="🔍 深度掃描目錄空間與用途" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanningDirectories, Mode=OneWay}" Width="20" Height="20" />
                                        <TextBlock Text="{x:Bind ViewModel.DirectoryScanStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Directories ItemsControl -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StorageDirectories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StorageDirectoryItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <!-- Top Row: Icon + Name + Path + Badges -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{x:Bind Icon}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Text="{x:Bind Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                                        <TextBlock Text="{x:Bind DisplaySafety}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="8,4">
                                                        <TextBlock Text="{x:Bind DisplaySize}" FontSize="12" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Middle Row: Description Explanation -->
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10">
                                                <TextBlock Text="{x:Bind DisplayDescription}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" LineHeight="18" />
                                            </Border>

                                            <!-- Bottom Row: Action Buttons -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="{x:Bind DisplayActionLabel}"
                                                        Click="ExecuteDirectoryAction_Click"
                                                        Style="{StaticResource AccentButtonStyle}" Padding="12,6" FontSize="11" />
                                                <Button Content="📁 檔案總管" Click="OpenDirectoryExplorer_Click" Padding="10,6" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</Grid>
</Page>
