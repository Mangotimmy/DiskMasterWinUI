<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiskMasterWinUI.Pages.RecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DiskMasterWinUI.Models"
    xmlns:vm="using:DiskMasterWinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Source selection & scan controls ═══ -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="SourceTitle" Text="🛟 檔案復原 (File Recovery)" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                    <TextBlock x:Name="AdminHintText" Text="{x:Bind ViewModel.AdminHint, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="VolumeCombo" Grid.Row="0" Grid.Column="0" Header="來源磁碟區"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedVolume, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />

                    <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetPathBox" Grid.Column="0"
                                 Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="例如 D:\ 或 D:\Photos 或 C:\dump\disk.img">
                            <TextBox.Header>
                                <TextBlock Text="或輸入路徑（磁碟機 / 資料夾 / .img 磁碟映像檔）" TextWrapping="Wrap" />
                            </TextBox.Header>
                        </TextBox>
                        <Button x:Name="BrowseTargetFolderBtn" Grid.Column="1" Content="📁 資料夾" VerticalAlignment="Bottom"
                                Click="BrowseTargetFolder_Click"
                                ToolTipService.ToolTip="瀏覽要掃描的來源資料夾"
                                AutomationProperties.Name="瀏覽來源資料夾" />
                        <Button x:Name="BrowseTargetImageBtn" Grid.Column="2" Content="💿 映像檔" VerticalAlignment="Bottom"
                                Click="BrowseTargetImage_Click"
                                ToolTipService.ToolTip="瀏覽 .img / .bin / .vhd / .vhdx / .iso 磁碟映像檔"
                                AutomationProperties.Name="瀏覽來源磁碟映像檔" />
                    </Grid>

                    <Button x:Name="ScanBtn" Grid.Row="0" Grid.Column="2" Content="🔍 開始掃描" VerticalAlignment="Bottom"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ScanCommand}" />

                    <Button x:Name="CancelBtn" Grid.Row="0" Grid.Column="3" Content="⏹️ 取消" VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <Button x:Name="RefreshVolumesBtn" Grid.Row="0" Grid.Column="4" Content="🔄 重新整理磁碟區" VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.RefreshVolumesCommand}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="SignatureCarveCheck" Content="深度簽章雕刻（慢，僅 NTFS 可用叢集）"
                                  IsChecked="{x:Bind ViewModel.EnableSignatureCarve, Mode=TwoWay}" />
                        <CheckBox x:Name="RecycleBinCheck" Content="包含資源回收筒殘留（免管理員）"
                                  IsChecked="{x:Bind ViewModel.IncludeRecycleBinFallback, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock x:Name="FilterLabel" Grid.Row="1" Grid.Column="3" Text="篩選："
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="FilterBox" Grid.Row="1" Grid.Column="4" Width="220"
                             Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="檔名 / 路徑關鍵字" />
                </Grid>

                <TextBlock x:Name="CapabilityText" Text="{x:Bind ViewModel.CapabilityText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ═══ Notification (scan errors, refusal-to-write warnings) ═══ -->
        <InfoBar x:Name="RecoveryInfoBar" Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                 IsClosable="True" Severity="Warning"
                 Title="請注意" Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}" />

        <!-- ═══ Results + destination / recover ═══ -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultsTitle" Grid.Column="0" Text="🕵️ 刪除項目候選清單"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="SelectRecoverableBtn" Grid.Column="1" Content="✅ 選取所有可復原"
                                Command="{x:Bind ViewModel.SelectRecoverableCommand}" />
                        <Button x:Name="SelectNoneBtn" Grid.Column="2" Content="⬜ 全部取消"
                                Command="{x:Bind ViewModel.SelectNoneCommand}" />
                        <Button x:Name="ClearResultsBtn" Grid.Column="3" Content="🗑️ 清除清單"
                                Command="{x:Bind ViewModel.ClearResultsCommand}" />
                    </Grid>

                    <ListView Grid.Row="1" x:Name="ResultsList"
                              ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid Padding="12,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="選取" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="復原信心" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="檔名 / 原始路徑 / 判定依據" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="時間" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="大小" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="5" Text="狀態" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecoveredFileItem">
                                <Grid Padding="12,8" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsRecoverable}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ConfidenceText}" FontSize="12" />
                                        <TextBlock Text="{x:Bind ConfidencePercent}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PathDisplay}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ConfidenceDetail}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TimeDisplay}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind MethodText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{x:Bind SizeDisplay}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind StatusText}" FontSize="12" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="DestinationTitle" Text="💾 復原至（必須是另一個磁碟區）"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                    </StackPanel>

                    <TextBlock x:Name="DestinationHint" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="安全規則：本工具以唯讀方式開啟來源，並拒絕把復原資料寫回來源磁碟區 — 新寫入的檔案會重新配置尚未使用的叢集，直接覆寫掉正要搶救的內容。" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationBox" Grid.Column="0" Header="目的資料夾"
                                 Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="例如 E:\Recovered" />
                        <Button x:Name="BrowseDestinationBtn" Grid.Column="1" Content="📁 選擇…" VerticalAlignment="Bottom"
                                Click="BrowseDestination_Click" />
                    </Grid>

                    <CheckBox x:Name="PreservePathsCheck" Content="保留原始資料夾結構"
                              IsChecked="{x:Bind ViewModel.PreserveOriginalPaths, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SelectAllBtn" Content="☑️ 選取全部" Command="{x:Bind ViewModel.SelectAllCommand}" />
                    </StackPanel>

                    <TextBlock x:Name="SelectionText" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                    <TextBlock x:Name="ProgressText" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="RecoverBtn" Content="🛟 復原選取的項目" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RecoverSelectedCommand}" />

                    <TextBlock x:Name="SummaryText" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap" />

                    <!-- NOTE: this element must NOT be named "StatusText": the result list's
                         DataTemplate below binds {x:Bind StatusText} on RecoveredFileItem, and a
                         page-level x:Name with the same identifier makes the WinUI XAML compiler
                         fail to resolve the name on the DataTemplate root (it then crashes while
                         reporting that, and the report itself fails because this WindowsAppSDK
                         build ships XamlCompiler.exe without its error strings). -->
                    <TextBlock x:Name="StatusLineText" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Execution log ═══ -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogTitle" Grid.Column="0" Text="📜 執行記錄"
                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="ClearLogBtn" Grid.Column="1" Content="清除記錄"
                            Command="{x:Bind ViewModel.ClearTerminalCommand}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="8">
                    <TextBlock Text="{x:Bind ViewModel.TerminalOutput, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
